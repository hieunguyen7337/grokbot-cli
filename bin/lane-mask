#!/bin/sh
set -eu

if [ "${LANE_MASK_HIDE+x}" = x ]; then
    while IFS= read -r path || [ -n "$path" ]; do
        [ -n "$path" ] || continue
        if [ -d "$path" ]; then
            if ! mount -t tmpfs -o size=1m,mode=0755 lanes-mask "$path"; then
                printf '%s\n' "$path" >&2
                exit 97
            fi
        elif [ -f "$path" ]; then
            if ! mount --bind /dev/null "$path"; then
                printf '%s\n' "$path" >&2
                exit 97
            fi
        fi
    done <<EOF
$LANE_MASK_HIDE
EOF
fi

if [ "$#" -gt 0 ] && [ "$1" = "--" ]; then
    shift
fi
if [ "$#" -eq 0 ]; then
    printf '%s\n' 'lane-mask: expected -- followed by a command' >&2
    exit 2
fi
if [ -n "${LANE_MASK_CHILD_FILE:-}" ]; then
    : > "$LANE_MASK_CHILD_FILE"
fi
unset LANE_MASK_HIDE LANE_MASK_CHILD_FILE
exec "$@"

def kill_group(process):
    """Stop only the process group (on Windows the process tree) this module started."""
    if os.name == "nt":
        subprocess.run(["taskkill", "/T", "/F", "/PID", str(process.pid)], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, check=False)
        return
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except OSError:
        pass


def git_bash():
    # `bash` on PATH may be WSL's, which cannot see Windows paths.
    for candidate in (r"C:\Program Files\Git\bin\bash.exe", r"C:\Program Files (x86)\Git\bin\bash.exe"):
        if os.path.exists(candidate):
            return candidate
    git = shutil.which("git")
    candidate = os.path.join(os.path.dirname(os.path.dirname(git)), "bin", "bash.exe") if git else None
    return candidate if candidate and os.path.exists(candidate) else None


def launch_argv(argv):
    """Windows cannot start a #! helper (the installed lane, usage-status): run its .cmd wrapper, Python or Git Bash."""
    if os.name != "nt" or not argv or os.path.splitext(argv[0])[1]:
        return argv
    path = argv[0]
    for suffix in (".cmd", ".bat", ".exe"):
        if os.path.isfile(path + suffix):
            return [path + suffix] + list(argv[1:])
    try:
        with open(path, "rb") as stream:
            first = stream.readline(200)
    except OSError:
        return argv
    if first.startswith(b"#!"):
        if b"python" in first:
            return [sys.executable, path] + list(argv[1:])
        bash = git_bash()
        if bash:
            return [bash, path] + list(argv[1:])
    return argv


def run_capture(argv, cwd=None, timeout=60, env=None):
    """Run a helper we started, in its own session, and return (exit code, stdout text)."""
    process = subprocess.Popen(launch_argv(argv), cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, start_new_session=True, env=env)
    try:
        output, _ = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        kill_group(process)
        process.communicate()
        raise
    return process.returncode, output.decode("utf-8", "replace")


# ---------------------------------------------------------------- grader (port of Suite R grade.py)

def repo_file(value):
    if not isinstance(value, str) or not value or "\\" in value:
        raise ValueError("file must be a nonempty repo-relative POSIX path")
    p = PurePosixPath(value)
    if p.is_absolute() or ".." in p.parts or str(p) != value:
        raise ValueError(f"noncanonical repo-relative path: {value!r}")
    return value


def integer(value, name):
    if type(value) is not int or value < 1:
        raise ValueError(f"{name} must be a positive integer")
    return value


def load_defects(path):
    ds = read_json(path)
    if not isinstance(ds, list):
        raise ValueError(f"{path}: expected a defect list")
    ids = set()
    for d in ds:
        if not isinstance(d, dict) or not isinstance(d.get("id"), str) or d["id"] in ids:
            raise ValueError(f"{path}: missing or duplicate defect id")
        ids.add(d["id"])
        if d.get("origin", "planted") not in ("planted", "unplanted"):
            raise ValueError(f"{path}: origin must be planted or unplanted")
        repo_file(d.get("file"))
        integer(d.get("line"), "line")
        integer(d.get("line_end"), "line_end")
        if d["line_end"] < d["line"]:
            raise ValueError(f"{path}: inverted defect interval")
    return ds


def load_findings(path, lenient=False):
    out = []
    try:
        # utf-8-sig: Windows PowerShell's Set-Content -Encoding UTF8 starts the file with a byte-order mark, and
        # 103 of terra's 116 findings files on 2026-10-28 scored as missing until the grader accepted it.
        text = Path(path).read_text(encoding="utf-8-sig")
    except FileNotFoundError:
        return out
    for number_, line in enumerate(text.splitlines(), 1):
        if not line.strip():
            continue
        try:
            f = json.loads(line)
            if not isinstance(f, dict):
                raise ValueError("expected object")
            repo_file(f.get("file"))
            integer(f.get("line"), "line")
            if f.get("severity") not in ("high", "medium", "low"):
                raise ValueError("severity must be high, medium or low")
            if not isinstance(f.get("description"), str) or not f["description"].strip():
                raise ValueError("description must be nonempty")
        except (ValueError, TypeError) as exc:
            if lenient:
                continue
            raise ValueError(f"{path}:{number_}: {exc}") from exc
        out.append(f)
    return out


def score(defects, findings, window=DEFAULT_WINDOW):
    """Maximum bipartite matching, so overlapping windows do not depend on greedy ordering.

    Each defect and finding is counted at most once. Duplicate reports that cannot
    match a separate defect are unmatched findings under the specified scoring rule.
    """
    adjacent = [[di for di, d in enumerate(defects)
                 if f["file"] == d["file"] and d["line"] - window <= f["line"] <= d["line_end"] + window]
                for f in findings]
    owner = {}

    def augment(fi, seen):
        for di in adjacent[fi]:
            if di in seen:
                continue
            seen.add(di)
            if di not in owner or augment(owner[di], seen):
                owner[di] = fi
                return True
        return False

    for fi in range(len(findings)):
        augment(fi, set())
    matched_indices = set(owner.values())
    pairs = [{"defect_id": defects[di]["id"], "finding_index": fi,
              "finding": findings[fi]} for di, fi in sorted(owner.items())]
    planted = [di for di, d in enumerate(defects) if d.get("origin", "planted") == "planted"]
    real = [di for di, d in enumerate(defects) if d.get("origin", "planted") == "unplanted"]
    result = {
        "defects_found": [defects[di]["id"] for di in planted if di in owner],
        "defects_missed": [defects[di]["id"] for di in planted if di not in owner],
        "matched_findings": pairs,
        "unmatched_findings": [{"finding_index": fi, "finding": f}
                               for fi, f in enumerate(findings) if fi not in matched_indices],
        "counts": {"defects_found": sum(di in owner for di in planted), "defects_missed": sum(di not in owner for di in planted),
                   "matched_findings": len(owner), "unmatched_findings": len(findings) - len(owner)},
    }
    if real:
        result["real_found"] = [defects[di]["id"] for di in real if di in owner]
        result["counts"]["real_found"] = len(result["real_found"])
    return result


def aggregate(items, results_dir, arm_names=None, window=DEFAULT_WINDOW):
    """Score every arm directory under results_dir against items = {item: defects}."""
    results_dir = Path(results_dir)
    if not items:
        raise ValueError("no items")
    if not results_dir.is_dir():
        raise ValueError(f"results directory does not exist: {results_dir}")
    if arm_names:
        names = sorted(set(arm_names))
        if any(Path(n).name != n or n in (".", "..") for n in names):
            raise ValueError("arm must be a directory basename")
    else:
        names = sorted(p.name for p in results_dir.iterdir() if p.is_dir())
    if not names:
        raise ValueError(f"no arm item directories under {results_dir}")
    total = sum(map(len, items.values()))
    matrix = {f"{item}:{d['id']}": {arm: False for arm in names}
              for item, ds in items.items() for d in ds}
    arms, hits = {}, {}
    for arm in names:
        details, absent, failed, format_fail = {}, [], [], []
        alarms = {kind: {"unmatched_findings": 0, "items": 0,
                         "completed_items": 0, "completed_unmatched_findings": 0}
                  for kind in ("planted", "control")}
        hits[arm] = set()
        for item, ds in items.items():
            run = results_dir / arm / item
            path = run / "findings.jsonl"
            exit_file = run / "lane.exit"
            lane_exit = exit_file.read_text().strip() if exit_file.exists() else None
            failed_run = lane_exit is not None and lane_exit != "0"
            if failed_run:
                failed.append(item)
            present = path.is_file()
            if not present:
                absent.append(item)
            malformed = False
            try:
                valid_findings = load_findings(path)
            except (OSError, ValueError):
                malformed = True
                format_fail.append(item)
                valid_findings = []
            lenient_findings = load_findings(path, lenient=True) if malformed else valid_findings
            result = score(ds, valid_findings, window)
            result["lenient"] = score(ds, lenient_findings, window)
            completed = present and not malformed and (lane_exit == "0" or (lane_exit == "3" and arm.split("-", 1)[0] in CLAUDE_LANES))
            result["status"] = "complete" if completed else ("format_fail" if malformed else ("failed" if failed_run else ("incomplete" if present else "missing")))
            result["lane_exit"] = lane_exit
            result["findings_present"] = present
            details[item] = result
            group = alarms["planted" if ds else "control"]
            group["items"] += 1
            group["unmatched_findings"] += result["counts"]["unmatched_findings"]
            if completed:
                group["completed_items"] += 1
                group["completed_unmatched_findings"] += result["counts"]["unmatched_findings"]
            for defect in result["defects_found"]:
                key = f"{item}:{defect}"
                matrix[key][arm] = True
                hits[arm].add(key)
        for group in alarms.values():
            group["unmatched_findings_per_item"] = (
                group["unmatched_findings"] / group["items"] if group["items"] else None)
            group["completed_only_unmatched_findings_per_item"] = (
                group["completed_unmatched_findings"] / group["completed_items"]
                if group["completed_items"] else None)
        arms[arm] = {"defects_found": len(hits[arm]), "defects_missed": total - len(hits[arm]),
                     "recall": len(hits[arm]) / total if total else None,
                     "completed_items": sum(r["status"] == "complete" for r in details.values()),
                     "failed_runs": len(failed), "format_fail": len(format_fail), "format_fail_items": format_fail,
                     "lenient_defects_found": sum(r["lenient"]["counts"]["defects_found"] for r in details.values()),
                     "lenient_recall": sum(r["lenient"]["counts"]["defects_found"] for r in details.values()) / total if total else None,
                     "lenient_false_alarms": sum(r["lenient"]["counts"]["unmatched_findings"] for r in details.values()),
                     "missing_items": absent, "failed_items": failed,
                     "false_alarms": alarms, "items": details}
    unions = []
    for size in (2, 3):
        for combination in itertools.combinations(names, size):
            found = set().union(*(hits[a] for a in combination))
            unions.append({"arms": list(combination), "defects_found": len(found),
                           "defects_missed": total - len(found),
                           "recall": len(found) / total if total else None})
    return {"schema_version": 1, "items": len(items), "total_defects": total,
            "planted_items": sum(bool(ds) for ds in items.values()),
            "control_items": sum(not ds for ds in items.values()),
            "matching": f"same file, line in [defect.line-{window}, defect.line_end+{window}]; maximum one-to-one matching",
            "coverage_policy": "Recall and suite-wide false-alarm denominators include every item; missing findings are empty. "
                               "Existing findings are scored regardless of lane exit. Completed-only false-alarm rates "
                               "exclude missing findings and nonzero lane exits; absent exit files are allowed.",
            "arms": arms, "per_defect_hit_matrix": matrix, "union_recall": unions}


def markdown(summary):
    def fmt(v):
        return "n/a" if v is None else f"{v:.4f}"
    lines = ["# Suite R scores", "", summary["coverage_policy"], "",
             f"Reference: {summary['items']} items; {summary['total_defects']} defects.", "",
             "| Arm | Completed | Failed runs | Found | Recall | Suite-wide unmatched/item, planted | Suite-wide unmatched/item, control | Completed-only unmatched/item, planted (n) | Completed-only unmatched/item, control (n) |",
             "|---|---:|---:|---:|---:|---:|---:|---:|---:|"]
    for arm, row in summary["arms"].items():
        alarms = row["false_alarms"]
        lines.append(f"| {arm} | {row['completed_items']}/{summary['items']} | {row['failed_runs']} | {row['defects_found']} | "
                     f"{fmt(row['recall'])} | {fmt(alarms['planted']['unmatched_findings_per_item'])} | "
                     f"{fmt(alarms['control']['unmatched_findings_per_item'])} | "
                     f"{fmt(alarms['planted']['completed_only_unmatched_findings_per_item'])} ({alarms['planted']['completed_items']}) | "
                     f"{fmt(alarms['control']['completed_only_unmatched_findings_per_item'])} ({alarms['control']['completed_items']}) |")
    lines += ["", "| Arms (union) | Found | Recall |", "|---|---:|---:|"]
    for row in summary["union_recall"]:
        lines.append(f"| {', '.join(row['arms'])} | {row['defects_found']} | {fmt(row['recall'])} |")
    names = list(summary["arms"])
    lines += ["", "| Defect | " + " | ".join(names) + " |",
              "|---|" + "---:|" * len(names)]
    for defect, row in summary["per_defect_hit_matrix"].items():
        lines.append("| " + defect + " | " + " | ".join("1" if row[n] else "0" for n in names) + " |")
    lines += ["", "Per-item matched/unmatched findings are in summary.json.", ""]
    return "\n".join(lines)


def write_summary(summary, output_dir):
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    for name, content in (("summary.json", json.dumps(summary, indent=2) + "\n"),
                          ("summary.md", markdown(summary))):
        destination = output_dir / name
        temporary = destination.with_suffix(destination.suffix + ".new")
        temporary.write_text(content, encoding="utf-8", newline="\n")
        temporary.replace(destination)


def selftest():
    """grade.py's selftest expectations on synthetic items, so no Suite R item content is needed."""
    def check(condition, label):
        if not condition:
            raise BenchError(f"selftest failed: {label}")

    def defect(identifier, file, line, line_end):
        return {"id": identifier, "file": file, "line": line, "line_end": line_end,
                "type": "synthetic", "description": "synthetic"}

    def finding(line, file="src/x.py"):
        return {"file": file, "line": line, "severity": "medium", "description": "synthetic"}

    def rows_text(rows):
        return "".join(json.dumps(row) + "\n" for row in rows)

    with tempfile.TemporaryDirectory(prefix="lane-bench-selftest-") as tmp:
        base = Path(tmp)
        # Synthetic items: 001 two planted, 002 one planted, 003 two planted, 031 control (5 defects).
        layout = {
            "001": [defect("D1", "src/a.py", 20, 22), defect("D2", "src/a.py", 40, 40)],
            "002": [defect("D1", "src/b.py", 10, 10)],
            "003": [defect("D1", "src/c.py", 100, 100), defect("D2", "src/c.py", 200, 200)],
            "031": [],
        }
        for item, ds in layout.items():
            target = base / "items" / item
            target.mkdir(parents=True)
            (target / "defects.json").write_text(json.dumps(ds), encoding="utf-8")
        # Per-item expectations: (defects_found, defects_missed, matched, unmatched).
        fixtures = {
            "001": [finding(21, "src/a.py"), finding(40, "src/a.py")],
            "002": [],
            "003": [finding(100, "src/c.py"), finding(300, "src/c.py"), finding(100, "src/other.py")],
        }
        expected = {"001": (2, 0, 2, 0), "002": (0, 1, 0, 0), "003": (1, 1, 1, 2)}
        for item, counts in expected.items():
            actual = score(load_defects(base / "items" / item / "defects.json"), fixtures[item])
            got = tuple(actual["counts"][key] for key in
                        ("defects_found", "defects_missed", "matched_findings", "unmatched_findings"))
            check(got == counts, (item, got, counts))
            print(f"SELFTEST item {item}: found={got[0]} missed={got[1]} matched={got[2]} unmatched={got[3]}")
        # Inclusive tolerance endpoints, wrong file, duplicate reports, overlapping windows.
        ds = [defect("D1", "src/x.py", 20, 22), defect("D2", "src/x.py", 28, 28)]
        check(score(ds[:1], [finding(15)])["counts"]["defects_found"] == 1, "lower endpoint")
        check(score(ds[:1], [finding(27)])["counts"]["defects_found"] == 1, "upper endpoint")
        check(score(ds[:1], [finding(14), finding(28), finding(20, "src/y.py")])["counts"]["defects_found"] == 0,
              "outside window or wrong file")
        check(score(ds, [finding(24), finding(16)])["counts"]["defects_found"] == 2, "overlapping windows")
        check(score(ds[:1], [finding(20), finding(20)])["counts"]["unmatched_findings"] == 1, "duplicate report")
        check(score([], [finding(20)])["counts"]["unmatched_findings"] == 1, "control item")
        # Aggregate over seven arms, controls, all 21 pairs and 35 triples, partial coverage, failed review.
        names = ["luna", "sol", "astra", "gemini", "haiku", "sonnet", "opus"]
        for arm in names:
            for item in ("001", "002", "003", "031"):
                target = base / "runs" / arm / item
                target.mkdir(parents=True)
                (target / "findings.jsonl").write_text("", encoding="utf-8")
        for item in expected:
            (base / "runs" / "luna" / item / "findings.jsonl").write_text(rows_text(fixtures[item]), encoding="utf-8")
        for item in ("002", "003"):
            (base / "runs" / "sol" / item / "findings.jsonl").write_text(
                rows_text([finding(d["line"], d["file"]) for d in layout[item]]), encoding="utf-8")
        (base / "runs" / "luna" / "031" / "findings.jsonl").write_text(rows_text([finding(20)]), encoding="utf-8")
        items = {item: load_defects(base / "items" / item / "defects.json") for item in sorted(layout)}
        result = aggregate(items, base / "runs")
        check(result["total_defects"] == 5, "total defects")
        check(result["arms"]["luna"]["recall"] == 3 / 5, "luna recall")
        check(result["arms"]["sol"]["recall"] == 3 / 5, "sol recall")
        check(result["arms"]["luna"]["false_alarms"]["planted"]["unmatched_findings_per_item"] == 2 / 3,
              "planted unmatched per item")
        check(result["arms"]["luna"]["false_alarms"]["control"]["unmatched_findings_per_item"] == 1,
              "control unmatched per item")
        check(len(result["union_recall"]) == 56, "21 pairs plus 35 triples")
        check(next(r for r in result["union_recall"] if r["arms"] == ["luna", "sol"])["recall"] == 1, "luna+sol union")
        check(next(r for r in result["union_recall"] if r["arms"] == ["astra", "luna", "sol"])["recall"] == 1,
              "astra+luna+sol union")
        check(result["per_defect_hit_matrix"]["002:D1"]["sol"] is True, "hit matrix")
        write_summary(result, base / "selftest-output")
        (base / "runs" / "luna" / "001" / "findings.jsonl").unlink()
        (base / "runs" / "sol" / "003" / "lane.exit").write_text("1\n")
        partial = aggregate(items, base / "runs")
        check(partial["arms"]["luna"]["missing_items"] == ["001"], "missing item")
        check(partial["arms"]["sol"]["failed_items"] == ["003"], "failed item")
        check(partial["arms"]["sol"]["recall"] == 3 / 5, "failed run with findings still scores")
        check(partial["arms"]["sol"]["failed_runs"] == 1, "failed run count")
        check(partial["arms"]["sol"]["items"]["003"]["lane_exit"] == "1", "lane exit diagnostic")
        invalid = base / "invalid.jsonl"
        for value in ("not json", json.dumps(finding(True)), json.dumps(finding(20, "../x.py"))):
            invalid.write_text(value)
            try:
                load_findings(invalid)
            except ValueError:
                pass
            else:
                raise BenchError("selftest failed: invalid finding accepted")
    print("SELFTEST matching: boundaries, overlap, duplicates, controls, malformed input OK")
    print("SELFTEST aggregate: 7 arms, 21 pairs, 35 triples, hit matrix, missing/failed coverage OK")
    print("SELFTEST-OK")
    return 0


# ---------------------------------------------------------------- suite

class Suite:
    def __init__(self, root, name, cls, window, brief):
        self.root = root
        self.name = name
        self.cls = cls
        self.window = window
        self.brief = brief
        self.items_root = os.path.join(root, "items")
        self.runs_root = os.path.join(root, "runs")
        self.results_root = os.path.join(root, "results")
        self.failed_root = os.path.join(root, "failed_runs")

    def item_ids(self):
        if not os.path.isdir(self.items_root):
            return []
        return [name for name in sorted(os.listdir(self.items_root))
                if ITEM_RE.match(name) and os.path.isfile(os.path.join(self.items_root, name, "defects.json"))]

    def item_path(self, item, *parts):
        return os.path.join(self.items_root, item, *parts)

    def load_items(self):
        ids = self.item_ids()
        if not ids:
            raise BenchError(f"no items under {self.items_root}")
        return {item: load_defects(self.item_path(item, "defects.json")) for item in ids}


def load_suite(root, need_brief=False):
    root = os.path.abspath(os.path.expanduser(root))
    if not os.path.isdir(root):
        raise BenchError(f"suite directory does not exist: {root}")
    name = os.path.basename(root.rstrip(os.sep))
    cls, window = DEFAULT_CLASS, DEFAULT_WINDOW
    config_path = os.path.join(root, "suite.json")
    if os.path.exists(config_path):
        config = read_optional_json(config_path)
        if not isinstance(config, dict):
            raise BenchError(f"{config_path}: expected a JSON object")
        name = config.get("name", name)
        cls = config.get("class", cls)
        window = config.get("window", window)
        if not isinstance(name, str) or not NAME_RE.match(name):
            raise BenchError(f"{config_path}: name must be a plain tag such as suite-r")
        if cls not in CLASSES:
            raise BenchError(f"{config_path}: class must be one of {', '.join(CLASSES)}")
        if type(window) is not int or window < 1:
            raise BenchError(f"{config_path}: window must be a positive integer")
    brief = ""
    brief_path = os.path.join(root, "review_brief.md")
    if need_brief:
        if not os.path.isfile(brief_path):
            raise BenchError(f"missing review_brief.md in {root}")
        with open(brief_path, "r", encoding="utf-8") as stream:
            brief = stream.read()
        if "{{ITEM_PATH}}" not in brief:
            raise BenchError("review_brief.md must contain {{ITEM_PATH}}")
    return Suite(root, name, cls, window, brief)


# ---------------------------------------------------------------- arms

def arm_name(arm, rep=1):
    name = "{}-{}".format(arm["lane"], arm["effort"])
    if arm.get("model"):
        name += "-" + arm["model"].replace("/", "__")
    if rep > 1:
        name += "-r{}".format(rep)
    return name


def parse_arm_spec(spec):
    parts = spec.strip().split(":")
    if len(parts) not in (2, 3):
        raise BenchError(f"arm must be LANE:EFFORT[:MODEL], got {spec!r}")
    lane, effort = parts[0], parts[1]
    model = parts[2] if len(parts) == 3 else None
    if not NAME_RE.match(lane):
        raise BenchError(f"invalid lane in {spec!r}")
    if effort not in EFFORTS:
        raise BenchError(f"effort must be one of {', '.join(EFFORTS)}, got {effort!r} in {spec!r}")
    if model is not None and not MODEL_RE.match(model):
        raise BenchError(f"invalid model in {spec!r}")
    return {"lane": lane, "effort": effort, "model": model}


def read_arm_specs(arm_args, arms_file):
    specs = list(arm_args or [])
    if arms_file:
        try:
            with open(arms_file, "r", encoding="utf-8") as stream:
                for line in stream:
                    text = line.split("#", 1)[0].strip()
                    if text:
                        specs.append(text)
        except OSError as exc:
            raise BenchError(f"cannot read {arms_file}: {exc}") from exc
    arms, seen = [], set()
    for spec in specs:
        arm = parse_arm_spec(spec)
        if arm_name(arm) in seen:
            raise BenchError(f"duplicate arm {spec!r}")
        seen.add(arm_name(arm))
        arms.append(arm)
    return arms


def parse_arm_name(name):
    """Invert arm_name: <lane>-<effort>[-<model with __ for />][-r<rep>]."""
    parts = name.split("-")
    lane = parts[0]
    effort = parts[1] if len(parts) > 1 else None
    rest = parts[2:]
    rep = 1
    if rest and REP_PART_RE.match(rest[-1]):
        rep = int(rest[-1][1:])
        rest = rest[:-1]
    encoded = "-".join(rest) or None
    return {"lane": lane, "effort": effort, "model": encoded.replace("__", "/") if encoded else None, "rep": rep}


# ---------------------------------------------------------------- launch gates

def reserve_for(lane):
    return 150 if lane in CODEX_LANES else 40


def _read_text(path):
    with open(path, "r", encoding="utf-8") as stream:
        return stream.read().strip()


def _pids_headroom(directory):
    try:
        limit = _read_text(os.path.join(directory, "pids.max"))
        if limit == "max":
            return None
        return int(limit) - int(_read_text(os.path.join(directory, "pids.current")))
    except (OSError, ValueError):
        return None


def task_headroom(proc_cgroup=None, cgroup_root=None):
    """Smallest pids.max - pids.current over this cgroup and its ancestors with a finite limit; None if unlimited."""
    proc_cgroup = proc_cgroup or os.environ.get("LANES_PROC_CGROUP", "/proc/self/cgroup")
    root = os.path.normpath(cgroup_root or os.environ.get("LANES_CGROUP_ROOT", "/sys/fs/cgroup"))
    try:
        with open(proc_cgroup, "r", encoding="utf-8") as stream:
            lines = stream.read().splitlines()
    except OSError:
        return None
    relative = next((line[3:] for line in lines if line.startswith("0::")), None)
    if relative is None:
        return None
    current = os.path.normpath(os.path.join(root, relative.lstrip("/")))
    headroom = None
    while True:
        level = _pids_headroom(current)
        if level is not None:
            headroom = level if headroom is None else min(headroom, level)
        if current == root or not current.startswith(root + os.sep):
            break
        current = os.path.dirname(current)
    return headroom


class Launcher:
    """One launch at a time: spacing first, then task headroom, then the spawn itself."""

    def __init__(self):
        self.lock = threading.Lock()
        self.last = None

    def launch(self, lane, start):
        with self.lock:
            if self.last is not None:
                wait = self.last + LAUNCH_GAP_S - CLOCK()
                if wait > 0:
                    SLEEP(wait)
            while True:
                room = task_headroom()
                if room is None or room >= reserve_for(lane):
                    break
                log(f"task headroom {room} below reserve {reserve_for(lane)} for {lane}; waiting")
                SLEEP(HEADROOM_POLL_S)
            process = start()
            self.last = CLOCK()
            return process


class Meters:
    """Claude and Codex readings, shared between workers. Claude fresh reads are cached for 120 s under one lock."""

    def __init__(self, status_bin, claude_bin):
        self.status_bin = status_bin
        self.claude_bin = claude_bin
        self.lock = threading.Lock()
        self.codex_refresh_lock = threading.Lock()
        self.codex_last_refresh = None
        self.cache = None

    def usage_status(self):
        try:
            code, output = run_capture([self.status_bin, "--no-agy", "--json"], timeout=60)
        except (OSError, subprocess.SubprocessError):
            return None
        if code != 0:
            return None
        try:
            data = json.loads(output)
        except ValueError:
            return None
        return data if isinstance(data, dict) else None

    def codex_weekly_reading(self):
        status = self.usage_status() or {}
        used = number((((status.get("codex") or {}).get("seven_day")) or {}).get("used_percent"))
        return used

    def codex_weekly_used(self):
        """Codex weekly percentage, failing open when no reading is available."""
        used = self.codex_weekly_reading()
        return used if used is not None else 0.0

    def refresh_codex(self):
        """Share Codex refreshes between workers, with at most one per step interval."""
        with self.codex_refresh_lock:
            now = CLOCK()
            if self.codex_last_refresh is not None and now - self.codex_last_refresh < CODEX_STEP_S:
                return
            env = os.environ.copy()
            env["USAGE_OPTIMIZER_CODEX_TIMEOUT"] = "40"
            try:
                run_capture([self.status_bin, "--codex-refresh"], timeout=60, env=env)
            except (OSError, subprocess.SubprocessError):
                pass
            self.codex_last_refresh = CLOCK()

    def claude_reading(self):
        """(5h percent, 7d percent) or None when no reading can be had."""
        with self.lock:
            now = CLOCK()
            if self.cache is not None and now - self.cache[0] < CLAUDE_READING_TTL_S:
                return self.cache[1]
            value = self._claude_uncached()
            if value is not None:
                self.cache = (now, value)
            return value

    def _claude_uncached(self):
        status = self.usage_status() or {}
        claude = status.get("claude") or {}
        age = number(claude.get("age_seconds"))
        windows = ((claude.get("reading") or {}).get("five_hour"), (claude.get("reading") or {}).get("seven_day"))
        if age is not None and age <= CLAUDE_FRESH_MAX_AGE_S:
            five = number(windows[0].get("used_percentage")) if isinstance(windows[0], dict) else None
            seven = number(windows[1].get("used_percentage")) if isinstance(windows[1], dict) else None
            if five is not None and seven is not None:
                return five, seven
        return self._fresh_claude_reading()

    def _fresh_claude_reading(self):
        argv = [self.claude_bin, "-p", "--model", "claude-haiku-5-5", "--setting-sources", "project,local",
                "--strict-mcp-config", "--output-format", "stream-json", "--verbose", "--max-turns", "1",
                "Reply with the single word OK."]
        with tempfile.TemporaryDirectory(prefix="lane-bench-meter-") as empty:
            try:
                _, output = run_capture(argv, cwd=empty, timeout=120)
            except (OSError, subprocess.SubprocessError):
                return None
        last = None
        for line in output.splitlines():
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if isinstance(event, dict) and event.get("type") == "rate_limit_event":
                last = event
        windows = (((last or {}).get("rate_limit_info") or {}).get("unifiedWindows")) or {}
        five = number((windows.get("five_hour") or {}).get("utilization"))
        seven = number((windows.get("seven_day") or {}).get("utilization"))
        if five is None or seven is None:
            return None
        return five * 100, seven * 100


def wait_for_claude(meters, five_ceiling, seven_ceiling):
    while True:
        reading = meters.claude_reading()
        if reading is not None and reading[0] < five_ceiling and reading[1] < seven_ceiling:
            return
        shown = "unknown" if reading is None else "5h {:.0f}% 7d {:.0f}%".format(*reading)
        log(f"claude gate: {shown}; waiting for the ceilings {five_ceiling}% / {seven_ceiling}%")
        SLEEP(CLAUDE_STEP_S)


def codex_gate(meters, ceiling, at_limit="skip", wait_max_h=0):
    """Return a skip reason when the Codex weekly gate blocks this item."""
    reading = meters.codex_weekly_reading()
    if at_limit == "skip":
        if reading is None or reading < ceiling:
            return None
        meters.refresh_codex()
        reading = meters.codex_weekly_reading()
        if reading is None or reading < ceiling:
            return None
        return f"codex weekly window at or over {ceiling}% after refresh"

    wait_started = None
    while reading is None or reading >= ceiling:
        if wait_started is not None and wait_max_h > 0 and CLOCK() - wait_started >= wait_max_h * 3600:
            return f"codex wait exceeded --codex-wait-max-h ({wait_max_h:g} hours)"
        meters.refresh_codex()
        reading = meters.codex_weekly_reading()
        if reading is not None and reading < ceiling:
            return None
        if wait_started is None:
            wait_started = CLOCK()
        shown = "unknown" if reading is None else "{:.0f}%".format(reading)
        log(f"codex gate: weekly {shown}; waiting for the weekly reset or a redeemed reset credit")
        SLEEP(CODEX_STEP_S)
    return None


# ---------------------------------------------------------------- run

class Job:
    def __init__(self, arm, name, item, workspace):
        self.arm = arm
        self.name = name
        self.item = item
        self.workspace = workspace


def plan_jobs(suite, arms, rep, items, resume):
    """Build every (arm, item) job. Checks all existing workspaces before anything moves."""
    jobs, existing = [], []
    for arm in arms:
        name = arm_name(arm, rep)
        for item in items:
            workspace = os.path.join(suite.runs_root, name, item)
            if os.path.lexists(workspace):
                existing.append(workspace)
            jobs.append(Job(arm, name, item, workspace))
    if existing and not resume:
        raise BenchError(f"existing workspace {existing[0]}; pass --resume to keep finished runs")
    pending, kept = [], 0
    for job in jobs:
        if not os.path.lexists(job.workspace):
            pending.append(job)
            continue
        if resume and _finished_ok(job.workspace):
            kept += 1
            continue
        _move_aside(suite, job)
        pending.append(job)
    return pending, kept


def _finished_ok(workspace):
    exit_file = os.path.join(workspace, "lane.exit")
    if not os.path.isfile(exit_file):
        return False
    with open(exit_file, "r", encoding="utf-8") as stream:
        return stream.read().strip() == "0" and os.path.isfile(os.path.join(workspace, "findings.jsonl"))


def _move_aside(suite, job):
    os.makedirs(suite.failed_root, exist_ok=True)
    stamp = utc_stamp()
    destination = os.path.join(suite.failed_root, f"{job.name}-{job.item}-{stamp}")
    counter = 2
    while os.path.lexists(destination):
        destination = os.path.join(suite.failed_root, f"{job.name}-{job.item}-{stamp}-{counter}")
        counter += 1
    shutil.move(job.workspace, destination)
    log(f"moved failed workspace aside: {destination}")


def stage_workspace(suite, item, workspace):
    os.makedirs(os.path.dirname(workspace), exist_ok=True)
    os.mkdir(workspace)
    shutil.copyfile(suite.item_path(item, "diff.patch"), os.path.join(workspace, "diff.patch"))
    # py_compile output is context-free and must not enter a review.
    shutil.copytree(suite.item_path(item, "post"), os.path.join(workspace, "post"),
                    ignore=shutil.ignore_patterns("__pycache__"))
    brief = suite.brief.replace("{{ITEM_PATH}}", workspace).rstrip("\n") + "\n"
    with open(os.path.join(workspace, "review_brief.md"), "w", encoding="utf-8") as stream:
        stream.write(brief)


def _write_skip(workspace, approved=None, codex_7d=None, codex_at_limit="skip", codex_wait_max_h=0,
                skip_reason=None):
    stamp = utc_iso()
    with open(os.path.join(workspace, "lane.exit"), "w", encoding="utf-8") as stream:
        stream.write("{}\n".format(CODEX_SKIP_EXIT))
    write_json(os.path.join(workspace, "run.json"), {
        "lane_run_dir": None, "started_at": stamp, "ended_at": stamp,
        "exit": CODEX_SKIP_EXIT, "skipped": "codex weekly", "skip_reason": skip_reason,
        "approved": approved, "codex_7d": codex_7d, "codex_at_limit": codex_at_limit,
        "codex_wait_max_h": codex_wait_max_h})


def _wait(process, limit):
    try:
        return process.wait(timeout=limit)
    except subprocess.TimeoutExpired:
        kill_group(process)
        process.wait()
        return TIMEOUT_EXIT


def execute(ctx, job):
    """Run one (arm, item). Returns (ok, message)."""
    suite, lane = ctx["suite"], job.arm["lane"]
    workspace = job.workspace
    os.makedirs(os.path.dirname(workspace), exist_ok=True)
    if lane in CODEX_LANES:
        at_limit = ctx.get("codex_at_limit", "skip")
        wait_max_h = ctx.get("codex_wait_max_h", 0)
        log(f"{job.name} {job.item}: codex gate mode {at_limit}; weekly ceiling {ctx['codex_7d']}%")
        skip_reason = codex_gate(ctx["meters"], ctx["codex_7d"], at_limit, wait_max_h)
        if skip_reason is not None:
            os.mkdir(workspace)
            _write_skip(workspace, ctx.get("approved"), ctx["codex_7d"], at_limit, wait_max_h, skip_reason)
            return False, f"{job.name} {job.item} skipped: {skip_reason}"
    if lane in CLAUDE_LANES:
        wait_for_claude(ctx["meters"], ctx["claude_5h"], ctx["claude_7d"])
    stage_workspace(suite, job.item, workspace)
    stamp = utc_stamp()
    outdir = os.path.join(ctx["ledger"], "{}-{}-{}-{}-{}".format(stamp, os.getpid(), lane, suite.name, job.item))
    argv = [ctx["lane_bin"], lane, "-C", workspace, "-b", os.path.join(workspace, "review_brief.md"),
            "-e", job.arm["effort"]]
    if job.arm.get("model"):
        argv += ["-m", job.arm["model"]]
    argv += ["--class", suite.cls, "--tag", suite.name, "--off-catalog",
             "--timeout", str(ctx["timeout"]), "-o", outdir]
    started = utc_iso()
    with open(os.path.join(workspace, "lane.log"), "wb") as log_stream:
        def start():
            return subprocess.Popen(launch_argv(argv), stdin=subprocess.DEVNULL, stdout=log_stream,
                                    stderr=subprocess.STDOUT, start_new_session=True)
        try:
            process = ctx["launcher"].launch(lane, start)
        except OSError as exc:
            log_stream.write(str(exc).encode("utf-8") + b"\n")
            code = MISSING_BINARY_EXIT
        else:
            code = _wait(process, ctx["timeout"] + TIMEOUT_GRACE_S)
    ended = utc_iso()
    with open(os.path.join(workspace, "lane.exit"), "w", encoding="utf-8") as stream:
        stream.write("{}\n".format(code))
    write_json(os.path.join(workspace, "run.json"), {
        "lane_run_dir": outdir, "started_at": started, "ended_at": ended, "exit": code,
        "approved": ctx.get("approved")})
    if code != 0 or not os.path.isfile(os.path.join(workspace, "findings.jsonl")):
        return False, f"{job.name} {job.item} failed (exit {code})"
    return True, f"{job.name} {job.item} ok"


APPROVAL_REFUSAL = ("lane-bench run is a capability test: it spends window on items nobody needs. "
                    "Run it only after the user approves it, and pass --approved \"<who, when>\".")


def cmd_run(args):
    # Checked first: a refused run must not load the suite, wait on a gate or create a run directory.
    approved = (args.approved or "").strip()
    if not approved:
        print(APPROVAL_REFUSAL, file=sys.stderr)
        return 2
    suite = load_suite(args.suite, need_brief=True)
    arms = read_arm_specs(args.arm, args.arms_file)
    if not arms:
        raise BenchError("no arms: pass --arm LANE:EFFORT[:MODEL] or --arms-file")
    if args.rep < 1:
        raise BenchError("--rep must be at least 1")
    if args.par < 1 or args.slots < 1:
        raise BenchError("--par and --slots must be at least 1")
    if not math.isfinite(args.codex_wait_max_h) or args.codex_wait_max_h < 0:
        raise BenchError("--codex-wait-max-h must be a finite non-negative number")
    all_items = suite.item_ids()
    if args.items:
        if not ITEMS_ARG_RE.match(args.items):
            raise BenchError("--items must be NNN,NNN,...")
        items = args.items.split(",")
        if len(set(items)) != len(items):
            raise BenchError("duplicate item in --items")
        for item in items:
            if item not in all_items:
                raise BenchError(f"unknown item {item}")
    else:
        items = all_items
    for item in items:
        if not (os.path.isfile(suite.item_path(item, "diff.patch")) and os.path.isdir(suite.item_path(item, "post"))):
            raise BenchError(f"item {item} lacks diff.patch or post/")
        load_defects(suite.item_path(item, "defects.json"))
    pending, kept = plan_jobs(suite, arms, args.rep, items, args.resume)
    ledger = ledger_default()
    os.makedirs(ledger, exist_ok=True)
    ctx = {"suite": suite, "meters": Meters(usage_status_binary(), claude_binary()), "launcher": Launcher(),
           "ledger": ledger, "lane_bin": lane_binary(), "timeout": args.timeout,
           "approved": approved, "claude_5h": args.claude_5h, "claude_7d": args.claude_7d,
           "codex_7d": args.codex_7d, "codex_at_limit": args.codex_at_limit,
           "codex_wait_max_h": args.codex_wait_max_h}
    os.makedirs(suite.runs_root, exist_ok=True)
    results = {"ok": 0, "failed": 0, "kept": kept}
    log(f"{len(pending)} runs queued, {kept} kept from earlier; at most {args.slots * args.par} lanes at once")
    with ThreadPoolExecutor(max_workers=args.slots * args.par) as pool:
        futures = {}
        for job in pending:
            os.makedirs(os.path.dirname(job.workspace), exist_ok=True)
            futures[pool.submit(execute, ctx, job)] = job
        for future in as_completed(futures):
            job = futures[future]
            try:
                ok, message = future.result()
            except Exception as exc:  # keep the other lanes running; report this one
                ok, message = False, f"{job.name} {job.item} crashed: {exc}"
            results["ok" if ok else "failed"] += 1
            log(message)
    log("done: {} ok, {} failed or skipped, {} kept".format(results["ok"], results["failed"], results["kept"]))
    if not args.no_grade:
        names = sorted(p for p in os.listdir(suite.runs_root) if os.path.isdir(os.path.join(suite.runs_root, p)))
        summary = aggregate(suite.load_items(), suite.runs_root, names, suite.window)
        write_summary(summary, suite.results_root)
        log(f"graded {len(summary['arms'])} arms into {suite.results_root}")
    return 0 if results["failed"] == 0 else 1


# ---------------------------------------------------------------- grade

def cmd_grade(args):
    if args.selftest:
        return selftest()
    if not args.suite:
        raise BenchError("grade needs --suite DIR (or --selftest)")
    suite = load_suite(args.suite)
    output = args.results_dir or suite.results_root
    summary = aggregate(suite.load_items(), suite.runs_root, args.arm, suite.window)
    write_summary(summary, output)
    print(f"GRADED {len(summary['arms'])} arms, {summary['items']} items, {summary['total_defects']} defects")
    print(f"WROTE {os.path.join(output, 'summary.json')}")
    print(f"WROTE {os.path.join(output, 'summary.md')}")
    return 0


# ---------------------------------------------------------------- pricing and rollouts

def load_pricing(arms_json):
    """providers.*.window and rate_card from the arms catalog, with the defaults where a key is absent."""
    data = {}
    if arms_json and os.path.exists(arms_json):
        loaded = read_optional_json(arms_json)
        if not isinstance(loaded, dict):
            raise BenchError(f"cannot read arms catalog {arms_json}")
        data = loaded
    providers = data.get("providers") if isinstance(data.get("providers"), dict) else {}
    windows = {}
    for provider, defaults in DEFAULT_WINDOWS.items():
        window = json.loads(json.dumps(defaults))
        given = (providers.get(provider) or {}).get("window") if isinstance(providers.get(provider), dict) else None
        if isinstance(given, dict):
            window.update(given)
        windows[provider] = window
    card = json.loads(json.dumps(DEFAULT_RATE_CARD))
    if isinstance(data.get("rate_card"), dict):
        card.update(data["rate_card"])
    lanes = {lane: settings.get("model") for lane, settings in (data.get("lanes") or {}).items()
             if isinstance(settings, dict)}
    return {"windows": windows, "rate_card": card, "lane_models": lanes,
            "providers": {name: dict(value) for name, value in providers.items() if isinstance(value, dict)}}


def credits_for(usage, rate):
    cached = usage.get("cached", 0)
    return ((usage["input"] - cached) * rate["input"] + cached * rate["cached"] + usage["output"] * rate["output"]) / 1e6


def read_rollout(path):
    """Last token_count totals and the last turn_context model. Nothing else from the rollout is read or printed."""
    usage, model = None, None
    with open(path, "r", encoding="utf-8", errors="replace") as stream:
        for line in stream:
            if '"token_count"' not in line and '"turn_context"' not in line:
                continue
            try:
                row = json.loads(line)
            except ValueError:
                continue
            payload = row.get("payload") if isinstance(row, dict) else None
            if not isinstance(payload, dict):
                continue
            if row.get("type") == "turn_context" and isinstance(payload.get("model"), str):
                model = payload["model"]
            if row.get("type") == "event_msg" and payload.get("type") == "token_count":
                info = payload.get("info") if isinstance(payload.get("info"), dict) else {}
                total = info.get("total_token_usage")
                if isinstance(total, dict) and number(total.get("input_tokens")) is not None \
                        and number(total.get("output_tokens")) is not None:
                    usage = {"input": int(total["input_tokens"]), "cached": int(number(total.get("cached_input_tokens")) or 0),
                             "output": int(total["output_tokens"])}
    return usage, model


class Rollouts:
    def __init__(self, codex_home, pricing):
        self.home = codex_home
        self.pricing = pricing
        self.cache = {}

    def credits(self, session_id, started_at, lane):
        """Credits backfilled from a Codex rollout, or None when there is no rollout to read."""
        if not isinstance(session_id, str) or not SESSION_RE.match(session_id):
            return None
        if session_id not in self.cache:
            self.cache[session_id] = self._find_and_read(session_id, started_at)
        found = self.cache[session_id]
        if found is None:
            return None
        usage, model = found
        card = self.pricing["rate_card"]
        key = lane if lane in card else next((name for name in card if model and name in model), None)
        if usage is None or key is None:
            return None
        return credits_for(usage, card[key])

    def _find_and_read(self, session_id, started_at):
        base = glob.escape(os.path.join(self.home, "sessions"))
        matches = []
        started = parse_time(started_at)
        if started is not None:
            for days in (-1, 0, 1):
                day = started + datetime.timedelta(days=days)
                matches += glob.glob(os.path.join(base, day.strftime("%Y/%m/%d"), "rollout-*-{}.jsonl".format(session_id)))
        if not matches:
            matches = glob.glob(os.path.join(base, "*", "*", "*", "rollout-*-{}.jsonl".format(session_id)))
        if not matches:
            return None
        return read_rollout(sorted(set(matches))[-1])


# ---------------------------------------------------------------- stats

def wilson(successes, total, z=WILSON_Z):
    if not total:
        return None, None
    p = successes / total
    z2 = z * z
    denominator = 1 + z2 / total
    centre = (p + z2 / (2 * total)) / denominator
    half = z * math.sqrt(p * (1 - p) / total + z2 / (4 * total * total)) / denominator
    return max(0.0, centre - half), min(1.0, centre + half)


def bootstrap_recall(pairs, seed=BOOTSTRAP_SEED, resamples=BOOTSTRAP_RESAMPLES):
    """pairs = [(found, total)] per item; resample items with replacement and take the pooled recall."""
    if not pairs:
        return None, None
    rng = random.Random(seed)
    count = len(pairs)
    samples = []
    for _ in range(resamples):
        found = total = 0
        for _ in range(count):
            f, t = pairs[rng.randrange(count)]
            found += f
            total += t
        if total:
            samples.append(found / total)
    if not samples:
        return None, None
    return percentile(samples, 0.025), percentile(samples, 0.975)


def mcnemar_exact(b, c):
    """Two-sided exact binomial test on the discordant pairs b and c."""
    n = b + c
    if n == 0:
        return 1.0
    tail = sum(math.comb(n, i) for i in range(min(b, c) + 1)) / 2 ** n
    return min(1.0, 2 * tail)


def ranks(values):
    ordered = sorted(range(len(values)), key=lambda i: values[i])
    result = [0.0] * len(values)
    i = 0
    while i < len(ordered):
        j = i
        while j + 1 < len(ordered) and values[ordered[j + 1]] == values[ordered[i]]:
            j += 1
        average = (i + j) / 2 + 1
        for k in range(i, j + 1):
            result[ordered[k]] = average
        i = j + 1
    return result


def pearson(xs, ys):
    n = len(xs)
    mx, my = sum(xs) / n, sum(ys) / n
    sxy = sum((x - mx) * (y - my) for x, y in zip(xs, ys))
    sxx = sum((x - mx) ** 2 for x in xs)
    syy = sum((y - my) ** 2 for y in ys)
    if sxx == 0 or syy == 0:
        return None
    return sxy / math.sqrt(sxx * syy)


def spearman(xs, ys):
    """Rank correlation with averaged ties; None below three pairs or with no variance."""
    if len(xs) < 3:
        return None
    return pearson(ranks(xs), ranks(ys))


def cohen_kappa(a, b):
    """Agreement between two boolean hit vectors over the same defects, corrected for chance."""
    n = len(a)
    if n == 0:
        return None
    agree = sum(x == y for x, y in zip(a, b)) / n
    pa, pb = sum(a) / n, sum(b) / n
    expected = pa * pb + (1 - pa) * (1 - pb)
    if expected >= 1:
        return None
    return (agree - expected) / (1 - expected)


def claude_family(lane, model, weights):
    # The model decides before the lane: Fable runs through the opus lane but is metered as Fable.
    family = next((family for family in weights if model and family in model), None)
    return family or (lane if lane in weights else None)


def item_cost(meta, lane, provider, pricing, rollouts):
    """Per-item cost: credits or list dollars, the share of the weekly window, and the 5h share for Claude."""
    usage = (meta or {}).get("usage") if isinstance((meta or {}).get("usage"), dict) else {}
    tokens = usage.get("tokens") if isinstance(usage.get("tokens"), dict) else {}
    input_tokens = number(tokens.get("input", tokens.get("input_tokens")))
    output_tokens = number(tokens.get("output", tokens.get("output_tokens")))
    total = number(tokens.get("total"))
    # lane's Codex records carry input (cached included) and output but no total.
    if total is None and input_tokens is not None and output_tokens is not None:
        total = input_tokens + output_tokens
    result = {"tokens": total,
              "input_tokens": input_tokens,
              "cached_tokens": number(tokens.get("cached", tokens.get("cached_input", tokens.get("cached_input_tokens")))),
              "output_tokens": output_tokens,
              "cost": None, "pct_week": None, "pct_5h": None,
              "duration": number((meta or {}).get("duration_s")), "verdict": (meta or {}).get("verdict"),
              "unit": None}
    if meta is None:
        return result
    if provider == "codex":
        credits = number(usage.get("credits"))
        if credits is None:
            credits = rollouts.credits(meta.get("session_id"), meta.get("started_at"), lane)
        if credits is not None:
            result.update(cost=credits, unit="credits",
                          pct_week=credits / pricing["windows"]["codex"]["weekly_credits"] * 100)
    elif provider == "claude":
        listed = number(usage.get("list_usd"))
        window = pricing["windows"]["claude"]
        if listed is not None:
            family = claude_family(lane, meta.get("model"), window["model_weight_5h"])
            result.update(cost=listed, unit="list_usd", pct_week=listed / window["weekly_list_usd"] * 100)
            if family is not None:
                result["pct_5h"] = listed * window["model_weight_5h"][family] / window["five_hour_list_usd"] * 100
    return result


class LedgerIndex:
    """Ledger runs keyed by the workspace they reviewed; built once, only when a run.json cannot resolve."""

    def __init__(self, ledger):
        self.ledger = ledger
        self.by_dir = None

    def lookup(self, workspace):
        if self.by_dir is None:
            self.by_dir = self._scan()
        return self.by_dir.get(os.path.realpath(workspace))

    def _scan(self):
        index = {}
        if not os.path.isdir(self.ledger):
            return index
        for entry in os.scandir(self.ledger):
            if not entry.is_dir():
                continue
            meta = read_optional_json(os.path.join(entry.path, "meta.json"))
            if not isinstance(meta, dict) or not isinstance(meta.get("dir"), str):
                continue
            key = os.path.realpath(meta["dir"])
            current = index.get(key)
            if current is None or str(meta.get("started_at") or "") >= str(current.get("started_at") or ""):
                index[key] = meta
        return index


def load_run_meta(workspace, run, ledger_index):
    lane_dir = run.get("lane_run_dir") if run else None
    if isinstance(lane_dir, str) and lane_dir:
        meta = read_optional_json(os.path.join(lane_dir, "meta.json"))
        if isinstance(meta, dict):
            return meta
    if run and run.get("skipped"):
        return None
    return ledger_index.lookup(workspace)


def percentile_summary(values):
    return {"median": statistics.median(values) if values else None,
            "p90": percentile(values, 0.9) if values else None, "n": len(values)}


def arm_stats(name, agg_arm, items, records, pricing):
    """One arm's row. items = {item: defects}; records = {item: workspace record} for workspaces that exist."""
    parsed = parse_arm_name(name)
    lane, provider = parsed["lane"], PROVIDER_OF_LANE.get(parsed["lane"])
    model = parsed["model"] or pricing["lane_models"].get(lane)
    if model is None:
        model = next((rec["meta"].get("model") for rec in records.values() if rec["meta"]), None)
    found_total = agg_arm["defects_found"]
    total = found_total + agg_arm["defects_missed"]
    pairs, usable_count = [], 0
    counts = {"run": 0, "completed": 0, "skipped": 0, "infra": 0}
    finished_items = 0
    matched = unmatched = 0
    durations, tokens, costs, weeks, fives = [], [], [], [], []
    week_sum = 0.0
    for item, defects in items.items():
        detail = agg_arm["items"][item]
        pairs.append((detail["counts"]["defects_found"], len(defects)))
        matched += detail["counts"]["matched_findings"]
        unmatched += detail["counts"]["unmatched_findings"]
        if detail["status"] == "complete":
            counts["completed"] += 1
        if detail["findings_present"]:
            if defects:
                usable = detail["counts"]["defects_found"] >= 1 and detail["counts"]["unmatched_findings"] <= 2
            else:
                usable = detail["counts"]["unmatched_findings"] <= 1
            usable_count += usable
        record = records.get(item)
        if record is None:
            continue
        counts["run"] += 1
        run, meta = record["run"], record["meta"]
        if run and run.get("skipped"):
            counts["skipped"] += 1
            finished_items += 1
            continue
        lane_exit_path = os.path.join(record.get("workspace", ""), "lane.exit")
        lane_exit_present = record.get("lane_exit_present", os.path.isfile(lane_exit_path))
        if lane_exit_present:
            finished_items += 1
        if "infra_failure" in record:
            counts["infra"] += bool(record["infra_failure"])
        cost = record.get("cost") if "cost" in record else item_cost(meta, lane, provider, pricing, record["rollouts"])
        if lane_exit_present:
            verdict, duration = cost["verdict"], cost["duration"]
            lane_exit = record.get("lane_exit")
            if "lane_exit" not in record:
                try:
                    with open(lane_exit_path, encoding="utf-8") as exit_stream:
                        lane_exit = exit_stream.read().strip()
                except OSError:
                    lane_exit = None
            findings_present = record.get("findings_present", os.path.isfile(os.path.join(record.get("workspace", ""), "findings.jsonl")))
            valid_claude_noop = lane in CLAUDE_LANES and lane_exit == "3" and findings_present
            # an exported outcome row already carries this verdict as infra_failure (counted above)
            if "infra_failure" not in record and not valid_claude_noop and (meta is None or verdict in (None, "BUSY") or (
                    verdict == "FAILED" and duration is not None and duration < FAST_FAIL_S)):
                counts["infra"] += 1
        if cost["duration"] is not None:
            durations.append(cost["duration"])
        if cost["tokens"] is not None:
            tokens.append(cost["tokens"])
        if cost["cost"] is not None:
            costs.append(cost["cost"])
        if cost["pct_week"] is not None:
            weeks.append(cost["pct_week"])
            week_sum += cost["pct_week"]
        if cost["pct_5h"] is not None:
            fives.append(cost["pct_5h"])
    lo, hi = wilson(found_total, total)
    boot_lo, boot_hi = bootstrap_recall(pairs)
    alarms = agg_arm["false_alarms"]
    precision = matched / (matched + unmatched) if matched + unmatched else None
    return {
        "arm": name, "lane": lane, "effort": parsed["effort"], "model": model, "rep": parsed["rep"],
        "finished_items": finished_items, "partial": finished_items < len(items),
        "provider": provider,
        "items_run": counts["run"], "completed": counts["completed"], "skipped": counts["skipped"],
        "infra_failures": counts["infra"], "failed_runs": agg_arm["failed_runs"],
        "format_fail": agg_arm["format_fail"], "format_fail_items": agg_arm["format_fail_items"],
        "lenient_recall": agg_arm["lenient_recall"], "lenient_false_alarms": agg_arm["lenient_false_alarms"],
        "defects_found": found_total, "defects_total": total, "recall": agg_arm["recall"],
        "recall_wilson": [lo, hi], "recall_bootstrap": [boot_lo, boot_hi],
        "false_alarms": {kind: {"per_item": alarms[kind]["unmatched_findings_per_item"],
                                "completed_only_per_item": alarms[kind]["completed_only_unmatched_findings_per_item"],
                                "items": alarms[kind]["items"], "completed_items": alarms[kind]["completed_items"]}
                         for kind in ("planted", "control")},
        "precision": precision, "matched_findings": matched, "unmatched_findings": unmatched,
        "usable": {"items": usable_count, "rate": usable_count / len(items) if items else None},
        "wall_s": percentile_summary(durations),
        "tokens_per_item": {"mean": mean(tokens), "n": len(tokens)},
        "cost_per_item": {"mean": mean(costs), "n": len(costs), "unit": {"codex": "credits", "claude": "list_usd"}.get(provider)},
        "pct_week_per_item": {"mean": mean(weeks), "n": len(weeks)},
        "pct_5h_per_item": {"mean": mean(fives), "n": len(fives)} if provider == "claude" else None,
        "pct_week_per_defect": (week_sum / found_total) if found_total else None,
    }


def collect(suite, ledger, arms_json, codex_home, only=None):
    """Every per-arm number, from the workspaces, the ledger and the rollouts. Read-only."""
    pricing = load_pricing(arms_json)
    if not os.path.isdir(suite.runs_root):
        raise BenchError(f"no runs directory under {suite.root}")
    names = sorted(p for p in os.listdir(suite.runs_root) if os.path.isdir(os.path.join(suite.runs_root, p)))
    if only:
        missing = sorted(set(only) - set(names))
        if missing:
            raise BenchError("no such arm: " + ", ".join(missing))
        names = sorted(set(only))
    if not names:
        raise BenchError(f"no arm directories under {suite.runs_root}")
    items = suite.load_items()
    agg = aggregate(items, suite.runs_root, names, suite.window)
    ledger_index = LedgerIndex(ledger)
    rollouts = Rollouts(codex_home, pricing)
    rows, records_by_arm = {}, {}
    for name in names:
        records = {}
        for item in items:
            workspace = os.path.join(suite.runs_root, name, item)
            if os.path.isdir(workspace):
                run = read_optional_json(os.path.join(workspace, "run.json"))
                meta = load_run_meta(workspace, run, ledger_index)
                parsed = parse_arm_name(name)
                records[item] = {"workspace": workspace, "run": run, "rollouts": rollouts,
                                 "meta": meta,
                                 "cost": item_cost(meta, parsed["lane"], PROVIDER_OF_LANE.get(parsed["lane"]),
                                                   pricing, rollouts),
                                 "plan": (((meta or {}).get("usage") or {}).get("before") or {}).get("plan")}
        records_by_arm[name] = records
        rows[name] = arm_stats(name, agg["arms"][name], items, records, pricing)
        # The plan the runs were metered on (Codex: prolite or plus); priors carry it so the picker can rescale.
        plans = [record.get("plan") for record in records.values() if record.get("plan")]
        rows[name]["plan"] = max(set(plans), key=plans.count) if plans else None
    return {"agg": agg, "rows": rows, "pricing": pricing, "items": items, "names": names,
            "records": records_by_arm}


# ---------------------------------------------------------------- de-identified outcomes

def safe_exit_code(value):
    """Keep lane.exit useful to stats without copying arbitrary workspace text."""
    if isinstance(value, str) and re.fullmatch(r"-?[0-9]+", value.strip()):
        return int(value.strip())
    return None


def safe_verdict(value):
    return value if value in ("OK", "BUSY", "FAILED") else None


def summary_detail(summary, arm, item):
    """Select the ID/count/status fields needed from a graded summary, never finding payloads."""
    source = summary.get("arms", {}).get(arm, {}).get("items", {}).get(item)
    if not isinstance(source, dict):
        raise BenchError(f"summary has no graded row for {arm} {item}")
    strict = source.get("counts") or {}
    lenient = (source.get("lenient") or {}).get("counts") or {}
    return {"defects_found": list(source.get("defects_found", [])),
            "defects_missed": list(source.get("defects_missed", [])),
            "counts": {key: strict.get(key, 0) for key in
                       ("defects_found", "defects_missed", "matched_findings", "unmatched_findings")},
            "lenient": {"defects_found": list((source.get("lenient") or {}).get("defects_found", [])),
                        "defects_missed": list((source.get("lenient") or {}).get("defects_missed", [])),
                        "counts": {key: lenient.get(key, 0) for key in
                                   ("defects_found", "defects_missed", "matched_findings", "unmatched_findings")}},
            "status": source.get("status"), "lane_exit": source.get("lane_exit"),
            "findings_present": bool(source.get("findings_present"))}


def project_grade_summary(data, selected=None):
    """The same projection as read_grade_summary's jq query, for machines without jq (Windows, 2026-10-28)."""
    def pick(source, keys):
        source = source if isinstance(source, dict) else {}
        return {key: source.get(key) for key in keys}

    def safe_item(item):
        safe = pick(item, ("defects_found", "defects_missed", "counts"))
        safe["lenient"] = pick((item or {}).get("lenient") if isinstance(item, dict) else None,
                               ("defects_found", "defects_missed", "counts"))
        safe.update(pick(item, ("status", "lane_exit", "findings_present")))
        return safe

    arms = data.get("arms") if isinstance(data, dict) else None
    if not isinstance(arms, dict):
        return {"arms": None}
    return {"arms": {arm: {"items": {item: safe_item(value) for item, value in
                                     ((value or {}).get("items") or {}).items()}}
                     for arm, value in arms.items() if selected is None or arm in selected}}


def read_grade_summary(path, selected=None):
    """Use jq to retain only safe per-item grade fields from the frozen summary."""
    if os.name == "nt" or not shutil.which("jq"):
        try:
            with open(path, encoding="utf-8") as stream:
                result = project_grade_summary(json.load(stream), selected)
        except (OSError, ValueError) as exc:
            raise BenchError("cannot read graded summary") from exc
        if not isinstance(result.get("arms"), dict):
            raise BenchError("graded summary has no arms object")
        return result
    query = ('def safe_item: {defects_found,defects_missed,counts,'
             'lenient:(.lenient|{defects_found,defects_missed,counts}),status,lane_exit,findings_present}; '
             '{arms:(.arms|with_entries(.key as $arm | '
             'select($selected == null or ($selected|index($arm))) | '
             '.value={items:(.value.items|with_entries(.value |= safe_item))}))}')
    code, output = run_capture(["timeout", "120", "jq", "-c", "--argjson", "selected",
                                json.dumps(selected), query, path], timeout=125)
    if code != 0:
        raise BenchError("cannot query graded summary with jq")
    try:
        result = json.loads(output)
    except ValueError as exc:
        raise BenchError("graded summary query returned invalid JSON") from exc
    if not isinstance(result, dict) or not isinstance(result.get("arms"), dict):
        raise BenchError("graded summary has no arms object")
    return result


def write_outcomes(suite, collected, output, summary=None):
    items = collected["items"]
    names = collected["names"]
    item_defects = {item: [defect["id"] for defect in defects] for item, defects in items.items()}
    header = {"type": "header", "schema_version": 1, "suite": suite.name, "class": suite.cls,
              "window": suite.window, "item_count": len(items),
              "total_defects": sum(len(defects) for defects in item_defects.values()),
              "planted_items": [item for item, defects in item_defects.items() if defects],
              "control_items": [item for item, defects in item_defects.items() if not defects],
              "item_defect_ids": item_defects, "arms": names}
    lines = [json.dumps(header, separators=(",", ":"))]
    for arm in names:
        arm_row = collected["rows"][arm]
        for item, defects in items.items():
            detail = (summary_detail(summary, arm, item) if summary is not None
                      else collected["agg"]["arms"][arm]["items"][item])
            record = collected["records"][arm].get(item)
            cost = (record or {}).get("cost") or {"tokens": None, "input_tokens": None, "cached_tokens": None,
                    "output_tokens": None, "cost": None, "unit": None, "pct_week": None,
                    "pct_5h": None, "duration": None, "verdict": None}
            run = (record or {}).get("run") or {}
            lane_exit_present = detail.get("lane_exit") is not None
            exit_code = safe_exit_code(detail.get("lane_exit"))
            if lane_exit_present and exit_code is None:
                safe_exit = "other"
            else:
                safe_exit = str(exit_code) if exit_code is not None else None
            status = detail.get("status")
            if status not in ("complete", "format_fail", "failed", "incomplete", "missing"):
                status = "missing"
            found = detail.get("defects_found", [])
            missed = detail.get("defects_missed", [])
            lenient = detail.get("lenient") or {}
            row = {"type": "outcome", "arm": arm, "lane": arm_row["lane"], "model": arm_row["model"],
                   "effort": arm_row["effort"], "rep": arm_row["rep"], "provider": arm_row["provider"],
                   "plan": (record or {}).get("plan"), "stats_plan": arm_row.get("plan"), "item": item,
                   "kind": "planted" if defects else "control",
                   "defects_found": [item + ":" + value for value in found],
                   "defects_missed": [item + ":" + value for value in missed],
                   "lenient_found": [item + ":" + value for value in lenient.get("defects_found", [])],
                   "lenient_missed": [item + ":" + value for value in lenient.get("defects_missed", [])],
                   "matched_findings": detail["counts"]["matched_findings"],
                   "unmatched_findings": detail["counts"]["unmatched_findings"],
                   "lenient_matched_findings": lenient.get("counts", {}).get("matched_findings", len(lenient.get("defects_found", []))),
                   "lenient_unmatched_findings": lenient.get("counts", {}).get("unmatched_findings", 0),
                   "status": status, "lane_exit": safe_exit, "lane_exit_present": lane_exit_present,
                   "findings_present": bool(detail.get("findings_present")),
                   "format_fail": status == "format_fail", "run_present": record is not None,
                   "skipped": bool(run.get("skipped")),
                   "infra_failure": bool(record and detail.get("lane_exit") is not None and
                       not (arm_row["lane"] in CLAUDE_LANES and detail.get("lane_exit") == "3" and
                            detail.get("findings_present")) and
                       ((record.get("meta") is None) or cost.get("verdict") in (None, "BUSY") or
                        (cost.get("verdict") == "FAILED" and cost.get("duration") is not None and
                         cost["duration"] < FAST_FAIL_S))),
                   "input_tokens": cost.get("input_tokens"), "cached_tokens": cost.get("cached_tokens"),
                   "output_tokens": cost.get("output_tokens"), "tokens": cost.get("tokens"),
                   "cost": cost.get("cost"), "cost_unit": cost.get("unit"),
                   "pct_week": cost.get("pct_week"), "pct_5h": cost.get("pct_5h"),
                   "wall_s": cost.get("duration"), "verdict": safe_verdict(cost.get("verdict"))}
            lines.append(json.dumps(row, separators=(",", ":")))
    write_atomic(output, "\n".join(lines) + "\n")


def read_outcomes(path):
    try:
        with open(path, encoding="utf-8") as stream:
            records = [json.loads(line) for line in stream if line.strip()]
    except (OSError, ValueError) as exc:
        raise BenchError(f"cannot read outcomes file: {exc}") from exc
    if not records or records[0].get("type") != "header" or records[0].get("schema_version") != 1:
        raise BenchError("outcomes file has no supported header")
    header, rows = records[0], records[1:]
    items = header.get("item_defect_ids")
    if not isinstance(items, dict) or not items or not isinstance(header.get("arms"), list):
        raise BenchError("outcomes header is incomplete")
    expected = {(arm, item) for arm in header["arms"] for item in items}
    got = {(row.get("arm"), row.get("item")) for row in rows if row.get("type") == "outcome"}
    if got != expected or len(got) != len(rows):
        raise BenchError("outcomes rows do not match the header arms and items")
    return header, rows


def collected_from_outcomes(path, arms_json, only=None):
    header, rows = read_outcomes(path)
    if only:
        missing = sorted(set(only) - set(header["arms"]))
        if missing:
            raise BenchError("no such arm: " + ", ".join(missing))
        header = dict(header, arms=sorted(set(only)))
        rows = [row for row in rows if row["arm"] in header["arms"]]
    pricing = load_pricing(arms_json)
    items = {item: [{"id": defect_id} for defect_id in defect_ids]
             for item, defect_ids in header["item_defect_ids"].items()}
    by_arm = {arm: {} for arm in header["arms"]}
    for row in rows:
        by_arm[row["arm"]][row["item"]] = row
    matrix = {f"{item}:{defect_id}": {arm: False for arm in header["arms"]}
              for item, defects in items.items() for defect in defects for defect_id in [defect["id"]]}
    agg_arms, stats_rows, records_by_arm = {}, {}, {}
    for arm in header["arms"]:
        details, failures, format_items = {}, [], []
        alarms = {kind: {"unmatched_findings": 0, "items": 0, "completed_items": 0,
                         "completed_unmatched_findings": 0} for kind in ("planted", "control")}
        lenient_found = lenient_unmatched = 0
        records = {}
        for item, defects in items.items():
            row = by_arm[arm][item]
            def unqualify(values):
                return [value.split(":", 1)[1] for value in values]
            found, missed = unqualify(row["defects_found"]), unqualify(row["defects_missed"])
            len_found, len_missed = unqualify(row["lenient_found"]), unqualify(row["lenient_missed"])
            counts = {"defects_found": len(found), "defects_missed": len(missed),
                      "matched_findings": row["matched_findings"], "unmatched_findings": row["unmatched_findings"]}
            len_counts = {"defects_found": len(len_found), "defects_missed": len(len_missed),
                          "matched_findings": row["lenient_matched_findings"],
                          "unmatched_findings": row["lenient_unmatched_findings"]}
            details[item] = {"defects_found": found, "defects_missed": missed, "counts": counts,
                             "lenient": {"defects_found": len_found, "defects_missed": len_missed,
                                         "counts": len_counts}, "status": row["status"],
                             "lane_exit": row["lane_exit"], "findings_present": row["findings_present"]}
            for defect in found:
                matrix[f"{item}:{defect}"][arm] = True
            if row["lane_exit_present"] and row["lane_exit"] != "0":
                failures.append(item)
            if row["format_fail"]:
                format_items.append(item)
            lenient_found += len(len_found)
            lenient_unmatched += row["lenient_unmatched_findings"]
            group = alarms[row["kind"]]
            group["items"] += 1
            group["unmatched_findings"] += row["unmatched_findings"]
            if row["status"] == "complete":
                group["completed_items"] += 1
                group["completed_unmatched_findings"] += row["unmatched_findings"]
            if row["run_present"]:
                code = row["lane_exit"]
                if code == "other":
                    code = "1"
                run = {"skipped": "skipped"} if row["skipped"] else None
                cost = {"tokens": row["tokens"], "input_tokens": row["input_tokens"],
                        "cached_tokens": row["cached_tokens"], "output_tokens": row["output_tokens"],
                        "cost": row["cost"], "unit": row["cost_unit"], "pct_week": row["pct_week"],
                        "pct_5h": row["pct_5h"], "duration": row["wall_s"], "verdict": row["verdict"]}
                records[item] = {"run": run, "meta": {"model": row["model"]} if row.get("model") else None,
                                 "rollouts": None, "cost": cost,
                                 "lane_exit_present": row["lane_exit_present"], "lane_exit": code,
                                 "findings_present": row["findings_present"], "plan": row.get("plan"),
                                 "infra_failure": row.get("infra_failure", False)}
        for group in alarms.values():
            group["unmatched_findings_per_item"] = group["unmatched_findings"] / group["items"] if group["items"] else None
            group["completed_only_unmatched_findings_per_item"] = (
                group["completed_unmatched_findings"] / group["completed_items"] if group["completed_items"] else None)
        total = header["total_defects"]
        found_total = sum(len(detail["defects_found"]) for detail in details.values())
        agg_arm = {"defects_found": found_total, "defects_missed": total - found_total,
                   "recall": found_total / total if total else None,
                   "completed_items": sum(detail["status"] == "complete" for detail in details.values()),
                   "failed_runs": len(failures), "format_fail": len(format_items), "format_fail_items": format_items,
                   "lenient_defects_found": lenient_found,
                   "lenient_recall": lenient_found / total if total else None,
                   "lenient_false_alarms": lenient_unmatched,
                   "missing_items": [item for item, detail in details.items() if not detail["findings_present"]],
                   "failed_items": failures, "false_alarms": alarms, "items": details}
        agg_arms[arm] = agg_arm
        arm_records = records
        stats_rows[arm] = arm_stats(arm, agg_arm, items, arm_records, pricing)
        plans = [record.get("plan") for record in records.values() if record.get("plan")]
        stats_rows[arm]["plan"] = by_arm[arm][next(iter(items))].get("stats_plan") if items else None
        records_by_arm[arm] = records
    agg = {"schema_version": 1, "items": len(items), "total_defects": header["total_defects"],
           "arms": agg_arms, "per_defect_hit_matrix": matrix}
    names = list(header["arms"])
    return {"agg": agg, "rows": stats_rows, "pricing": pricing, "items": items, "names": names,
            "records": records_by_arm, "header": header, "outcome_rows": rows}


def outcomes_suite(header, outcomes_path):
    suite = Suite(os.path.dirname(os.path.abspath(outcomes_path)), header["suite"], header["class"],
                  header["window"], "")
    suite.results_root = os.path.join(os.path.dirname(os.path.abspath(outcomes_path)), "results")
    return suite


def pool_rows(rows, item_count, usable_key="usable"):
    groups = {}
    for name, row in rows.items():
        if row["partial"]:
            continue
        groups.setdefault((row["lane"], row["model"], row["effort"]), []).append((name, row))
    pooled = []
    for (lane, model, effort), arms in sorted(groups.items(), key=lambda item: tuple(str(v or "") for v in item[0])):
        arms.sort(key=lambda pair: (pair[1]["rep"], pair[0]))
        found = sum(row["defects_found"] for _, row in arms)
        defects = sum(row["defects_total"] for _, row in arms)
        usable_items = sum(row[usable_key]["items"] for _, row in arms)
        n_items = item_count * len(arms)
        matched = sum(row["matched_findings"] for _, row in arms)
        unmatched = sum(row["unmatched_findings"] for _, row in arms)
        lo, hi = wilson(found, defects)

        def weighted(key):
            values = [(row[key]["mean"], item_count) for _, row in arms
                      if row.get(key) is not None and row[key]["mean"] is not None]
            total_weight = sum(weight for _, weight in values)
            return sum(value * weight for value, weight in values) / total_weight if total_weight else None

        plans = [row.get("plan") for _, row in arms if row.get("plan")]
        plan = max(set(plans), key=plans.count) if plans else None
        first = arms[0][1]
        pooled.append({
            "lane": lane, "model": model, "effort": effort, "provider": first["provider"],
            "arms": [name for name, _ in arms], "reps": len(arms),
            "rep_numbers": [row["rep"] for _, row in arms],
            "items": n_items, "defects_found": found, "defects_total": defects,
            "recall": found / defects if defects else None, "recall_wilson": [lo, hi],
            "usable_items": usable_items, "usable": usable_items / n_items if n_items else None,
            "matched_findings": matched, "unmatched_findings": unmatched,
            "precision": matched / (matched + unmatched) if matched + unmatched else None,
            "format_fail": sum(row["format_fail"] for _, row in arms),
            "cost_per_item": weighted("cost_per_item"), "pct_week_per_item": weighted("pct_week_per_item"),
            "pct_5h_per_item": weighted("pct_5h_per_item"), "plan": plan,
            "completed": sum(row["completed"] for _, row in arms),
        })
    return pooled


def pareto(pooled, pricing):
    by_provider = {}
    cost_points = []
    providers = pricing.get("providers", {})
    for provider in sorted({row["provider"] for row in pooled if row["provider"]}):
        scarcity = providers.get(provider, {}).get("scarcity")
        points = [(row["pct_week_per_item"], row["recall"], ", ".join(row["arms"])) for row in pooled
                  if row["provider"] == provider and row["pct_week_per_item"] is not None and row["recall"] is not None]
        by_provider[provider] = _pareto_names(points)
        if scarcity is not None:
            cost_points.extend((cost * scarcity, recall, name) for cost, recall, name in points)
    return {"by_provider": by_provider, "cost_points": _pareto_names(cost_points),
            "basis": "Pooled recall against provider %week/item; combined cost points multiply %week/item by provider scarcity."}


def _pareto_names(points):
    points.sort(key=lambda point: (point[0], -point[1], point[2]))
    frontier, best = [], -1.0
    for _, recall, name in points:
        if recall > best:
            frontier.append(name)
            best = recall
    return frontier


def effort_curves(pooled):
    groups = {}
    for row in pooled:
        if row["effort"] in EFFORTS:
            groups.setdefault((row["lane"], row["model"]), {})[row["effort"]] = row
    curves = []
    for (lane, model), efforts in sorted(groups.items(), key=lambda kv: (kv[0][0], kv[0][1] or "")):
        cells = []
        for effort in EFFORTS:
            row = efforts.get(effort)
            cells.append({"effort": effort, "arm": ", ".join(row["arms"]) if row else None,
                          "recall": row["recall"] if row else None, "reps": row["reps"] if row else 0,
                          "reps_list": row["rep_numbers"] if row else []})
        curves.append({"lane": lane, "model": model, "efforts": cells})
    return curves


def hit_vector(agg, arm):
    return [agg["per_defect_hit_matrix"][key][arm] for key in agg["per_defect_hit_matrix"]]


def mcnemar_pairs(agg, curves):
    results = []
    for curve in curves:
        cells = {cell["effort"]: cell["arm"].split(", ")[0] for cell in curve["efforts"]
                 if cell["arm"] and cell["reps_list"] and cell["reps_list"][0] == 1}
        for lower, upper in zip(EFFORTS, EFFORTS[1:]):
            if lower in cells and upper in cells:
                a, b = hit_vector(agg, cells[lower]), hit_vector(agg, cells[upper])
                only_a = sum(x and not y for x, y in zip(a, b))
                only_b = sum(y and not x for x, y in zip(a, b))
                results.append({"lane": curve["lane"], "model": curve["model"], "from": lower, "to": upper,
                                "from_arm": cells[lower], "to_arm": cells[upper],
                                "only_from": only_a, "only_to": only_b,
                                "p_value": mcnemar_exact(only_a, only_b)})
    return results


def replicate_pairs(agg, rows):
    results = []
    groups = {}
    for name, row in rows.items():
        if not row["partial"]:
            groups.setdefault((row["lane"], row["model"], row["effort"]), []).append(name)
    for names in groups.values():
        by_rep = {rows[name]["rep"]: name for name in names}
        if 1 not in by_rep:
            continue
        for rep in sorted(key for key in by_rep if key > 1):
            name, twin = by_rep[1], by_rep[rep]
            a, b = hit_vector(agg, name), hit_vector(agg, twin)
            results.append({"arm": name, "replicate": twin,
                            "recall_difference": rows[twin]["recall"] - rows[name]["recall"]
                            if rows[twin]["recall"] is not None and rows[name]["recall"] is not None else None,
                            "kappa": cohen_kappa(a, b)})
    return results


def fmt(value, places=3):
    if value is None:
        return "n/a"
    if isinstance(value, float):
        return f"{value:.{places}f}"
    return str(value)


def interval(pair, places=3):
    if pair[0] is None:
        return "n/a"
    return "[{}, {}]".format(fmt(pair[0], places), fmt(pair[1], places))


def stats_markdown(report):
    lines = [f"# Suite {report['suite']} stats", "",
             f"Class {report['class']}; {report['items']} items; {report['total_defects']} defects; "
             f"matching window {report['window']} lines. Wilson 95% on recall; bootstrap 95% over items "
             f"({BOOTSTRAP_RESAMPLES} resamples, seed {BOOTSTRAP_SEED}). Missing items count as zero.", "",
             "| Arm | Items run | Completed | Infra fail | Skipped | Found | Recall | Format fail | Lenient recall | Lenient false alarms | Wilson 95% | Bootstrap 95% | FA/planted item | FA/control item | Precision | Usable | Wall median s | Wall p90 s | Tokens/item | Cost/item | %week/item | %5h/item | %week/defect |",
             "|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|"]
    for name, row in report["arms"].items():
        cost_unit = row["cost_per_item"]["unit"]
        lines.append("| {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} |".format(
            name + (" (partial)" if row["partial"] else ""), row["items_run"], row["completed"], row["infra_failures"], row["skipped"],
            row["defects_found"], fmt(row["recall"]), row["format_fail"], fmt(row["lenient_recall"]), row["lenient_false_alarms"], interval(row["recall_wilson"]), interval(row["recall_bootstrap"]),
            fmt(row["false_alarms"]["planted"]["per_item"]), fmt(row["false_alarms"]["control"]["per_item"]),
            fmt(row["precision"]), "{}/{}".format(row["usable"]["items"], report["items"]),
            fmt(row["wall_s"]["median"], 1), fmt(row["wall_s"]["p90"], 1),
            fmt(row["tokens_per_item"]["mean"], 0),
            "{} {}".format(fmt(row["cost_per_item"]["mean"], 5), cost_unit or "") if row["cost_per_item"]["mean"] is not None else "n/a",
            fmt(row["pct_week_per_item"]["mean"], 5),
            fmt(row["pct_5h_per_item"]["mean"], 5) if row["pct_5h_per_item"] else "n/a",
            fmt(row["pct_week_per_defect"], 5)))
    partial = [name for name, row in report["arms"].items() if row["partial"]]
    lines += ["", "Partial arms (excluded from curves, tests, Pareto, compare and priors): " + (", ".join(partial) or "none"),
              "", "## Pooled over replicates", "",
              "| Lane | Model | Effort | Reps | Recall | Wilson 95% | Usable | Precision | Format fail | Cost/item | %week/item | %5h/item |",
              "|---|---|---|---:|---:|---|---:|---:|---:|---:|---:|---:|"]
    for row in report["pooled"]:
        lines.append("| {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} |".format(
            row["lane"], row["model"] or "-", row["effort"], row["reps"], fmt(row["recall"]),
            interval(row["recall_wilson"]), fmt(row["usable"]), fmt(row["precision"]), row["format_fail"],
            fmt(row["cost_per_item"], 5), fmt(row["pct_week_per_item"], 5), fmt(row["pct_5h_per_item"], 5)))
    lines += ["", "## Pareto frontier by provider window", ""]
    for provider, names in report["pareto"]["by_provider"].items():
        lines.append(f"{provider}: " + (", ".join(names) or "none"))
    lines += ["", "## Pareto frontier on picker cost points", ""]
    lines += ["- " + name for name in report["pareto"]["cost_points"]] or ["none"]
    lines.append(report["pareto"]["basis"])
    lines += ["", "## Effort curves", "", "| Lane | Model | " + " | ".join(EFFORTS) + " |",
              "|---|---|" + "---:|" * len(EFFORTS)]
    for curve in report["effort_curves"]:
        cells = [(fmt(cell["recall"]) + (f" [{cell['reps']}]" if cell["reps"] > 1 else ""))
                 if cell["arm"] else "-" for cell in curve["efforts"]]
        lines.append("| {} | {} | {} |".format(curve["lane"], curve["model"] or "-", " | ".join(cells)))
    lines += ["", "## Adjacent efforts, exact McNemar on defect hits", "",
              "Paired comparisons use complete rep-1 arms only.", "",
              "| Lane | Model | From | To | Only from | Only to | p |", "|---|---|---|---|---:|---:|---:|"]
    for pair in report["mcnemar"]:
        lines.append("| {} | {} | {} | {} | {} | {} | {} |".format(
            pair["lane"], pair["model"] or "-", pair["from"], pair["to"], pair["only_from"], pair["only_to"],
            fmt(pair["p_value"])))
    lines += ["", "## Replicates (each rep against rep 1)", "", "| Arm | Replicate | Recall difference (replicate minus rep 1) | Cohen's kappa |",
              "|---|---|---:|---:|"]
    for pair in report["replicates"]:
        lines.append("| {} | {} | {} | {} |".format(pair["arm"], pair["replicate"], fmt(pair["recall_difference"]),
                                                    fmt(pair["kappa"])))
    lines.append("")
    return "\n".join(lines)


def build_stats_report(suite, collected):
    rows = collected["rows"]
    agg = collected["agg"]
    pooled = pool_rows(rows, len(collected["items"]))
    curves = effort_curves(pooled)
    return {"schema_version": 1, "suite": suite.name, "class": suite.cls, "window": suite.window,
            "items": len(collected["items"]), "total_defects": agg["total_defects"],
            "pricing": {"windows": collected["pricing"]["windows"], "rate_card": collected["pricing"]["rate_card"]},
            "arms": rows, "pooled": pooled, "pareto": pareto(pooled, collected["pricing"]), "effort_curves": curves,
            "mcnemar": mcnemar_pairs(agg, curves), "replicates": replicate_pairs(agg, rows)}


def cmd_stats(args):
    outcomes_path = getattr(args, "outcomes", None)
    if outcomes_path:
        header, _ = read_outcomes(outcomes_path)
        suite = outcomes_suite(header, outcomes_path)
        collected = collected_from_outcomes(outcomes_path, args.arms_json or arms_json_default(), args.arm)
    else:
        suite = load_suite(args.suite)
        collected = collect(suite, args.ledger or ledger_default(), args.arms_json or arms_json_default(),
                            args.codex_home or os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex"), args.arm)
    report = build_stats_report(suite, collected)
    output = args.results_dir or suite.results_root
    write_json(os.path.join(output, "stats.json"), report)
    write_atomic(os.path.join(output, "stats.md"), stats_markdown(report))
    print(f"STATS {len(report['arms'])} arms, {report['items']} items, {report['total_defects']} defects")
    print(f"WROTE {os.path.join(output, 'stats.json')}")
    print(f"WROTE {os.path.join(output, 'stats.md')}")
    return 0


# ---------------------------------------------------------------- compare

def load_public(path):
    rows = read_optional_json(path)
    if not isinstance(rows, list):
        raise BenchError(f"public numbers must be a list: {path}")
    entries = {}
    for row in rows:
        if not isinstance(row, dict) or not isinstance(row.get("lane"), str) or not isinstance(row.get("metric"), str) \
                or number(row.get("value")) is None:
            raise BenchError(f"malformed public row in {path}: {row!r}")
        key = (row["lane"], row.get("model"), row.get("effort"))
        entry = entries.setdefault(key, {"lane": row["lane"], "model": row.get("model"), "effort": row.get("effort"),
                                         "metrics": {}, "details": {}, "source": row.get("source"),
                                         "date": row.get("date"), "url": row.get("url")})
        entry["metrics"][row["metric"]] = number(row["value"])
        entry["details"][row["metric"]] = {"source": row.get("source"), "date": row.get("date"), "url": row.get("url")}
    return list(entries.values())


PUBLIC_FAMILIES = ("haiku", "sonnet", "opus", "fable", "luna", "terra", "sol", "astra")


def public_lane(arm_row):
    # A model run through another lane (Fable through the opus lane) is compared as its own model.
    model = arm_row.get("model") or ""
    return next((family for family in PUBLIC_FAMILIES if family in model), arm_row["lane"])


def entry_matches(entry, arm_row):
    # Public rows carry display names ("GPT-6 Luna (Codex)"), never our model ids; the model family and effort identify the arm.
    return entry["lane"] == public_lane(arm_row) and (entry["effort"] is None or entry["effort"] == arm_row["effort"])


def public_display_path(path):
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    absolute = os.path.realpath(path)
    try:
        relative = os.path.relpath(absolute, root)
    except ValueError:
        relative = None
    shown = relative if relative and relative != os.pardir and not relative.startswith(os.pardir + os.sep) else os.path.basename(path)
    # `/` on every system: the reports ship in the kit and must not change with the machine that built them.
    return shown.replace(os.sep, "/")


def disagreements(points, metric):
    """Pairs whose public order is opposite to ours and whose recall Wilson intervals do not overlap."""
    found = []
    for (a, va, ra, ca, na), (b, vb, rb, cb, nb) in itertools.combinations(points, 2):
        if va == vb or ra == rb:
            continue
        if (va - vb) * (ra - rb) >= 0:
            continue
        if ca[1] >= cb[0] and cb[1] >= ca[0]:
            continue
        found.append({"metric": metric, "arms": [na, nb], "public": [va, vb], "recall": [ra, rb],
                      "recall_wilson": [list(ca), list(cb)]})
    return found


def cmd_compare(args):
    outcomes_path = getattr(args, "outcomes", None)
    if outcomes_path:
        header, _ = read_outcomes(outcomes_path)
        suite = outcomes_suite(header, outcomes_path)
        collected = collected_from_outcomes(outcomes_path, args.arms_json or arms_json_default(), args.arm)
    else:
        suite = load_suite(args.suite)
        collected = collect(suite, args.ledger or ledger_default(), args.arms_json or arms_json_default(),
                            args.codex_home or os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex"), args.arm)
    rows = collected["rows"]
    pooled = pool_rows(rows, len(collected["items"]))
    public_path = args.public or PUBLIC_DEFAULT
    entries = load_public(public_path)
    matched = {}
    for index, row in enumerate(pooled):
        found = [entry for entry in entries if entry_matches(entry, row)]
        if found:
            matched[index] = dict(found[0], metrics={})
            for entry in found:
                matched[index]["metrics"].update(entry["metrics"])
    metrics = sorted({metric for entry in entries for metric in entry["metrics"]})
    result = {"schema_version": 1, "suite": suite.name, "public": public_display_path(public_path), "metrics": {}}
    skipped_metrics = []
    for metric in metrics:
        points = [(index, matched[index]["metrics"][metric], pooled[index]) for index in sorted(matched)
                  if metric in matched[index]["metrics"] and pooled[index]["recall"] is not None]
        if len(points) < 3:
            skipped_metrics.append(metric)
            continue
        rho = spearman([row["recall"] for _, _, row in points], [value for _, value, _ in points])
        per_cost = []
        # A score is divided by its own source's cost (aa_cai_index by aa_cai_cost_per_task_usd), once per arm;
        # cost and token metrics have no "per $" form.
        source = "_".join(metric.split("_")[:2]) + "_"
        cost_metric = source + "cost_per_task_usd"
        if not metric.endswith(("_cost_per_task_usd", "_tokens_per_task_m")):
            for index, value, row in points:
                pct = row["pct_week_per_item"]
                usd = matched[index]["metrics"].get(cost_metric)
                if usd and usd > 0 and pct and pct > 0:
                    per_cost.append((row["recall"] / pct, value / usd))
        rho_cost = spearman([x for x, _ in per_cost], [y for _, y in per_cost])
        flips = disagreements([(", ".join(row["arms"]), value, row["recall"], tuple(row["recall_wilson"]),
                                ", ".join(row["arms"])) for _, value, row in points], metric)
        result["metrics"][metric] = {
            "spearman_recall": {"rho": rho, "n": len(points)},
            "spearman_recall_per_pct_week": {"rho": rho_cost, "n": len(per_cost)},
            "disagreements": flips}
    cost_agreement = {}
    for metric in metrics:
        if not metric.endswith("_cost_per_task_usd"):
            continue
        points = []
        ratios = []
        for index, row in enumerate(pooled):
            entry = matched.get(index)
            public_cost = entry["metrics"].get(metric) if entry else None
            provider = row["provider"]
            own_cost = row["cost_per_item"]
            if provider == "codex":
                provider_data = collected["pricing"].get("providers", {}).get("codex", {})
                rate = provider_data.get("usd_per_credit")
                if rate is None:
                    rate = collected["pricing"].get("windows", {}).get("codex", {}).get("usd_per_credit")
                own_cost = own_cost * rate if own_cost is not None and rate is not None else None
            if public_cost is not None and public_cost > 0 and own_cost is not None and own_cost > 0:
                points.append((own_cost, public_cost))
                ratios.append(public_cost / own_cost)
        if len(points) >= 3:
            cost_agreement[metric] = {"spearman_usd_per_item": {"rho": spearman([x for x, _ in points], [y for _, y in points]),
                                                                  "n": len(points)},
                                      "median_public_to_ours": statistics.median(ratios)}
    result["cost_agreement"] = cost_agreement
    table = []
    for name in sorted(rows):
        row = rows[name]
        found = [entry for entry in entries if entry_matches(entry, row)] if not row["partial"] else []
        public = {}
        for entry in found:
            public.update(entry["metrics"])
        table.append({"arm": name, "partial": row["partial"], "recall": row["recall"],
                      "recall_wilson": rows[name]["recall_wilson"],
                      "pct_week_per_item": rows[name]["pct_week_per_item"]["mean"],
                      "usable": rows[name]["usable"]["rate"],
                      "public_entry": (f"{found[0]['lane']} {found[0]['effort'] or ''}".strip() if found else None),
                      "public": public})
    result["table"] = table
    result["skipped_metrics"] = skipped_metrics
    result["unmatched_public"] = [f"{e['lane']} {e['effort'] or ''}".strip() for e in entries
                                  if not any(entry_matches(e, row) for row in pooled)]
    output = args.results_dir or suite.results_root
    write_json(os.path.join(output, "compare.json"), result)
    write_atomic(os.path.join(output, "compare.md"), compare_markdown(result))
    print(f"COMPARE {len(table)} arms against {len(entries)} public entries")
    print(f"WROTE {os.path.join(output, 'compare.json')}")
    print(f"WROTE {os.path.join(output, 'compare.md')}")
    return 0


def compare_markdown(result):
    metrics = list(result["metrics"])
    lines = [f"# Suite {result['suite']} against public numbers", "",
             f"Public numbers: {result['public']}. Correlations are Spearman rank over distinct pooled lane/model/effort points present in both; n/a below three points.", "",
             "Skipped metrics (fewer than 3 arms in common): " + (", ".join(result.get("skipped_metrics", [])) or "none"), "",
             "| Arm | Our recall | Wilson 95% | %week/item | Usable | Public entry | " + " | ".join(("vendor " + m if m.startswith("vendor_") else "review " + m if m.startswith("review_") else m) for m in metrics) + " |",
             "|---|---:|---|---:|---:|---|" + "---:|" * len(metrics)]
    for row in result["table"]:
        cells = [fmt(row["public"].get(metric)) for metric in metrics]
        lines.append("| {} | {} | {} | {} | {} | {} | {} |".format(
            row["arm"] + (" (partial)" if row.get("partial") else ""), fmt(row["recall"]), interval(row["recall_wilson"] or [None, None]),
            fmt(row["pct_week_per_item"], 5), fmt(row["usable"]), row["public_entry"] or "-", " | ".join(cells)))
    partial = [row["arm"] for row in result["table"] if row.get("partial")]
    lines += ["", "Partial arms (excluded from curves, tests, Pareto, compare and priors): " + (", ".join(partial) or "none")]
    for metric in metrics:
        block = result["metrics"][metric]
        lines += ["", f"## {metric}", "",
                  "- Spearman, our recall against {}: rho {} (n={})".format(
                      metric, fmt(block["spearman_recall"]["rho"]), block["spearman_recall"]["n"]),
                  "- Spearman, our recall per %week against {} per $: rho {} (n={})".format(
                      metric, fmt(block["spearman_recall_per_pct_week"]["rho"]), block["spearman_recall_per_pct_week"]["n"]),
                  "", "Disagreements (public order opposite to ours, recall Wilson intervals disjoint):", ""]
        lines += ["- {} vs {}: public {} vs {}, recall {} vs {}".format(
            d["arms"][0], d["arms"][1], fmt(d["public"][0]), fmt(d["public"][1]),
            fmt(d["recall"][0]), fmt(d["recall"][1])) for d in block["disagreements"]] or ["- none"]
    lines += ["", "Public entries with no matching arm: " + (", ".join(result["unmatched_public"]) or "none"), ""]
    lines += ["## Cost agreement", "", "The per-$ correlations above share a price term on both sides, so they partly restate price; this section tests price alone.", ""]
    if result.get("cost_agreement"):
        lines += ["| Public cost metric | Spearman our $/item vs public $/task | Median public $/task ÷ our $/item |",
                  "|---|---:|---:|"]
        for metric, block in result["cost_agreement"].items():
            lines.append("| {} | {} (n={}) | {} |".format(metric,
                         fmt(block["spearman_usd_per_item"]["rho"]), block["spearman_usd_per_item"]["n"],
                         fmt(block["median_public_to_ours"])))
    else:
        lines.append("No public cost metric has at least three matched points.")
    return "\n".join(lines)


# ---------------------------------------------------------------- priors

def merge_measured(existing, measured_by_identity):
    """Mirror of merge_catalog for arms: update by (lane, model, effort), keep every other field."""
    entries = {(arm.get("lane"), arm.get("model"), arm.get("effort")): arm for arm in existing.get("arms", [])}
    for identity, measured in measured_by_identity.items():
        entry = entries.get(identity)
        if entry is None:
            entry = {"lane": identity[0], "model": identity[1], "effort": identity[2]}
            existing.setdefault("arms", []).append(entry)
            entries[identity] = entry
        entry["measured"] = {**(entry.get("measured") or {}), **measured}
    return existing


def cmd_priors(args):
    score_version = getattr(args, "score", "v1")
    if score_version == "v2" and getattr(args, "suite", None):
        raise BenchError("--score v2 requires --outcomes from rescore; it cannot be used with --suite")
    arms_json = args.arms_json or arms_json_default()
    outcomes_path = getattr(args, "outcomes", None)
    if outcomes_path:
        header, outcome_rows = read_outcomes(outcomes_path)
        if score_version == "v2":
            for index, row in enumerate(outcome_rows, 1):
                if "usable_v2" not in row:
                    raise BenchError(f"outcomes row {index} {row.get('arm')}/{row.get('item')} lacks usable_v2")
        suite = outcomes_suite(header, outcomes_path)
        collected = collected_from_outcomes(outcomes_path, arms_json)
    else:
        suite = load_suite(args.suite)
        collected = collect(suite, args.ledger or ledger_default(), arms_json,
                            args.codex_home or os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex"))
    # Only arms the catalog already lists are written: lane-stats' merge_catalog appends unknown arms
    # without status/classes, and validate_catalog would then reject the whole catalog.
    raw = read_optional_json(arms_json) if os.path.exists(arms_json) else None
    catalog_arms = {(arm.get("lane"), arm.get("model"), arm.get("effort"))
                    for arm in (raw.get("arms", []) if isinstance(raw, dict) else []) if isinstance(arm, dict)}
    today = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")
    arms_out, measured_by_identity = [], {}
    if score_version == "v2":
        outcome_usable = {}
        for row in outcome_rows:
            outcome_usable.setdefault(row["arm"], []).append(bool(row["usable_v2"]))
        for name, arm_row in collected["rows"].items():
            values = outcome_usable.get(name, [])
            arm_row["usable_v2"] = {"items": sum(values), "rate": (sum(values) / len(values) if values else None)}
    for row in pool_rows(collected["rows"], len(collected["items"]),
                         usable_key="usable_v2" if score_version == "v2" else "usable"):
        if row["completed"] < args.min_items or row["model"] is None:
            continue
        usable_value = row["usable"]
        block = {"usable": usable_value, "pct_week": row["pct_week_per_item"],
                 "recall": row["recall"], "n": row["completed"], "source": f"{suite.name} {today}"}
        # lane-stats rejects a block missing any of these, and one bad block fails every lane-stats command.
        if any(block[key] is None for key in ("usable", "pct_week", "recall", "n")):
            log(f"priors: {', '.join(row['arms'])} lacks {', '.join(k for k in ('usable', 'pct_week', 'recall', 'n') if block[k] is None)}; skipped")
            continue
        if row.get("plan"):
            block["plan"] = row["plan"]
        measured = {suite.cls: block}
        identity = (row["lane"], row["model"], row["effort"])
        arms_out.append({"lane": row["lane"], "model": row["model"], "effort": row["effort"], "measured": measured})
        if identity in catalog_arms:
            measured_by_identity[identity] = measured
        else:
            log(f"priors: {', '.join(row['arms'])} is not in the catalog; not written by --write")
    print(json.dumps({"arms": arms_out}, indent=2))
    if args.write:
        existing = read_optional_json(args.write) if os.path.exists(args.write) else {}
        if not isinstance(existing, dict):
            raise BenchError(f"{args.write} must hold a JSON object")
        write_json(args.write, merge_measured(existing, measured_by_identity))
        log(f"wrote {len(measured_by_identity)} measured arms to {args.write}")
    return 0


# ---------------------------------------------------------------- reviewer panels

def pooled_key(row):
    return "{}|{}|{}".format(row["lane"], row["model"] or "-", row["effort"])


def arm_hit_sets(collected, defect_ids):
    """{arm directory: set of 'item:defect' ids that arm found}, strict matching."""
    arm_hits = {name: set() for name in collected["rows"]}
    for defect in defect_ids:
        for arm, hit in collected["agg"]["per_defect_hit_matrix"][defect].items():
            if hit and arm in arm_hits:
                arm_hits[arm].add(defect)
    return arm_hits


def build_panels(collected, suite_name, max_size=3):
    item_count = len(collected["items"])
    total_defects = sum(len(defects) for defects in collected["items"].values())
    rows = collected["rows"]
    partial = sorted(name for name, row in rows.items() if row["partial"])
    pooled = pool_rows(rows, item_count)
    pooled_by_key = {pooled_key(row): row for row in pooled}
    defect_ids = [f"{item}:{defect['id']}" for item, defects in collected["items"].items() for defect in defects]
    arm_hits = arm_hit_sets(collected, defect_ids)
    complete_pooled = []
    for point in pooled:
        key = pooled_key(point)
        complete_pooled.append({"key": key, "lane": point["lane"], "model": point["model"],
                                "effort": point["effort"], "arms": point["arms"],
                                "replicates": len(point["arms"]), "provider": point["provider"],
                                "unmatched_findings": point["unmatched_findings"],
                                "pct_week_per_item": point["pct_week_per_item"]})
    by_key = {point["key"]: point for point in complete_pooled}
    pricing_providers = collected["pricing"].get("providers", {})
    panels = []
    max_size = max(1, min(int(max_size), 3))
    for size in range(1, max_size + 1):
        for members in itertools.combinations(sorted(by_key), size):
            points = [by_key[key] for key in members]
            replicate_sets = [point["arms"] for point in points]
            recall_values = []
            for replicate_combo in itertools.product(*replicate_sets):
                hits = set().union(*(arm_hits[name] for name in replicate_combo))
                recall_values.append(len(hits) / total_defects if total_defects else None)
            union_recall = mean(recall_values)
            false_alarms = sum(point["unmatched_findings"] / (item_count * point["replicates"])
                               for point in points) if item_count else None
            weekly = {}
            point_costs = []
            for point in points:
                provider = point["provider"]
                share = point["pct_week_per_item"]
                if provider and share is not None:
                    weekly[provider] = weekly.get(provider, 0.0) + share
                scarcity = pricing_providers.get(provider, {}).get("scarcity") if provider else None
                point_costs.append(share * scarcity if share is not None and scarcity is not None else None)
            cost_points = sum(point_costs) if all(value is not None for value in point_costs) else None
            panels.append({"members": list(members), "size": size, "union_recall": union_recall,
                           "false_alarms_per_item": false_alarms,
                           "cost_points_per_item": cost_points,
                           "weekly_share_by_provider": {key: weekly[key] for key in sorted(weekly)}})
    ordered = sorted(panels, key=lambda panel: (panel["cost_points_per_item"] is None,
                      panel["cost_points_per_item"] if panel["cost_points_per_item"] is not None else math.inf,
                      -(panel["union_recall"] if panel["union_recall"] is not None else -1),
                      panel["false_alarms_per_item"] if panel["false_alarms_per_item"] is not None else math.inf,
                      panel["members"]))
    frontier, best_recall = [], -1.0
    for panel in ordered:
        recall, cost = panel["union_recall"], panel["cost_points_per_item"]
        if recall is None or cost is None:
            continue
        # Sorted by cost, so a panel survives only when it improves recall.
        if recall > best_recall:
            frontier.append(panel)
            best_recall = recall
    targets = {}
    for target in (0.95, 0.97, 1.0):
        targets["{:.2f}".format(target)] = {}
        for size in range(1, 4):
            candidates = [panel for panel in panels if panel["size"] == size and
                          panel["union_recall"] is not None and panel["union_recall"] >= target and
                          panel["cost_points_per_item"] is not None]
            candidates.sort(key=lambda panel: (panel["cost_points_per_item"], panel["false_alarms_per_item"],
                                               panel["members"]))
            targets["{:.2f}".format(target)][str(size)] = candidates[0] if candidates else None
    best_partners = []
    singles = {panel["members"][0]: panel for panel in panels if panel["size"] == 1}
    pairs_by_member = {}
    for panel in panels:
        if panel["size"] != 2:
            continue
        for member in panel["members"]:
            pairs_by_member.setdefault(member, []).append(panel)
    for key in sorted(singles):
        single = singles[key]
        candidates = []
        for panel in pairs_by_member.get(key, []):
            partner = next(member for member in panel["members"] if member != key)
            gain = panel["union_recall"] - single["union_recall"]
            candidates.append((gain, panel["cost_points_per_item"], panel["false_alarms_per_item"], partner))
        if candidates:
            candidates.sort(key=lambda value: (-value[0], value[1] if value[1] is not None else math.inf,
                                               value[2] if value[2] is not None else math.inf, value[3]))
            gain, _, _, partner = candidates[0]
            best_partners.append({"arm": key, "partner": partner, "recall_gain": gain})
        else:
            best_partners.append({"arm": key, "partner": None, "recall_gain": 0.0})
    defect_coverage = []
    for defect in defect_ids:
        count = sum(bool(set().union(*(arm_hits[name] for name in by_key[key]["arms"])) & {defect})
                    for key in by_key)
        defect_coverage.append({"defect": defect, "pooled_arms_found": count})
    defect_coverage.sort(key=lambda row: (-row["pooled_arms_found"], row["defect"]))
    result = {"schema_version": 1, "suite": suite_name, "item_count": item_count,
              "total_defects": total_defects, "max_size": max_size, "excluded_partial": partial,
              "pooled_arms": complete_pooled, "panels": panels,
              "frontier": [panel["members"] for panel in frontier],
              "recall_targets": targets, "best_partners": best_partners,
              "defect_coverage": defect_coverage,
              "never_found": [row["defect"] for row in defect_coverage if not row["pooled_arms_found"]]}
    return result


def panels_markdown(report):
    by_members = {tuple(panel["members"]): panel for panel in report["panels"]}
    def member_text(members):
        return ", ".join(member.replace("|", "\\|") for member in members)
    lines = [f"# Suite {report['suite']} reviewer panels", "",
             f"{report['item_count']} items; {report['total_defects']} defects; panels include up to {report['max_size']} pooled arms.", "",
             "Partial arms excluded: " + (", ".join(report["excluded_partial"]) or "none"), "",
             "## Pareto frontier", "",
             "Members are pooled lane/model/effort groups; recall averages all replicate combinations; false alarms are unmatched findings per suite item; cost points are summed %week/item multiplied by provider scarcity; weekly shares are summed %week/item by provider.", "",
             "| Members | Union recall | False alarms/item | Cost points/item | Weekly share by provider |",
             "|---|---:|---:|---:|---|"]
    for members in report["frontier"]:
        panel = by_members[tuple(members)]
        weekly = ", ".join(f"{provider} {fmt(value, 5)}%" for provider, value in panel["weekly_share_by_provider"].items()) or "n/a"
        lines.append("| {} | {} | {} | {} | {} |".format(member_text(members), fmt(panel["union_recall"]),
                     fmt(panel["false_alarms_per_item"]), fmt(panel["cost_points_per_item"], 5), weekly))
    lines += ["", "## Cheapest panels at each recall target", "",
              "Size is the number of distinct pooled arms; cost and false alarms use the same definitions as above.", "",
              "| Target | Size | Members | Union recall | Cost points/item | False alarms/item |",
              "|---:|---:|---|---:|---:|---:|"]
    for target, by_size in report["recall_targets"].items():
        for size in ("1", "2", "3"):
            panel = by_size.get(size)
            lines.append("| {} | {} | {} | {} | {} | {} |".format(target, size,
                member_text(panel["members"]) if panel else "none",
                fmt(panel["union_recall"]) if panel else "n/a",
                fmt(panel["cost_points_per_item"], 5) if panel else "n/a",
                fmt(panel["false_alarms_per_item"]) if panel else "n/a"))
    lines += ["", "## Best partner for each pooled arm", "",
              "Recall gain is pair union recall minus the single arm's replicate-averaged recall.", "",
              "| Single arm | Best partner | Recall gain |", "|---|---|---:|"]
    for row in report["best_partners"]:
        lines.append(f"| {member_text([row['arm']])} | {member_text([row['partner']]) if row['partner'] else 'none'} | {fmt(row['recall_gain'])} |")
    lines += ["", "## Defect coverage", "",
              "Pooled arms found counts groups with at least one replicate that found the defect.", "",
              "| Defect id | Pooled arms found |", "|---|---:|"]
    for row in report["defect_coverage"]:
        lines.append(f"| {row['defect']} | {row['pooled_arms_found']} |")
    lines += ["", "Never found: " + (", ".join(report["never_found"]) or "none"), ""]
    return "\n".join(lines)


def cmd_export(args):
    suite = load_suite(args.suite)
    summary = read_grade_summary(args.summary, args.arm) if args.summary else None
    names = args.arm or (sorted(summary.get("arms", {})) if summary is not None else None)
    collected = collect(suite, args.ledger or ledger_default(), args.arms_json or arms_json_default(),
                        args.codex_home or os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex"), names)
    if summary is not None:
        missing = sorted(set(collected["names"]) - set(summary.get("arms", {})))
        if missing:
            raise BenchError("summary has no such arm: " + ", ".join(missing))
    write_outcomes(suite, collected, args.out, summary)
    print(f"EXPORTED {len(collected['names'])} arms, {len(collected['items'])} items to {args.out}")
    return 0


def cmd_export_findings(args):
    suite = load_suite(args.suite)
    names = args.arm or sorted(read_json(args.summary).get("arms", {}))
    summary = read_grade_summary(args.summary, names)
    items = suite.load_items()
    rows = []
    for arm in sorted(set(names)):
        if arm not in summary.get("arms", {}):
            raise BenchError(f"summary has no such arm: {arm}")
        parsed = parse_arm_name(arm)
        for item, defects in items.items():
            path = Path(suite.runs_root) / arm / item / "findings.jsonl"
            detail = summary["arms"][arm].get("items", {}).get(item)
            if not isinstance(detail, dict):
                raise BenchError(f"summary has no graded row for {arm} {item}")
            strict = detail.get("status") != "format_fail"
            selected = load_findings(path, lenient=not strict)
            matches = score(defects, selected, suite.window)["matched_findings"]
            matched = {entry["finding_index"]: item + ":" + entry["defect_id"] for entry in matches}
            kind = "planted" if defects else "control"
            for fi, finding in enumerate(selected):
                rows.append({"fid": f"{arm}:{item}:{fi}", "arm": arm, "lane": parsed["lane"],
                             "effort": parsed["effort"], "rep": parsed["rep"], "item": item,
                             "kind": kind, "finding_index": fi, "file": finding["file"],
                             "line": finding["line"], "severity": finding.get("severity"),
                             "description": finding.get("description", ""), "matched_defect": matched.get(fi),
                             "strict": strict})
    write_atomic(args.out, "".join(json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n" for row in rows))
    print(f"EXPORTED {len(rows)} findings to {args.out}")
    return 0


RESCORE_EFFORT_ORDER = {"low": 0, "medium": 1, "high": 2, "xhigh": 3, "max": 4, "*": 5}


def jsonl_rows(path):
    rows = []
    for no, line in enumerate(Path(path).read_text(encoding="utf-8").splitlines(), 1):
        if line.strip():
            try:
                rows.append(json.loads(line))
            except ValueError as exc:
                raise ValueError(f"{path}:{no}: invalid JSON: {exc}") from exc
    return rows


def rescore_write_json(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8", newline="\n") as stream:
        json.dump(value, stream, indent=2, sort_keys=True, ensure_ascii=False, allow_nan=False)
        stream.write("\n")


def rescore_write_jsonl(path, rows):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8", newline="\n") as stream:
        for row in rows:
            stream.write(json.dumps(row, sort_keys=True, ensure_ascii=False,
                                    separators=(",", ":"), allow_nan=False) + "\n")


def rescore_log(message):
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    print(f"[{stamp}] {message}", file=sys.stderr, flush=True)


def safe_ratio(numerator, denominator):
    return numerator / denominator if numerator is not None and denominator else None


def rescore_key_for_group(row):
    return (row.get("lane"), row.get("model"), row.get("effort"))


def rescore_fkey(finding):
    index = finding.get("finding_index")
    try:
        index = int(index)
    except (TypeError, ValueError):
        index = 10**12
    matched_rank = 0 if finding.get("matched_defect") is not None else 1
    return (index, matched_rank, str(finding.get("fid", "")))


def pct_text(value, digits=3):
    if value is None:
        return "—"
    return f"{value:.{digits}f}"


def num_text(value, digits=4):
    if value is None:
        return "—"
    return f"{value:.{digits}f}"


def signed(value, digits=3):
    if value is None:
        return "—"
    return f"{value:+.{digits}f}"


def bucket_summary(counts, total):
    return {key: {"count": count, "share": safe_ratio(count, total)}
            for key, count in sorted(counts.items())}


def cmd_rescore(args):
    rescore_log("Starting Suite R extended-key rescore")
    output = Path(args.out_dir)
    output.mkdir(parents=True, exist_ok=True)
    suite = Path(args.suite)
    findings_paths = list(args.findings)
    outcome_paths = list(args.outcomes)
    finding_rows = [row for path in findings_paths for row in jsonl_rows(path)]
    outcome_headers, outcomes = [], []
    for path in outcome_paths:
        rows = jsonl_rows(path)
        header = next((row for row in rows if row.get("type") == "header"), None)
        if not header:
            raise ValueError(f"No header in {path}")
        outcome_headers.append(header)
        outcomes.extend(row for row in rows if row.get("type") == "outcome")
    if not outcome_headers:
        raise ValueError("No outcomes supplied")
    original_header = outcome_headers[0]
    expected_items = sorted(original_header.get("item_defect_ids", {}))
    planted_items = set(original_header.get("planted_items", []))
    control_items = set(original_header.get("control_items", []))
    if len(expected_items) != original_header.get("item_count"):
        raise ValueError("Outcome header item_count disagrees with item_defect_ids")
    total_defects = original_header.get("total_defects")
    if type(total_defects) is not int:
        total_defects = sum(len(original_header["item_defect_ids"][item]) for item in planted_items)
    if sum(len(original_header["item_defect_ids"][item]) for item in planted_items) != total_defects:
        raise ValueError("Outcome header total_defects disagrees with planted items")
    for header in outcome_headers[1:]:
        if sorted(header.get("item_defect_ids", {})) != expected_items or header.get("item_defect_ids") != original_header.get("item_defect_ids"):
            raise ValueError("Outcome headers disagree on item_defect_ids")

    all_arm_names = sorted({arm for header in outcome_headers for arm in header.get("arms", [])})
    outcome_by_key, run_meta = {}, {}
    for row in outcomes:
        arm, item = row.get("arm"), row.get("item")
        if arm not in all_arm_names or item not in expected_items:
            raise ValueError(f"Unexpected outcome arm/item: {arm}/{item}")
        key = (arm, item)
        if key in outcome_by_key:
            raise ValueError(f"Duplicate outcome row for {arm}/{item}")
        outcome_by_key[key] = row
        meta = (row.get("lane"), row.get("model"), row.get("effort"), row.get("rep"))
        if arm in run_meta and run_meta[arm] != meta:
            raise ValueError(f"Inconsistent run metadata for {arm}: {run_meta[arm]} vs {meta}")
        run_meta[arm] = meta
    missing_outcomes = [(arm, item) for arm in all_arm_names for item in expected_items
                        if (arm, item) not in outcome_by_key]
    if missing_outcomes:
        raise ValueError(f"Outcome rows missing for {len(missing_outcomes)} arm/item pairs; first={missing_outcomes[:5]}")
    rescore_log(f"Loaded outcomes: {len(outcomes)} rows; {len(all_arm_names)} arms x {len(expected_items)} items")

    findings_by_key, findings_by_fid = collections.defaultdict(list), {}
    for finding in finding_rows:
        fid = finding.get("fid")
        if not fid or fid in findings_by_fid:
            raise ValueError(f"Missing or duplicate finding fid: {fid!r}")
        if finding.get("arm") not in all_arm_names or finding.get("item") not in expected_items:
            raise ValueError(f"Unexpected finding arm/item for {fid}: {finding.get('arm')}/{finding.get('item')}")
        findings_by_fid[fid] = finding
        findings_by_key[(finding["arm"], finding["item"])].append(finding)

    assignments, issues, audit = {}, {}, {}
    for row in jsonl_rows(args.assignments):
        fid = row.get("fid")
        if not fid or fid in assignments:
            raise ValueError(f"Missing or duplicate assignment fid: {fid!r}")
        assignments[fid] = row.get("issue_id")
    for row in jsonl_rows(args.issues):
        issue_id = row.get("issue_id")
        if not issue_id or issue_id in issues:
            raise ValueError(f"Missing or duplicate issue id: {issue_id!r}")
        issues[issue_id] = row
    for row in jsonl_rows(args.matched_audit):
        fid = row.get("fid")
        if not fid or fid in audit:
            raise ValueError(f"Missing or duplicate matched-audit fid: {fid!r}")
        audit[fid] = row

    missing_audits = [finding["fid"] for finding in finding_rows
                      if finding.get("matched_defect") is not None and finding["fid"] not in audit]
    extra_audits = [fid for fid in audit if fid not in findings_by_fid]
    if missing_audits or extra_audits:
        raise ValueError(f"Matched-audit coverage mismatch: missing={len(missing_audits)}, extra={len(extra_audits)}")
    expected_assignments = []
    for finding in finding_rows:
        fid = finding["fid"]
        if finding.get("matched_defect") is None:
            expected_assignments.append(fid)
        elif audit[fid].get("label") in ("partial", "other_issue"):
            expected_assignments.append(fid)
        elif audit[fid].get("label") != "describes":
            raise ValueError(f"Unknown audit label for {fid}: {audit[fid].get('label')!r}")
        if finding.get("matched_defect") is not None and audit[fid].get("matched_defect") != finding.get("matched_defect"):
            raise ValueError(f"Matched-audit defect mismatch for {fid}")
    missing_assignments = sorted(set(expected_assignments) - set(assignments))
    extra_assignments = sorted(set(assignments) - set(findings_by_fid))
    if missing_assignments or extra_assignments:
        raise ValueError(f"Assignment coverage mismatch: missing={len(missing_assignments)}, extra={len(extra_assignments)}; "
                         f"first missing={missing_assignments[:5]}")
    rescore_log(f"Loaded adjudication: {len(assignments)} assignments, {len(audit)} matched audits, {len(issues)} new issues")

    planted_by_item, planted_ids = collections.defaultdict(list), set()
    for item in expected_items:
        defect_path = suite / "items" / item / "defects.json"
        if not defect_path.exists():
            raise ValueError(f"Missing planted key: {defect_path}")
        payload = json.loads(defect_path.read_text(encoding="utf-8"))
        if isinstance(payload, dict):
            raw_defects = payload.get("defects", [])
        elif isinstance(payload, list):
            raw_defects = payload
        else:
            raise ValueError(f"Unexpected planted key shape in {defect_path}")
        for defect in raw_defects:
            issue_id = f"{item}:{defect['id']}"
            if issue_id in planted_ids:
                raise ValueError(f"Duplicate planted issue {issue_id}")
            canonical = {"id": issue_id, "file": defect["file"], "line": defect["line"],
                         "line_end": defect.get("line_end", defect["line"]), "origin": "planted",
                         "scope": None, "severity": None}
            planted_by_item[item].append(canonical)
            planted_ids.add(issue_id)
    if len(planted_ids) != total_defects:
        raise ValueError(f"Expected {total_defects} planted key entries; found {len(planted_ids)}")

    real_issues_by_item, real_issue_ids = collections.defaultdict(list), set()
    for issue_id, issue in sorted(issues.items()):
        if issue.get("final_verdict") != "real":
            continue
        if issue_id in real_issue_ids:
            raise ValueError(f"Duplicate real issue: {issue_id}")
        item = issue.get("item")
        if item not in expected_items:
            raise ValueError(f"Real issue {issue_id} has unknown item {item}")
        real_issue_ids.add(issue_id)
        real_issues_by_item[item].append({
            "id": issue_id, "file": issue["file"], "line": issue["line"],
            "line_end": issue.get("line_end", issue["line"]), "origin": "unplanted",
            "scope": issue.get("scope"), "severity": issue.get("severity_judged"),
        })
    key_v2_by_item = {}
    key_dir = output / "key-v2"
    for item in expected_items:
        defects = planted_by_item[item] + sorted(real_issues_by_item[item], key=lambda row: row["id"])
        key_v2_by_item[item] = defects
        rescore_write_json(key_dir / f"{item}.json", defects)
    rescore_log(f"Wrote key-v2 for {len(expected_items)} items; {len(planted_ids)} planted + {len(real_issue_ids)} real issues")

    unresolved_assignments, finding_result, per_run_rows = [], {}, []
    location_totals = collections.Counter()
    for arm in all_arm_names:
        for item in expected_items:
            current = findings_by_key.get((arm, item), [])
            ordered = sorted(current, key=rescore_fkey)
            credited, result_counts = set(), collections.Counter()
            tp_planted_ids, tp_real_ids = [], []
            real_scopes, real_severities = collections.Counter(), collections.Counter()
            for finding in ordered:
                fid = finding["fid"]
                matched_defect = finding.get("matched_defect")
                label = audit[fid].get("label") if matched_defect is not None else None
                assigned_id = assignments.get(fid)
                if matched_defect is not None and label == "describes":
                    target_id = matched_defect
                elif matched_defect is not None and label == "partial" and assigned_id == matched_defect:
                    target_id = matched_defect
                else:
                    target_id = assigned_id
                target_kind, classification = None, "false_alarm"
                if target_id is not None and target_id in planted_ids:
                    if target_id in credited:
                        classification = "duplicate"
                    else:
                        classification, target_kind = "tp_planted", "planted"
                        credited.add(target_id)
                        tp_planted_ids.append(target_id)
                elif target_id is not None and target_id in issues:
                    issue = issues[target_id]
                    if issue.get("final_verdict") == "real":
                        if target_id in credited:
                            classification = "duplicate"
                        else:
                            classification, target_kind = "tp_real", "real"
                            credited.add(target_id)
                            tp_real_ids.append(target_id)
                            real_scopes[issue.get("scope") or "unknown"] += 1
                            real_severities[issue.get("severity_judged") or "unknown"] += 1
                elif target_id is None:
                    unresolved_assignments.append({"arm": arm, "item": item, "fid": fid,
                                                   "reason": "finding has no usable assignment"})
                else:
                    unresolved_assignments.append({"arm": arm, "item": item, "fid": fid,
                                                   "reason": f"assignment target {target_id} is absent from keys"})
                if assigned_id is None and not (matched_defect is not None and label == "describes"):
                    unresolved_assignments.append({"arm": arm, "item": item, "fid": fid,
                                                   "reason": "missing assignment for a finding scored through adjudication"})
                result_counts[classification] += 1
                finding_result[fid] = {"class": classification, "issue_id": target_id,
                                        "credited_issue_id": target_id if classification in ("tp_planted", "tp_real") else None,
                                        "origin": target_kind}

            out = outcome_by_key[(arm, item)]
            v1_current = [finding for finding in current if finding.get("strict") is not False]
            planted_found_ids = sorted({finding.get("matched_defect") for finding in v1_current
                                        if finding.get("matched_defect") in planted_ids})
            total_findings = len(current)
            v1_finding_count = len(v1_current)
            v1_matched = sum(finding.get("matched_defect") is not None for finding in v1_current)
            v1_unmatched = v1_finding_count - v1_matched
            planted_total = len(planted_by_item[item])
            real_total = len(real_issues_by_item[item]) if out.get("run_present") and not out.get("skipped") else 0
            false_alarms = result_counts["false_alarm"]
            usable_v2 = (result_counts["tp_planted"] >= 1 and false_alarms <= 2) if item in planted_items else false_alarms <= 1
            per_run_rows.append({
                "arm": arm, "lane": out.get("lane"), "model": out.get("model"), "effort": out.get("effort"),
                "rep": out.get("rep"), "item": item, "kind": out.get("kind"),
                "is_planted_item": item in planted_items, "run_present": bool(out.get("run_present")),
                "status": out.get("status"), "skipped": bool(out.get("skipped")),
                "infra_failure": bool(out.get("infra_failure")),
                "strict_false_findings": sum(finding.get("strict") is False for finding in current),
                "finding_count": total_findings, "v1_finding_count": v1_finding_count,
                "v1_matched_findings": v1_matched, "v1_unmatched_findings": v1_unmatched,
                "v1_planted_found": len(planted_found_ids), "v1_planted_issue_ids": planted_found_ids,
                "tp_planted": result_counts["tp_planted"], "tp_planted_issue_ids": sorted(tp_planted_ids),
                "tp_real": result_counts["tp_real"], "tp_real_issue_ids": sorted(tp_real_ids),
                "duplicate": result_counts["duplicate"], "false_alarm": false_alarms,
                "real_issue_total": real_total, "real_found": len(set(tp_real_ids)),
                "real_issue_ids_ran": sorted(issue["id"] for issue in real_issues_by_item[item]) if real_total else [],
                "recall_planted_v1_item": safe_ratio(len(planted_found_ids), planted_total),
                "precision_v1_item": safe_ratio(v1_matched, v1_finding_count),
                "precision_v2_item": safe_ratio(result_counts["tp_planted"] + result_counts["tp_real"], total_findings),
                "precision_v2_nodup_item": safe_ratio(result_counts["tp_planted"] + result_counts["tp_real"],
                                                       total_findings - result_counts["duplicate"]),
                "recall_real_item": safe_ratio(len(set(tp_real_ids)), real_total),
                "usable_v2": bool(usable_v2),
                "tp_real_scope_counts": dict(sorted(real_scopes.items())),
                "tp_real_severity_counts": dict(sorted(real_severities.items())),
                "cost": out.get("cost"), "cost_unit": out.get("cost_unit"), "pct_week": out.get("pct_week"),
                "tokens": out.get("tokens"),
                "api_usd_per_item": out.get("cost") if out.get("cost_unit") == "list_usd" else None,
                "lane_exit": out.get("lane_exit"), "findings_present": out.get("findings_present"),
            })
    if unresolved_assignments:
        rescore_log(f"ERROR: unresolved assignment targets/coverage: {len(unresolved_assignments)}; first={unresolved_assignments[:5]}")
        raise ValueError("Adjudication contains unresolved assignment targets; no scores written")

    location_finding_to_issue = {}
    for arm in all_arm_names:
        for item in expected_items:
            current = findings_by_key.get((arm, item), [])
            score_findings = [{"fid": finding["fid"], "file": finding["file"], "line": finding["line"]}
                              for finding in current]
            scored = score(key_v2_by_item[item], score_findings, original_header.get("window", 5))
            for pair in scored["matched_findings"]:
                location_finding_to_issue[pair["finding"]["fid"]] = pair["defect_id"]
    for finding in finding_rows:
        fid = finding["fid"]
        location_issue = location_finding_to_issue.get(fid)
        adjudicated_issue = finding_result[fid]["credited_issue_id"]
        loc_positive, adjudicated_positive = location_issue is not None, adjudicated_issue is not None
        location_totals["findings"] += 1
        location_totals["binary_agreement"] += loc_positive == adjudicated_positive
        location_totals["exact_issue_agreement"] += location_issue == adjudicated_issue
        if loc_positive and adjudicated_positive:
            location_totals["both_positive"] += 1
            location_totals["same_issue_when_both_positive"] += location_issue == adjudicated_issue
        elif loc_positive:
            location_totals["location_only_positive"] += 1
        elif adjudicated_positive:
            location_totals["adjudication_only_positive"] += 1
        else:
            location_totals["both_negative"] += 1
    location_summary = {
        "method": "lane-bench score() maximum one-to-one matching, same file, line within defect.line-5..line_end+5",
        "finding_count": location_totals["findings"],
        "location_credited_findings": len(location_finding_to_issue),
        "adjudicated_credited_findings": sum(result["credited_issue_id"] is not None for result in finding_result.values()),
        "binary_label_agreement_count": location_totals["binary_agreement"],
        "binary_label_agreement_rate": safe_ratio(location_totals["binary_agreement"], location_totals["findings"]),
        "exact_credited_issue_agreement_count": location_totals["exact_issue_agreement"],
        "exact_credited_issue_agreement_rate": safe_ratio(location_totals["exact_issue_agreement"], location_totals["findings"]),
        "same_issue_given_both_positive_count": location_totals["same_issue_when_both_positive"],
        "same_issue_given_both_positive_rate": safe_ratio(location_totals["same_issue_when_both_positive"],
                                                           location_totals["both_positive"]),
        "both_positive": location_totals["both_positive"],
        "location_only_positive": location_totals["location_only_positive"],
        "adjudication_only_positive": location_totals["adjudication_only_positive"],
        "both_negative": location_totals["both_negative"],
        "location_issue_by_fid": location_finding_to_issue,
    }
    rescore_log(f"Location comparison: binary agreement {location_summary['binary_label_agreement_count']}/"
                f"{location_summary['finding_count']} ({location_summary['binary_label_agreement_rate']:.6f}); "
                f"exact credited-issue agreement {location_summary['exact_credited_issue_agreement_rate']:.6f}")

    rows_by_arm, rows_by_arm_item = collections.defaultdict(list), {}
    for row in per_run_rows:
        rows_by_arm[row["arm"]].append(row)
        rows_by_arm_item[(row["arm"], row["item"])] = row
    arm_summaries = {}
    for arm in all_arm_names:
        arm_rows = rows_by_arm[arm]
        planted_found = sum(row["v1_planted_found"] for row in arm_rows)
        v1_matched = sum(row["v1_matched_findings"] for row in arm_rows)
        finding_total = sum(row["finding_count"] for row in arm_rows)
        v1_finding_total = sum(row["v1_finding_count"] for row in arm_rows)
        tp_planted = sum(row["tp_planted"] for row in arm_rows)
        tp_real = sum(row["tp_real"] for row in arm_rows)
        duplicate = sum(row["duplicate"] for row in arm_rows)
        false_alarm = sum(row["false_alarm"] for row in arm_rows)
        real_found_ids = {issue_id for row in arm_rows for issue_id in row["tp_real_issue_ids"]}
        real_issue_total = sum(row["real_issue_total"] for row in arm_rows)
        planted_false = sum(row["false_alarm"] for row in arm_rows if row["is_planted_item"])
        control_false = sum(row["false_alarm"] for row in arm_rows if not row["is_planted_item"])
        usable_count = sum(bool(row["usable_v2"]) for row in arm_rows)
        scope_counts, severity_counts = collections.Counter(), collections.Counter()
        for row in arm_rows:
            scope_counts.update(row["tp_real_scope_counts"])
            severity_counts.update(row["tp_real_severity_counts"])
        meta = run_meta[arm]
        cost_values = [row["cost"] for row in arm_rows if row["cost"] is not None]
        pct_values = [row["pct_week"] for row in arm_rows if row["pct_week"] is not None]
        units = sorted({row["cost_unit"] for row in arm_rows if row["cost_unit"]})
        api_usd_values = [row["api_usd_per_item"] for row in arm_rows if row["api_usd_per_item"] is not None]
        usable_rate = safe_ratio(usable_count, len(arm_rows))
        arm_summaries[arm] = {
            "arm": arm, "lane": meta[0], "model": meta[1], "effort": meta[2], "rep": meta[3],
            "items": len(arm_rows), "v1_recall_planted": safe_ratio(planted_found, total_defects),
            "v1_precision": safe_ratio(v1_matched, v1_finding_total),
            "v1_planted_found": planted_found, "v1_matched_findings": v1_matched,
            "v1_finding_count": v1_finding_total, "finding_count": finding_total,
            "v2_tp_planted": tp_planted, "v2_tp_real": tp_real,
            "v2_duplicate": duplicate, "v2_false_alarm": false_alarm,
            "recall_planted_v2": safe_ratio(tp_planted, total_defects),
            "precision_v2": safe_ratio(tp_planted + tp_real, finding_total),
            "precision_v2_nodup": safe_ratio(tp_planted + tp_real, finding_total - duplicate),
            "real_found": len(real_found_ids), "real_found_issue_ids": sorted(real_found_ids),
            "real_issue_total": real_issue_total, "recall_real": safe_ratio(len(real_found_ids), real_issue_total),
            "false_alarm_per_planted_item": safe_ratio(planted_false, len(planted_items)),
            "false_alarm_per_control_item": safe_ratio(control_false, len(control_items)),
            "false_alarm_counts": {"planted": planted_false, "control": control_false},
            "usable_v2": usable_rate, "usable_v2_items": usable_count,
            "real_credit_scope": bucket_summary(scope_counts, tp_real),
            "real_credit_severity": bucket_summary(severity_counts, tp_real),
            "cost_per_item_native": mean(cost_values), "cost_unit": units[0] if len(units) == 1 else units,
            "pct_week_per_item": mean(pct_values), "api_usd_per_item": mean(api_usd_values),
            "pct_week_per_usable_item": safe_ratio(mean(pct_values), usable_rate),
            "api_usd_per_usable_item": safe_ratio(mean(api_usd_values), usable_rate),
            "api_usd_source": "outcome cost rows (list_usd)" if api_usd_values else None,
            "run_status_counts": dict(sorted(collections.Counter(row["status"] for row in arm_rows).items())),
            "strict_false_findings": sum(row["strict_false_findings"] for row in arm_rows),
        }

    v1_summary = None
    legacy_rows, legacy_by_group = [], {}
    if args.by_arm:
        by_arm_doc = read_json(args.by_arm)
        legacy_rows = [row for row in by_arm_doc.get("rows", []) if row.get("arms")]
        legacy_arm_owners = collections.Counter(name for row in legacy_rows for name in row["arms"])
        legacy_source_arms = set(original_header.get("arms", []))
        missing_legacy_arms = sorted(legacy_source_arms - set(legacy_arm_owners))
        repeated_legacy_arms = sorted(name for name, count in legacy_arm_owners.items() if count != 1)
        v1_checks = []
        for legacy in legacy_rows:
            names = legacy["arms"]
            absent = [name for name in names if name not in arm_summaries]
            if absent:
                raise BenchError(f"v1 reproduction mismatch for arm {absent[0]} metric coverage")
            relevant = [arm_summaries[name] for name in names]
            found = sum(row["v1_planted_found"] for row in relevant)
            finding_count = sum(row["v1_finding_count"] for row in relevant)
            matched_count = sum(row["v1_matched_findings"] for row in relevant)
            recall = safe_ratio(found, total_defects * len(names))
            precision = safe_ratio(matched_count, finding_count)
            for metric, actual, expected in (("recall", recall, legacy.get("recall")),
                                             ("precision", precision, legacy.get("precision"))):
                diff = abs(actual - expected) if actual is not None and expected is not None else (0.0 if actual is expected else float("inf"))
                check = {"lane": legacy.get("lane"), "model": legacy.get("model"),
                         "effort": legacy.get("effort"), "arms": names, "metric": metric,
                         "recomputed": actual, "by_arm": expected, "absolute_difference": diff,
                         "passed": diff <= 1e-9}
                v1_checks.append(check)
                if not check["passed"]:
                    raise BenchError(f"v1 reproduction mismatch for arm {','.join(names)} metric {metric}: "
                                     f"recomputed={actual!r}, by-arm={expected!r}, |delta|={diff!r}")
        v1_failures = [check for check in v1_checks if not check["passed"]]
        v1_summary = {
            "by_arm_file": str(args.by_arm), "grouped_rows_checked": len(legacy_rows),
            "metric_checks": len(v1_checks), "arm_coverage": len(legacy_arm_owners),
            "missing_arms": missing_legacy_arms, "duplicate_arms": repeated_legacy_arms,
            "passed": not v1_failures and not missing_legacy_arms and not repeated_legacy_arms,
            "max_absolute_difference_recall": max((check["absolute_difference"] for check in v1_checks if check["metric"] == "recall"), default=0),
            "max_absolute_difference_precision": max((check["absolute_difference"] for check in v1_checks if check["metric"] == "precision"), default=0),
            "checks": v1_checks,
        }
        if missing_legacy_arms or repeated_legacy_arms:
            arm = (missing_legacy_arms or repeated_legacy_arms)[0]
            raise BenchError(f"v1 reproduction mismatch for arm {arm} metric coverage")
        rescore_log(f"v1 reproduction: {len(legacy_rows)} grouped rows / {len(v1_checks)} metric checks; "
                    f"max |delta| recall={v1_summary['max_absolute_difference_recall']:.3g}, "
                    f"precision={v1_summary['max_absolute_difference_precision']:.3g}; passed=True")
        legacy_by_group = {rescore_key_for_group(row): row for row in legacy_rows}

    groups = collections.defaultdict(list)
    for arm in all_arm_names:
        row = arm_summaries[arm]
        groups[(row["lane"], row["model"], row["effort"])].append(arm)
    for group_key, names in groups.items():
        legacy = legacy_by_group.get(group_key)
        if not legacy or legacy.get("api_usd_per_item") is None or not legacy.get("cost_per_item"):
            continue
        usd_per_native = legacy["api_usd_per_item"] / legacy["cost_per_item"]
        for name in names:
            summary = arm_summaries[name]
            if summary["api_usd_per_item"] is None and summary["cost_per_item_native"] is not None:
                summary["api_usd_per_item"] = summary["cost_per_item_native"] * usd_per_native
                summary["api_usd_per_usable_item"] = safe_ratio(summary["api_usd_per_item"], summary["usable_v2"])
                summary["api_usd_source"] = "by-arm.json USD/native-cost ratio applied to this run"

    pooled_summaries = []
    for group_key in sorted(groups, key=lambda group: tuple(str(value or "") for value in group)):
        names = sorted(groups[group_key], key=lambda name: (run_meta[name][3], name))
        members = [arm_summaries[name] for name in names]
        group_rows = [rows_by_arm_item[(name, item)] for name in names for item in expected_items]
        finding_total = sum(row["finding_count"] for row in group_rows)
        v1_finding_total = sum(row["v1_finding_count"] for row in group_rows)
        v1_matched = sum(row["v1_matched_findings"] for row in group_rows)
        v1_found = sum(row["v1_planted_found"] for row in group_rows)
        tp_planted = sum(row["tp_planted"] for row in group_rows)
        tp_real = sum(row["tp_real"] for row in group_rows)
        duplicate = sum(row["duplicate"] for row in group_rows)
        false_alarm = sum(row["false_alarm"] for row in group_rows)
        real_found_total = sum(member["real_found"] for member in members)
        real_issue_total = sum(member["real_issue_total"] for member in members)
        planted_false = sum(member["false_alarm_counts"]["planted"] for member in members)
        control_false = sum(member["false_alarm_counts"]["control"] for member in members)
        usable_count = sum(member["usable_v2_items"] for member in members)
        item_trials = len(expected_items) * len(names)
        usable_rate = safe_ratio(usable_count, item_trials)
        pct_week = mean([row["pct_week"] for row in group_rows])
        native_cost = mean([row["cost"] for row in group_rows])
        units = sorted({row["cost_unit"] for row in group_rows if row["cost_unit"]})
        legacy = legacy_by_group.get(group_key)
        legacy_names = set(legacy.get("arms", [])) if legacy else set()
        new_names = [name for name in names if name not in legacy_names]
        legacy_api = legacy.get("api_usd_per_item") if legacy else None
        api_values_for_new = []
        for name in new_names:
            values = [row["cost"] for row in rows_by_arm[name]
                      if row["cost_unit"] == "list_usd" and row["cost"] is not None]
            api_values_for_new.append(mean(values))
        if legacy_api is not None:
            api_usd = safe_ratio(legacy_api * len(legacy_names) + sum(value for value in api_values_for_new if value is not None),
                                 len(legacy_names) + sum(value is not None for value in api_values_for_new))
        elif all(api_values_for_new):
            api_usd = mean(api_values_for_new)
        else:
            api_usd = mean([row["cost"] for row in group_rows
                            if row["cost_unit"] == "list_usd" and row["cost"] is not None])
        scope_counts, severity_counts = collections.Counter(), collections.Counter()
        for member in members:
            for key, value in member["real_credit_scope"].items():
                scope_counts[key] += value["count"]
            for key, value in member["real_credit_severity"].items():
                severity_counts[key] += value["count"]
        item_contrib = {}
        for item in expected_items:
            selected = [rows_by_arm_item[(name, item)] for name in names]
            item_contrib[item] = {
                "v1_planted_found": sum(row["v1_planted_found"] for row in selected),
                "tp_planted": sum(row["tp_planted"] for row in selected),
                "v1_matched_findings": sum(row["v1_matched_findings"] for row in selected),
                "v1_finding_count": sum(row["v1_finding_count"] for row in selected),
                "tp_real": sum(row["tp_real"] for row in selected),
                "finding_count": sum(row["finding_count"] for row in selected),
                "planted_denominator": len(planted_by_item[item]) * len(names),
            }
        rng = random.Random(args.seed)
        bootstrap_recall_values, bootstrap_precision_values = [], []
        for _ in range(args.resamples):
            sampled = [item_contrib[expected_items[rng.randrange(len(expected_items))]]
                       for _ in range(len(expected_items))]
            rec_num = sum(value["tp_planted"] for value in sampled)
            rec_den = sum(value["planted_denominator"] for value in sampled)
            precision_num = sum(value["tp_planted"] + value["tp_real"] for value in sampled)
            precision_den = sum(value["finding_count"] for value in sampled)
            rec, prec = safe_ratio(rec_num, rec_den), safe_ratio(precision_num, precision_den)
            if rec is not None:
                bootstrap_recall_values.append(rec)
            if prec is not None:
                bootstrap_precision_values.append(prec)
        replicate_recall_values = [member["recall_planted_v2"] for member in members]
        replicate_precision_values = [member["precision_v2"] for member in members]
        precision_item_delta, precision_denominator_delta, recall_item_delta = {}, {}, {}
        for item, values in item_contrib.items():
            pd = values["tp_planted"] + values["tp_real"] - values["v1_matched_findings"]
            fd = values["finding_count"] - values["v1_finding_count"]
            rd = values["tp_planted"] - values["v1_planted_found"]
            if pd:
                precision_item_delta[item] = pd
            if fd:
                precision_denominator_delta[item] = fd
            if rd:
                recall_item_delta[item] = rd
        pooled_summaries.append({
            "lane": group_key[0], "model": group_key[1], "effort": group_key[2],
            "group_id": "|".join(str(value or "") for value in group_key), "arms": names,
            "rep_count": len(names), "rep_numbers": [run_meta[name][3] for name in names],
            "item_trials": item_trials, "finding_count": finding_total,
            "v1_planted_found": v1_found,
            "v1_recall_planted": safe_ratio(v1_found, total_defects * len(names)),
            "v1_matched_findings": v1_matched, "v1_finding_count": v1_finding_total,
            "v1_precision": safe_ratio(v1_matched, v1_finding_total),
            "tp_planted": tp_planted, "tp_real": tp_real, "duplicate": duplicate, "false_alarm": false_alarm,
            "recall_planted_v2": safe_ratio(tp_planted, total_defects * len(names)),
            "precision_v2": safe_ratio(tp_planted + tp_real, finding_total),
            "precision_v2_nodup": safe_ratio(tp_planted + tp_real, finding_total - duplicate),
            "real_found": safe_ratio(real_found_total, len(names)), "real_found_total": real_found_total,
            "real_issue_total": real_issue_total, "recall_real": safe_ratio(tp_real, real_issue_total),
            "false_alarm_per_planted_item": safe_ratio(planted_false, len(planted_items) * len(names)),
            "false_alarm_per_control_item": safe_ratio(control_false, len(control_items) * len(names)),
            "false_alarm_counts": {"planted": planted_false, "control": control_false},
            "usable_v2": usable_rate, "usable_v2_items": usable_count,
            "real_credit_scope": bucket_summary(scope_counts, tp_real),
            "real_credit_severity": bucket_summary(severity_counts, tp_real),
            "pct_week_per_item": pct_week, "pct_week_per_usable_item": safe_ratio(pct_week, usable_rate),
            "api_usd_per_item": api_usd, "api_usd_per_usable_item": safe_ratio(api_usd, usable_rate),
            "cost_per_item_native": native_cost, "cost_unit": units[0] if len(units) == 1 else units,
            "api_usd_source": "by-arm.json pooled value plus replicate list_usd rows" if legacy_api is not None
                              else "outcome list_usd rows",
            "bootstrap": {
                "resamples": args.resamples, "seed": args.seed,
                "recall_planted_v2_95": [percentile(bootstrap_recall_values, 0.025),
                                          percentile(bootstrap_recall_values, 0.975)],
                "precision_v2_95": [percentile(bootstrap_precision_values, 0.025),
                                     percentile(bootstrap_precision_values, 0.975)],
            },
            "replicate_range": {
                "recall_planted_v2": [min(replicate_recall_values), max(replicate_recall_values)],
                "precision_v2": [min(replicate_precision_values), max(replicate_precision_values)],
            },
            "item_deltas": {"precision_credit_delta": precision_item_delta,
                            "precision_denominator_delta": precision_denominator_delta,
                            "recall_planted_delta": recall_item_delta},
            "v2_over_v1_delta": {
                "recall_planted": safe_ratio(tp_planted, total_defects * len(names)) - safe_ratio(v1_found, total_defects * len(names)),
                "precision": safe_ratio(tp_planted + tp_real, finding_total) - safe_ratio(v1_matched, v1_finding_total)
                             if finding_total and v1_finding_total else None,
            },
        })
    pooled_arms = [name for row in pooled_summaries for name in row["arms"]]
    if sorted(pooled_arms) != sorted(all_arm_names):
        raise ValueError("Pooled arms do not cover each run exactly once")

    thresholds = {
        "a_recall_0_90": lambda row: row["recall_planted_v2"] is not None and row["recall_planted_v2"] >= 0.90,
        "b_recall_0_90_precision_0_85": lambda row: row["recall_planted_v2"] is not None and row["recall_planted_v2"] >= 0.90
                                           and row["precision_v2"] is not None and row["precision_v2"] >= 0.85,
        "c_recall_precision_usable": lambda row: row["recall_planted_v2"] is not None and row["recall_planted_v2"] >= 0.90
                                              and row["precision_v2"] is not None and row["precision_v2"] >= 0.85
                                              and row["usable_v2"] is not None and row["usable_v2"] >= 0.90,
        "d_bootstrap_lower_bound": lambda row: row["bootstrap"]["recall_planted_v2_95"][0] is not None
                                             and row["bootstrap"]["recall_planted_v2_95"][0] >= 0.90
                                             and row["bootstrap"]["precision_v2_95"][0] is not None
                                             and row["bootstrap"]["precision_v2_95"][0] >= 0.85
                                             and row["usable_v2"] is not None and row["usable_v2"] >= 0.90,
    }
    bar_results = {}
    for bar, predicate in thresholds.items():
        qualified = [row for row in pooled_summaries if predicate(row)]
        by_pct = sorted((row for row in qualified if row["pct_week_per_usable_item"] is not None),
                        key=lambda row: (row["pct_week_per_usable_item"], row["group_id"]))
        by_usd = sorted((row for row in qualified if row["api_usd_per_usable_item"] is not None),
                        key=lambda row: (row["api_usd_per_usable_item"], row["group_id"]))
        bar_results[bar] = {
            "qualified_group_ids": [row["group_id"] for row in qualified], "qualified_count": len(qualified),
            "cheapest_pct_week_per_usable": by_pct[0]["group_id"] if by_pct else None,
            "cheapest_pct_week_value": by_pct[0]["pct_week_per_usable_item"] if by_pct else None,
            "cheapest_api_usd_per_usable": by_usd[0]["group_id"] if by_usd else None,
            "cheapest_api_usd_value": by_usd[0]["api_usd_per_usable_item"] if by_usd else None,
            "single_run_qualified": [row["group_id"] for row in qualified if row["rep_count"] == 1],
            "single_run_winners": sorted({row["group_id"] for row in by_pct[:1] + by_usd[:1] if row["rep_count"] == 1}),
        }
    model_groups = collections.defaultdict(list)
    for row in pooled_summaries:
        model_groups[(row["lane"], row["model"])].append(row)
    effort_trends = []
    for (lane, model), model_rows in sorted(model_groups.items()):
        model_rows.sort(key=lambda row: (RESCORE_EFFORT_ORDER.get(row["effort"], 99), str(row["effort"])))
        def monotone(metric):
            values = [row[metric] for row in model_rows if row[metric] is not None]
            return len(values) > 1 and all(b <= a for a, b in zip(values, values[1:]))
        def endpoint_falls(metric):
            values = [row[metric] for row in model_rows if row[metric] is not None]
            return len(values) > 1 and values[-1] < values[0]
        effort_trends.append({
            "lane": lane, "model": model,
            "efforts": [{"effort": row["effort"], "v1_recall": row["v1_recall_planted"],
                         "v2_recall": row["recall_planted_v2"], "v1_precision": row["v1_precision"],
                         "v2_precision": row["precision_v2"], "usable_v2": row["usable_v2"],
                         "rep_count": row["rep_count"]} for row in model_rows],
            "v1_precision_nonincreasing": monotone("v1_precision"),
            "v2_precision_nonincreasing": monotone("precision_v2"),
            "v1_precision_endpoint_falls": endpoint_falls("v1_precision"),
            "v2_precision_endpoint_falls": endpoint_falls("precision_v2"),
        })

    report_object = {
        "schema_version": 1, "suite": original_header.get("suite"),
        "sources": {"suite": args.suite, "outcomes": outcome_paths, "findings": findings_paths,
                    "assignments": args.assignments, "issues": args.issues,
                    "matched_audit": args.matched_audit, "planted_key_dir": str(suite / "items"),
                    "by_arm_v1": args.by_arm},
        "denominators": {"planted_defects_per_run": total_defects, "planted_items": len(planted_items),
                         "control_items": len(control_items), "real_recall_excludes_items_without_run_present_or_skipped": True},
        "v1_reproduction": v1_summary, "location_vs_adjudicated": location_summary,
        "unresolved": {"count": len(unresolved_assignments), "items": unresolved_assignments},
        "single_runs": [arm_summaries[arm] for arm in all_arm_names],
        "pooled_arms": pooled_summaries, "cheapest_bars": bar_results, "effort_trends": effort_trends,
    }
    rescore_write_jsonl(output / "per-run.jsonl", per_run_rows)
    rescore_write_json(output / "by-arm-v2.json", report_object)
    rescore_log(f"Wrote per-run.jsonl ({len(per_run_rows)} rows) and by-arm-v2.json")

    md = ["# Suite R rescore: per-arm results", "",
          "Rates are proportions. `v1` is the original planted-key score; `v2` uses the adjudicated extended key. "
          "Cost columns are provider weekly-window share and API list USD per item, with per-usable-item costs shown too.", "",
          "## Pooled lane × model × effort arms", "",
          "| Lane | Model | Effort | Runs | v1 recall | v2 recall | v1 precision | v2 precision | v2 P no dup | Real found / run | Real recall | FA / planted item | FA / control item | Usable v2 | 95% CI recall | 95% CI precision | Repl. range recall | Repl. range precision | % week / item | % week / usable | API $ / item | API $ / usable |",
          "|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|"]
    for row in pooled_summaries:
        rc, pc = row["bootstrap"]["recall_planted_v2_95"], row["bootstrap"]["precision_v2_95"]
        rr, pr = row["replicate_range"]["recall_planted_v2"], row["replicate_range"]["precision_v2"]
        md.append("| {lane} | {model} | {effort} | {runs} | {v1r} | {v2r} | {v1p} | {v2p} | {pnd} | {rf} | {rrate} | {fap} | {fac} | {use} | [{rlo}, {rhi}] | [{plo}, {phi}] | [{rrlo}, {rrhi}] | [{prlo}, {prhi}] | {pct} | {pctu} | {usd} | {usdu} |".format(
            lane=row["lane"], model=row["model"], effort=row["effort"], runs=row["rep_count"],
            v1r=pct_text(row["v1_recall_planted"]), v2r=pct_text(row["recall_planted_v2"]),
            v1p=pct_text(row["v1_precision"]), v2p=pct_text(row["precision_v2"]), pnd=pct_text(row["precision_v2_nodup"]),
            rf=num_text(row["real_found"], 2), rrate=pct_text(row["recall_real"]),
            fap=num_text(row["false_alarm_per_planted_item"], 3), fac=num_text(row["false_alarm_per_control_item"], 3),
            use=pct_text(row["usable_v2"]), rlo=pct_text(rc[0]), rhi=pct_text(rc[1]),
            plo=pct_text(pc[0]), phi=pct_text(pc[1]), rrlo=pct_text(rr[0]), rrhi=pct_text(rr[1]),
            prlo=pct_text(pr[0]), prhi=pct_text(pr[1]), pct=num_text(row["pct_week_per_item"], 5),
            pctu=num_text(row["pct_week_per_usable_item"], 5), usd=num_text(row["api_usd_per_item"], 4),
            usdu=num_text(row["api_usd_per_usable_item"], 4)))
    md += ["", "## Individual run arms", "",
           "| Run arm | Lane | Model | Effort | Rep | v1 recall | v2 recall | v1 precision | v2 precision | v2 P no dup | Real found | Real recall | FA / planted item | FA / control item | Usable v2 | % week / item | % week / usable | API $ / item | API $ / usable | Native cost / item | Unit |",
           "|---|---|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|"]
    for arm in all_arm_names:
        row = arm_summaries[arm]
        md.append("| {arm} | {lane} | {model} | {effort} | {rep} | {v1r} | {v2r} | {v1p} | {v2p} | {pnd} | {real} | {rr} | {fap} | {fac} | {use} | {pct} | {pctu} | {usd} | {usdu} | {native} | {unit} |".format(
            arm=arm, lane=row["lane"], model=row["model"], effort=row["effort"], rep=row["rep"],
            v1r=pct_text(row["v1_recall_planted"]), v2r=pct_text(row["recall_planted_v2"]),
            v1p=pct_text(row["v1_precision"]), v2p=pct_text(row["precision_v2"]), pnd=pct_text(row["precision_v2_nodup"]),
            real=row["real_found"], rr=pct_text(row["recall_real"]),
            fap=num_text(row["false_alarm_per_planted_item"], 3), fac=num_text(row["false_alarm_per_control_item"], 3),
            use=pct_text(row["usable_v2"]), pct=num_text(row["pct_week_per_item"], 5),
            pctu=num_text(row["pct_week_per_usable_item"], 5), usd=num_text(row["api_usd_per_item"], 4),
            usdu=num_text(row["api_usd_per_usable_item"], 4), native=num_text(row["cost_per_item_native"], 4),
            unit=row["cost_unit"] if isinstance(row["cost_unit"], str) else ",".join(row["cost_unit"] or [])))
    md += ["", "## Share of real credits by scope and severity", "",
           "Shares are over credited real-issue occurrences; replicate credits count once per run.", "",
           "| Lane | Model | Effort | Real credits | Scope shares | Severity shares |", "|---|---|---:|---:|---|---|"]
    for row in pooled_summaries:
        scopes = ", ".join(f"{key}: {value['count']} ({pct_text(value['share'])})"
                            for key, value in row["real_credit_scope"].items()) or "—"
        severities = ", ".join(f"{key}: {value['count']} ({pct_text(value['share'])})"
                                for key, value in row["real_credit_severity"].items()) or "—"
        md.append(f"| {row['lane']} | {row['model']} | {row['effort']} | {row['tp_real']} | {scopes} | {severities} |")
    md += ["", f"Bootstrap intervals use {args.resamples:,} item resamples with seed {args.seed}. Replicate ranges show min–max across runs; "
           "singleton ranges are one observed run.", ""]
    write_atomic(str(output / "by-arm-v2.md"), "\n".join(md))

    bar_labels = {
        "a_recall_0_90": "(a) recall_planted_v2 ≥ 0.90",
        "b_recall_0_90_precision_0_85": "(b) (a) and precision_v2 ≥ 0.85",
        "c_recall_precision_usable": "(c) (b) and usable_v2 ≥ 0.90",
        "d_bootstrap_lower_bound": "(d) 95% bootstrap lower bounds clear 0.90 recall and 0.85 precision, with usable_v2 ≥ 0.90",
    }
    c_md = ["# Cheapest Suite R arms that succeed", "",
            "Candidates are pooled lane × model × effort groups; singleton groups represent one run. Cost efficiency is "
            "weekly-window share or API list USD per usable item.", ""]
    for bar, title in bar_labels.items():
        result = bar_results[bar]
        candidates = [row for row in pooled_summaries if row["group_id"] in result["qualified_group_ids"]]
        candidates.sort(key=lambda row: (row["lane"], row["model"], RESCORE_EFFORT_ORDER.get(row["effort"], 99)))
        c_md += [f"## {title}", "", f"Clearing arms: {result['qualified_count']}.", "",
                 "| Lane | Model | Effort | Runs | Recall v2 | Precision v2 | Usable v2 | Recall CI low | Precision CI low | % week / usable | API $ / usable |",
                 "|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|"]
        for row in candidates:
            c_md.append(f"| {row['lane']} | {row['model']} | {row['effort']} | {row['rep_count']} | {pct_text(row['recall_planted_v2'])} | "
                        f"{pct_text(row['precision_v2'])} | {pct_text(row['usable_v2'])} | "
                        f"{pct_text(row['bootstrap']['recall_planted_v2_95'][0])} | "
                        f"{pct_text(row['bootstrap']['precision_v2_95'][0])} | "
                        f"{num_text(row['pct_week_per_usable_item'], 5)} | {num_text(row['api_usd_per_usable_item'], 4)} |")
        winner_pct, winner_usd = result["cheapest_pct_week_per_usable"], result["cheapest_api_usd_per_usable"]
        c_md += ["", f"Cheapest by weekly window: **{winner_pct or 'none'}** "
                 f"({num_text(result['cheapest_pct_week_value'], 6)}% per usable item).",
                 f"Cheapest by API list USD: **{winner_usd or 'none'}** "
                 f"(${num_text(result['cheapest_api_usd_value'], 4)} per usable item)."]
        one_run = result["single_run_qualified"]
        c_md.append("Qualified standings based on one run: " + (", ".join(one_run) if one_run else "none") + ".")
        c_md.append("")
    c_md += ["## One-run caveat", "",
             "Every qualifying group with `Runs = 1` has a point estimate and bootstrap interval from a single execution. "
             "The `Runs` column identifies those candidates; the cheapest winners are listed above.", ""]
    write_atomic(str(output / "cheapest.md"), "\n".join(c_md))

    header = dict(original_header, arms=all_arm_names)
    outcomes_v2 = [header]
    scored_by_key = {(row["arm"], row["item"]): row for row in per_run_rows}
    added_fields = ("finding_count", "tp_planted", "tp_real", "duplicate", "false_alarm", "usable_v2", "real_found")
    for row in outcomes:
        scored = scored_by_key[(row["arm"], row["item"])]
        outcomes_v2.append({**row, **{key: scored[key] for key in added_fields}})
    rescore_write_jsonl(output / "outcomes-v2.jsonl", outcomes_v2)
    rescore_log(f"Complete: {len(per_run_rows)} per-run rows, {len(pooled_summaries)} pooled groups, "
                f"{len(real_issue_ids)} real issues, {len(finding_rows)} findings")
    return 0


def cmd_panels(args):
    if args.outcomes:
        header, _ = read_outcomes(args.outcomes)
        suite = outcomes_suite(header, args.outcomes)
        collected = collected_from_outcomes(args.outcomes, args.arms_json or arms_json_default(), args.arm)
    else:
        suite = load_suite(args.suite)
        collected = collect(suite, args.ledger or ledger_default(), args.arms_json or arms_json_default(),
                            args.codex_home or os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex"), args.arm)
    report = build_panels(collected, suite.name, args.max_size)
    output = args.results_dir or suite.results_root
    write_json(os.path.join(output, "panels.json"), report)
    write_atomic(os.path.join(output, "panels.md"), panels_markdown(report))
    print(f"PANELS {len(report['panels'])} panels across {len(report['pooled_arms'])} complete pooled arms")
    print(f"WROTE {os.path.join(output, 'panels.json')}")
    print(f"WROTE {os.path.join(output, 'panels.md')}")
    return 0


# ---------------------------------------------------------------- replicate spread and hold-out

def sample_sd(values):
    if len(values) < 2:
        return None
    centre = sum(values) / len(values)
    return math.sqrt(sum((value - centre) ** 2 for value in values) / (len(values) - 1))


def hit_set_overlap(hit_sets):
    """(found by every run, found by any run, their ratio) for one pooled arm's per-run hit sets."""
    every, any_run = set.intersection(*hit_sets), set().union(*hit_sets)
    return len(every), len(any_run), len(every) / len(any_run) if any_run else None


def build_spread(collected, panel_report, arm_hits):
    """Run-to-run spread for every pooled arm with at least two complete reps."""
    item_count = len(collected["items"])
    total = panel_report["total_defects"]
    panels = {tuple(panel["members"]): panel for panel in panel_report["panels"]}
    partners = {row["arm"]: row for row in panel_report["best_partners"]}
    spread = []
    for point in pool_rows(collected["rows"], item_count):
        if len(point["arms"]) < 2:
            continue
        key = pooled_key(point)
        hit_sets = [arm_hits[name] for name in point["arms"]]
        recalls = [len(hits) / total for hits in hit_sets]
        found_every, found_any, stable_share = hit_set_overlap(hit_sets)
        mean_recall = mean(recalls)
        self_pair = mean([len(first | second) / total for first, second in itertools.combinations(hit_sets, 2)])
        partner = partners.get(key, {}).get("partner")
        best = None
        if partner:
            best = {"partner": partner, "pair_recall": panels[tuple(sorted((key, partner)))]["union_recall"],
                    "pair_gain": partners[key]["recall_gain"]}
        spread.append({
            "key": key, "lane": point["lane"], "model": point["model"], "effort": point["effort"],
            "reps": point["rep_numbers"], "recall_by_rep": recalls,
            "mean_recall": mean_recall, "sd_recall": sample_sd(recalls),
            "min_recall": min(recalls), "max_recall": max(recalls),
            "false_alarms_per_item": point["unmatched_findings"] / (item_count * len(point["arms"])),
            "found_by_every_rep": found_every, "found_by_any_rep": found_any,
            "stable_share": stable_share,
            "self_pair_recall": self_pair, "self_pair_gain": self_pair - mean_recall,
            "best_partner": best,
            "self_gain_minus_partner_gain": self_pair - mean_recall - best["pair_gain"] if best else None})
    return spread


def select_holdout_panels(train):
    """The training build's frontier panels and its cheapest panel per target and size, with the roles each plays."""
    selected = {}
    for members in train["frontier"]:
        selected.setdefault(tuple(members), []).append("frontier")
    for target, by_size in train["recall_targets"].items():
        for size, panel in by_size.items():
            if panel:
                selected.setdefault(tuple(panel["members"]), []).append(f"target {target} size {size}")
    return selected


def build_holdout(collected, suite_name, max_rep):
    """Pick panels on reps <= max_rep, then re-score them on reps > max_rep where a member has any."""
    rows = collected["rows"]
    train_rows = {name: row for name, row in rows.items() if row["rep"] <= max_rep}
    held_rows = {}
    for name, row in rows.items():
        if row["rep"] > max_rep and not row["partial"]:
            held_rows.setdefault(pooled_key(row), {})[name] = row
    # A member with held-out reps is scored on those alone; every other member keeps its training reps.
    eval_rows = {name: row for name, row in train_rows.items() if pooled_key(row) not in held_rows}
    for held in held_rows.values():
        eval_rows.update(held)
    train = build_panels(dict(collected, rows=train_rows), suite_name)
    evaluation = build_panels(dict(collected, rows=eval_rows), suite_name)
    train_by_members = {tuple(panel["members"]): panel for panel in train["panels"]}
    eval_by_members = {tuple(panel["members"]): panel for panel in evaluation["panels"]}
    reps_used = {}
    for name, row in eval_rows.items():
        if not row["partial"]:
            reps_used.setdefault(pooled_key(row), []).append(row["rep"])

    def scored(members):
        inside, outside = train_by_members[members], eval_by_members[members]
        details = [{"key": key, "heldout": key in held_rows, "reps_used": sorted(reps_used[key])} for key in members]
        return {"members": list(members), "size": len(members), "member_detail": details,
                "has_heldout_member": any(detail["heldout"] for detail in details),
                "in_sample_recall": inside["union_recall"], "heldout_recall": outside["union_recall"],
                "difference": outside["union_recall"] - inside["union_recall"],
                "in_sample_false_alarms_per_item": inside["false_alarms_per_item"],
                "heldout_false_alarms_per_item": outside["false_alarms_per_item"],
                "cost_points_per_item": inside["cost_points_per_item"]}

    panels = []
    for members, roles in select_holdout_panels(train).items():
        panels.append(dict(scored(members), roles=roles))
    targets = {}
    for target, by_size in train["recall_targets"].items():
        level = float(target)
        entries = {}
        for size, panel in by_size.items():
            if panel is None:
                entries[size] = None
                continue
            row = scored(tuple(panel["members"]))
            entries[size] = {key: row[key] for key in ("members", "has_heldout_member", "in_sample_recall",
                                                       "heldout_recall", "cost_points_per_item",
                                                       "in_sample_false_alarms_per_item")}
            entries[size]["meets_in_sample"] = row["in_sample_recall"] >= level
            entries[size]["meets_heldout"] = row["heldout_recall"] >= level
        present = [entry for entry in entries.values() if entry]
        present.sort(key=lambda entry: (entry["cost_points_per_item"], entry["in_sample_false_alarms_per_item"],
                                        entry["members"]))
        targets[target] = {"by_size": entries, "pick": present[0] if present else None}
    differences = [panel["difference"] for panel in panels if panel["has_heldout_member"]]
    return {"max_rep": max_rep,
            "training_reps": sorted({row["rep"] for row in train_rows.values() if not row["partial"]}),
            "heldout_reps": sorted({row["rep"] for held in held_rows.values() for row in held.values()}),
            "heldout_pooled_arms": sorted(held_rows),
            "panels": panels, "targets": targets,
            "panels_with_heldout_member": len(differences),
            "mean_difference": mean(differences)}


def build_replicates(collected, suite_name, max_rep):
    total_defects = sum(len(defects) for defects in collected["items"].values())
    if not total_defects:
        raise BenchError("suite has no planted defects")
    panel_report = build_panels(collected, suite_name)
    defect_ids = [f"{item}:{defect['id']}" for item, defects in collected["items"].items() for defect in defects]
    return {"schema_version": 1, "suite": suite_name, "item_count": len(collected["items"]),
            "total_defects": total_defects, "excluded_partial": panel_report["excluded_partial"],
            "spread": build_spread(collected, panel_report, arm_hit_sets(collected, defect_ids)),
            "holdout": build_holdout(collected, suite_name, max_rep)}


def replicates_markdown(report):
    def text(members):
        return ", ".join(member.replace("|", "\\|") for member in members)
    holdout = report["holdout"]
    lines = [f"# Suite {report['suite']} replicates", "",
             f"{report['item_count']} items; {report['total_defects']} defects. Recall is strict recall over every defect; "
             "false alarms are unmatched findings per suite item over all items. A rep is one complete run of an arm; "
             "partial arms are excluded: " + (", ".join(report["excluded_partial"]) or "none") + ".", "",
             "## Run-to-run spread", "",
             "Pooled arms with at least two reps. SD is the sample SD (n-1) over reps. Stable share is the defects "
             "found by every rep divided by the defects found by any rep. Self-pair recall is the mean union recall "
             "over unordered pairs of reps of the same arm; self-pair gain is that minus the mean single-rep recall. "
             "The best partner is the other pooled arm with the largest size-2 panel gain over this arm's mean "
             "recall (the panels definition: every rep combination averaged), so the two gains are comparable.", "",
             "| Pooled arm | Reps | Recall by rep | Mean | SD | Min | Max | False alarms/item | Stable share | "
             "Self-pair recall | Self-pair gain | Best partner | Pair recall | Pair gain |",
             "|---|---|---|---:|---:|---:|---:|---:|---|---:|---:|---|---:|---:|"]
    for row in report["spread"]:
        best = row["best_partner"]
        lines.append("| {} | {} | {} | {} | {} | {} | {} | {} | {} ({}/{}) | {} | {} | {} | {} | {} |".format(
            text([row["key"]]), ",".join(str(rep) for rep in row["reps"]),
            ", ".join(fmt(value) for value in row["recall_by_rep"]), fmt(row["mean_recall"]), fmt(row["sd_recall"]),
            fmt(row["min_recall"]), fmt(row["max_recall"]), fmt(row["false_alarms_per_item"]),
            fmt(row["stable_share"]), row["found_by_every_rep"], row["found_by_any_rep"],
            fmt(row["self_pair_recall"]), fmt(row["self_pair_gain"]),
            text([best["partner"]]) if best else "none", fmt(best["pair_recall"]) if best else "n/a",
            fmt(best["pair_gain"]) if best else "n/a"))
    def reps_text(reps):
        return ",".join(str(rep) for rep in reps) or "none"
    lines += ["", "## Hold-out", "",
              f"Panels are built from reps {reps_text(holdout['training_reps'])} (rep <= {holdout['max_rep']}), "
              f"then the training build's frontier panels and its cheapest panel for each recall target and size are "
              f"re-scored on the held-out reps {reps_text(holdout['heldout_reps'])} (rep > {holdout['max_rep']}). "
              "A member marked * is scored on its held-out reps alone; an unmarked member has none and keeps its "
              "training reps, so a panel with no marked member is not tested. Difference is held-out minus in-sample "
              "recall. " + (f"{holdout['panels_with_heldout_member']} of {len(holdout['panels'])} panels have a "
              f"held-out member; their mean difference is {fmt(holdout['mean_difference'])}." if
              holdout["mean_difference"] is not None else "No panel has a held-out member."), "",
              "| Roles | Members | In-sample recall | Held-out recall | Difference | In-sample false alarms/item | "
              "Held-out false alarms/item | Held-out reps used |",
              "|---|---|---:|---:|---:|---:|---:|---|"]
    for panel in holdout["panels"]:
        members = ", ".join(detail["key"].replace("|", "\\|") + ("*" if detail["heldout"] else "")
                            for detail in panel["member_detail"])
        used = "; ".join("{} {}".format(detail["key"].replace("|", "\\|"), reps_text(detail["reps_used"]))
                         for detail in panel["member_detail"] if detail["heldout"]) or "none (not tested)"
        lines.append("| {} | {} | {} | {} | {} | {} | {} | {} |".format(
            "; ".join(panel["roles"]), members, fmt(panel["in_sample_recall"]), fmt(panel["heldout_recall"]),
            fmt(panel["difference"]), fmt(panel["in_sample_false_alarms_per_item"]),
            fmt(panel["heldout_false_alarms_per_item"]), used))
    lines += ["", "### Does the training pick still meet its target when held out?", "",
              "Each size's cheapest panel for the target, and the pick: the cheapest of those across sizes. "
              "Tested says whether the panel has any held-out member.", "",
              "| Target | Size | Members | Tested | In-sample recall | Held-out recall | Meets held-out |",
              "|---:|---|---|---|---:|---:|---|"]
    for target, block in holdout["targets"].items():
        for size, entry in block["by_size"].items():
            pick = block["pick"] is not None and entry is not None and entry["members"] == block["pick"]["members"]
            lines.append("| {} | {}{} | {} | {} | {} | {} | {} |".format(
                target, size, " (pick)" if pick else "", text(entry["members"]) if entry else "none",
                ("yes" if entry["has_heldout_member"] else "no") if entry else "n/a",
                fmt(entry["in_sample_recall"]) if entry else "n/a", fmt(entry["heldout_recall"]) if entry else "n/a",
                ("yes" if entry["meets_heldout"] else "no") if entry else "n/a"))
    lines.append("")
    return "\n".join(lines)


def cmd_replicates(args):
    if args.outcomes:
        header, _ = read_outcomes(args.outcomes)
        suite = outcomes_suite(header, args.outcomes)
        collected = collected_from_outcomes(args.outcomes, args.arms_json or arms_json_default(), args.arm)
    else:
        suite = load_suite(args.suite)
        collected = collect(suite, args.ledger or ledger_default(), args.arms_json or arms_json_default(),
                            args.codex_home or os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex"), args.arm)
    report = build_replicates(collected, suite.name, args.holdout_max_rep)
    output = args.out_dir or suite.results_root
    write_atomic(os.path.join(output, "replicates.json"), json.dumps(report, indent=2, sort_keys=True) + "\n")
    write_atomic(os.path.join(output, "replicates.md"), replicates_markdown(report))
    print(f"REPLICATES {len(report['spread'])} pooled arms with at least 2 reps; "
          f"{len(report['holdout']['panels'])} hold-out panels")
    print(f"WROTE {os.path.join(output, 'replicates.json')}")
    print(f"WROTE {os.path.join(output, 'replicates.md')}")
    return 0


# ---------------------------------------------------------------- summary by arm

PROVIDER_ORDER = ("claude", "codex", "gemini", "glm")
SUMMARY_PUBLIC = {"aa_intelligence": "aa_ii_score", "aa_coding_agent": "aa_cai_index", "tb4_hard": "aa_cai_tb4_pct",
                  "aa_cost_intelligence": "aa_ii_cost_per_task_usd", "aa_cost_coding_agent": "aa_cai_cost_per_task_usd"}
SUMMARY_SENTENCE = ("Capability is this suite's review recall and precision; usage is what one item cost in the "
                    "provider's weekly window. Public columns are Artificial Analysis numbers from `public.json`.")


def usd_per_credit(pricing):
    # The same lookup compare uses for Codex credits.
    provider_data = pricing.get("providers", {}).get("codex", {})
    rate = provider_data.get("usd_per_credit")
    return rate if rate is not None else pricing.get("windows", {}).get("codex", {}).get("usd_per_credit")


def catalog_arms(arms_json):
    raw = read_optional_json(arms_json) if arms_json and os.path.exists(arms_json) else None
    return [arm for arm in (raw.get("arms", []) if isinstance(raw, dict) else []) if isinstance(arm, dict)]


def arm_usage_values(collected, names):
    """Tokens and wall seconds of every run of these arms that arm_stats counts."""
    tokens, durations = [], []
    for name in names:
        for record in collected["records"][name].values():
            if record["run"] and record["run"].get("skipped"):
                continue
            cost = record["cost"]
            if cost["duration"] is not None:
                durations.append(cost["duration"])
            if cost["tokens"] is not None:
                tokens.append(cost["tokens"])
    return tokens, durations


def summary_row(point, collected, defect_ids, status, catalog_arm, entries):
    rows, item_count = collected["rows"], len(collected["items"])
    names = point["arms"]
    provider = point["provider"]
    members = [rows[name] for name in names]
    tokens, durations = arm_usage_values(collected, names)
    wall = percentile_summary(durations)
    items_run = sum(row["items_run"] for row in members)
    format_fail = point["format_fail"]
    alarms = {kind: [collected["agg"]["arms"][name]["false_alarms"][kind] for name in names]
              for kind in ("planted", "control")}

    def per_item(kind):
        completed_items = sum(group["completed_items"] for group in alarms[kind])
        return (sum(group["completed_unmatched_findings"] for group in alarms[kind]) / completed_items
                if completed_items else None)

    stable = None
    if len(names) > 1:
        hits = arm_hit_sets(collected, defect_ids)
        stable = hit_set_overlap([hits[name] for name in names])[2]
    cost = point["cost_per_item"]
    api_usd = cost
    if provider == "codex":
        rate = usd_per_credit(collected["pricing"])
        api_usd = cost * rate if cost is not None and rate is not None else None
    elif provider != "claude":
        api_usd = None
    pct_week = point["pct_week_per_item"]
    recalls = [row["recall"] for row in members]
    public = {}
    for entry in entries:
        if entry_matches(entry, point):
            for metric, value in entry["metrics"].items():
                public[metric] = dict(entry["details"][metric], value=value)
    return {
        "lane": point["lane"], "model": point["model"], "effort": point["effort"], "arms": list(names),
        "catalog": catalog_arm["status"] if catalog_arm else "absent",
        "classes": list(catalog_arm.get("classes") or []) if catalog_arm else None,
        "retired_reason": ((catalog_arm.get("retired_reason") or catalog_arm.get("reason"))
                           if catalog_arm and catalog_arm.get("status") == "retired" else None),
        "reps": len(names), "items_run": items_run, "suite_items": item_count, "status": status,
        "recall": point["recall"], "wilson_lo": point["recall_wilson"][0], "wilson_hi": point["recall_wilson"][1],
        "recall_min": min(recalls) if recalls else None, "recall_max": max(recalls) if recalls else None,
        "stable_share": stable, "precision": point["precision"],
        "fa_per_planted_item": per_item("planted"), "fa_per_control_item": per_item("control"),
        "usable": point["usable"], "format_fail": format_fail,
        "format_fail_rate": format_fail / items_run if items_run else None,
        "infra_failures": sum(row["infra_failures"] for row in members),
        "tokens_per_item": mean(tokens) if tokens else None,
        "cost_per_item": cost, "cost_unit": {"codex": "credits", "claude": "list_usd"}.get(provider),
        "api_usd_per_item": api_usd,
        "pct_week_per_item": pct_week, "pct_5h_per_item": point["pct_5h_per_item"],
        "items_per_week": int(round(100 / pct_week)) if pct_week else None,
        "wall_median_s": wall["median"], "wall_p90_s": wall["p90"], "public": public}


def unrun_summary_row(arm, item_count, entries):
    lane, model, effort = arm.get("lane"), arm.get("model"), arm.get("effort")
    row = {key: None for key in (
        "recall", "wilson_lo", "wilson_hi", "recall_min", "recall_max", "stable_share", "precision",
        "fa_per_planted_item", "fa_per_control_item", "usable", "format_fail", "format_fail_rate", "infra_failures",
        "tokens_per_item", "cost_per_item", "cost_unit", "api_usd_per_item", "pct_week_per_item", "pct_5h_per_item",
        "items_per_week", "wall_median_s", "wall_p90_s")}
    public = {}
    for entry in entries:
        if entry_matches(entry, {"lane": lane, "model": model, "effort": effort}):
            for metric, value in entry["metrics"].items():
                public[metric] = dict(entry["details"][metric], value=value)
    row.update({
        "lane": lane, "model": model, "effort": effort, "arms": [], "catalog": arm.get("status"),
        "classes": list(arm.get("classes") or []),
        "retired_reason": (arm.get("retired_reason") or arm.get("reason")) if arm.get("status") == "retired" else None,
        "reps": 0, "items_run": 0, "suite_items": item_count, "status": "not run", "public": public})
    return row


def summary_sort_key(row):
    provider = PROVIDER_OF_LANE.get(row["lane"], row["lane"])
    effort = row["effort"]
    rank = EFFORTS.index(effort) if effort in EFFORTS else len(EFFORTS) + (0 if effort == "*" else 1)
    return (PROVIDER_ORDER.index(provider) if provider in PROVIDER_ORDER else len(PROVIDER_ORDER),
            # gemini names one model per effort (gemini-3.8-flash-low); drop that suffix so its efforts stay in order
            str(row["model"] or "").removesuffix("-" + str(effort)), row["lane"], rank, str(effort),
            ["measured", "partial", "not run"].index(row["status"]),
            row["arms"])


def build_summary(suite, collected, arms_json, entries, public_path):
    rows, item_count = collected["rows"], len(collected["items"])
    catalog = {(arm.get("lane"), arm.get("model"), arm.get("effort")): arm for arm in catalog_arms(arms_json)}
    defect_ids = [f"{item}:{defect['id']}" for item, defects in collected["items"].items() for defect in defects]
    out, seen = [], set()
    for point in pool_rows(rows, item_count):
        identity = (point["lane"], point["model"], point["effort"])
        seen.add(identity)
        out.append(summary_row(point, collected, defect_ids, "measured", catalog.get(identity), entries))
    for name, row in rows.items():
        if not row["partial"]:
            continue
        identity = (row["lane"], row["model"], row["effort"])
        seen.add(identity)
        point = pool_rows({name: dict(row, partial=False)}, item_count)[0]
        entry = summary_row(point, collected, defect_ids, "partial", catalog.get(identity), entries)
        entry["status_note"] = "partial ({} of {} items)".format(row["items_run"], item_count)
        out.append(entry)
    for identity, arm in catalog.items():
        if identity not in seen:
            out.append(unrun_summary_row(arm, item_count, entries))
    out.sort(key=summary_sort_key)
    return {"schema_version": 1, "suite": suite.name, "class": suite.cls, "items": item_count,
            "total_defects": collected["agg"]["total_defects"], "public": public_display_path(public_path),
            "rows": out}


def two(value):
    return "n/a" if value is None else f"{value:.2f}"


def sig(value, digits=3):
    """Fixed notation to `digits` significant figures."""
    if value is None:
        return "n/a"
    if value == 0:
        return "0"
    return f"{value:.{max(digits - 1 - math.floor(math.log10(abs(value))), 0)}f}"


def summary_public(row, metric, money=False):
    found = row["public"].get(SUMMARY_PUBLIC[metric])
    if found is None:
        return "n/a"
    return "$" + sig(found["value"]) if money else format(float(f"{found['value']:.3g}"), "g")


def summary_runs(row):
    if row["status"] == "not run":
        return "not run"
    return row.get("status_note") or str(row["reps"])


def summary_markdown(report):
    lines = [f"# Suite {report['suite']} by arm", "",
             f"Suite {report['suite']} (class {report['class']}): {report['items']} items, "
             f"{report['total_defects']} defects.", "", SUMMARY_SENTENCE, "", "## Capability", "",
             "| Lane | Model | Effort | Catalog | Runs | Recall [Wilson 95%] | Range over runs | Stable share | Precision | "
             "FA/planted | FA/control | Usable | Format fail | AA intelligence | AA coding-agent | TB4 hard |",
             "|---|---|---|---|---|---|---|---|---:|---:|---:|---:|---|---:|---:|---:|"]
    for row in report["rows"]:
        measured = row["recall"] is not None
        lines.append("| {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} |".format(
            row["lane"], row["model"] or "-", row["effort"], row["catalog"], summary_runs(row),
            "{} [{}, {}]".format(two(row["recall"]), two(row["wilson_lo"]), two(row["wilson_hi"])) if measured else "n/a",
            "{}-{}".format(two(row["recall_min"]), two(row["recall_max"])) if row["reps"] > 1 else "n/a",
            two(row["stable_share"]), two(row["precision"]), two(row["fa_per_planted_item"]),
            two(row["fa_per_control_item"]), two(row["usable"]),
            "{} ({})".format(row["format_fail"], two(row["format_fail_rate"])) if measured else "n/a",
            summary_public(row, "aa_intelligence"), summary_public(row, "aa_coding_agent"),
            summary_public(row, "tb4_hard")))
    lines += ["", "## Usage", "",
              "| Lane | Model | Effort | Tokens/item | Cost/item | API $/item | %week/item | %5h/item | Items per week | "
              "Wall median s | AA $/task (intelligence) | AA $/task (coding-agent) |",
              "|---|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|"]
    for row in report["rows"]:
        cost = row["cost_per_item"]
        unit = {"credits": " credits", "list_usd": " list $"}.get(row["cost_unit"], "")
        lines.append("| {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} |".format(
            row["lane"], row["model"] or "-", row["effort"],
            "n/a" if row["tokens_per_item"] is None else f"{row['tokens_per_item']:.0f}",
            "n/a" if cost is None else sig(cost) + unit,
            "n/a" if row["api_usd_per_item"] is None else "$" + sig(row["api_usd_per_item"]),
            sig(row["pct_week_per_item"]), sig(row["pct_5h_per_item"]),
            "n/a" if row["items_per_week"] is None else row["items_per_week"],
            "n/a" if row["wall_median_s"] is None else f"{row['wall_median_s']:.1f}",
            summary_public(row, "aa_cost_intelligence", True), summary_public(row, "aa_cost_coding_agent", True)))
    lines.append("")
    return "\n".join(lines)


def cmd_summary(args):
    arms_json = args.arms_json or arms_json_default()
    if args.outcomes:
        header, _ = read_outcomes(args.outcomes)
        suite = outcomes_suite(header, args.outcomes)
        collected = collected_from_outcomes(args.outcomes, arms_json, args.arm)
    else:
        suite = load_suite(args.suite)
        collected = collect(suite, args.ledger or ledger_default(), arms_json,
                            args.codex_home or os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex"), args.arm)
    public_path = args.public or PUBLIC_DEFAULT
    report = build_summary(suite, collected, arms_json, load_public(public_path), public_path)
    output = args.out_dir or suite.results_root
    write_atomic(os.path.join(output, "by-arm.json"), json.dumps(report, indent=2, sort_keys=True) + "\n")
    write_atomic(os.path.join(output, "by-arm.md"), summary_markdown(report))
    print(f"SUMMARY {len(report['rows'])} rows, {sum(row['status'] != 'not run' for row in report['rows'])} measured")
    print(f"WROTE {os.path.join(output, 'by-arm.json')}")
    print(f"WROTE {os.path.join(output, 'by-arm.md')}")
    return 0


# ---------------------------------------------------------------- CLI

def positive_int(value):
    try:
        parsed = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError("must be an integer")
    if parsed < 1:
        raise argparse.ArgumentTypeError("must be at least 1")
    return parsed


def add_common(parser):
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--suite", metavar="DIR")
    source.add_argument("--outcomes", metavar="FILE")
    parser.add_argument("--arm", action="append", metavar="NAME", help="only these arm directories; repeatable")
    parser.add_argument("--ledger", metavar="DIR", help="lane ledger runs (default $LANES_STATE/runs)")
    parser.add_argument("--arms-json", metavar="PATH", help="catalog with providers.*.window and rate_card")
    parser.add_argument("--codex-home", metavar="DIR", help="Codex home for rollouts (default $CODEX_HOME or ~/.codex)")
    parser.add_argument("--results-dir", metavar="DIR", help="output directory (default <suite>/results)")


def build_parser():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    run = sub.add_parser("run", help="run a suite across arms, with launch gates")
    run.add_argument("--suite", required=True, metavar="DIR")
    run.add_argument("--arm", action="append", metavar="LANE:EFFORT[:MODEL]")
    run.add_argument("--arms-file", metavar="F", help="one arm spec per line; # starts a comment")
    run.add_argument("--rep", type=positive_int, default=1, metavar="N")
    run.add_argument("--items", metavar="001,002")
    run.add_argument("--par", type=positive_int, default=4, help="lanes per arm")
    run.add_argument("--slots", type=positive_int, default=2, help="arms at once")
    run.add_argument("--timeout", type=positive_int, default=1800, metavar="SEC")
    run.add_argument("--resume", action="store_true", help="keep finished runs, move failed ones aside")
    run.add_argument("--no-grade", action="store_true")
    run.add_argument("--approved", metavar="NOTE", help="who approved this capability test, and when (required)")
    run.add_argument("--claude-5h", type=float, default=75, metavar="PCT")
    run.add_argument("--claude-7d", type=float, default=65, metavar="PCT")
    run.add_argument("--codex-7d", type=float, default=96, metavar="PCT")
    run.add_argument("--codex-at-limit", choices=("skip", "wait"), default="skip",
                     help="skip a Codex item at the weekly ceiling, or wait for room")
    run.add_argument("--codex-wait-max-h", type=float, default=0, metavar="HOURS",
                     help="maximum time to wait for Codex weekly room (0 means no limit)")
    run.set_defaults(func=cmd_run)

    grade = sub.add_parser("grade", help="score every arm, writing results/summary.{json,md}")
    grade.add_argument("--suite", metavar="DIR")
    grade.add_argument("--arm", action="append", metavar="NAME")
    grade.add_argument("--results-dir", metavar="DIR", help="output directory (default <suite>/results)")
    grade.add_argument("--selftest", action="store_true")
    grade.set_defaults(func=cmd_grade)

    export = sub.add_parser("export", help="export de-identified per-run suite outcomes as JSONL")
    export.add_argument("--suite", required=True, metavar="DIR")
    export.add_argument("--arm", action="append", metavar="NAME", help="only these arm directories; repeatable")
    export.add_argument("--summary", metavar="FILE", help="graded summary.json to use for per-item scores")
    export.add_argument("--ledger", metavar="DIR")
    export.add_argument("--arms-json", metavar="PATH")
    export.add_argument("--codex-home", metavar="DIR")
    export.add_argument("--out", required=True, metavar="FILE")
    export.set_defaults(func=cmd_export)

    export_findings = sub.add_parser("export-findings", help="export every finding for adjudication as JSONL")
    export_findings.add_argument("--suite", required=True, metavar="DIR")
    export_findings.add_argument("--summary", required=True, metavar="FILE")
    export_findings.add_argument("--arm", action="append", metavar="NAME")
    export_findings.add_argument("--out", required=True, metavar="FILE")
    export_findings.set_defaults(func=cmd_export_findings)

    rescore = sub.add_parser("rescore", help="rescore findings against the adjudicated extended key")
    rescore.add_argument("--suite", required=True, metavar="DIR", help="suite containing items/<item>/defects.json")
    rescore.add_argument("--findings", action="append", required=True, metavar="F",
                         help="findings JSONL; repeatable; rows carry fid, arm, item, finding_index, strict, matched_defect")
    rescore.add_argument("--assignments", required=True, metavar="A",
                         help="JSONL with fid, issue_id for unmatched, partial, and other_issue findings")
    rescore.add_argument("--issues", required=True, metavar="I",
                         help="JSONL with issue_id, file, line, line_end, final_verdict, scope, severity_judged")
    rescore.add_argument("--matched-audit", required=True, metavar="M",
                         help="JSONL with fid, label (describes, partial, or other_issue) for old matched findings")
    rescore.add_argument("--outcomes", action="append", required=True, metavar="O",
                         help="outcomes JSONL with a header and one outcome row per arm and item; repeatable")
    rescore.add_argument("--by-arm", metavar="B", help="optional v1 by-arm.json; mismatches fail the reproduction gate")
    rescore.add_argument("--seed", type=int, default=1022, help="bootstrap seed (default: 1022)")
    rescore.add_argument("--resamples", type=positive_int, default=2000, help="bootstrap item resamples (default: 2000)")
    rescore.add_argument("--out-dir", required=True, metavar="D", help="directory for rescore outputs")
    rescore.set_defaults(func=cmd_rescore)

    panels = sub.add_parser("panels", help="compute reviewer panels for single, paired and triple pooled arms")
    panel_source = panels.add_mutually_exclusive_group(required=True)
    panel_source.add_argument("--suite", metavar="DIR")
    panel_source.add_argument("--outcomes", metavar="FILE")
    panels.add_argument("--arm", action="append", metavar="NAME")
    panels.add_argument("--arms-json", metavar="PATH")
    panels.add_argument("--ledger", metavar="DIR")
    panels.add_argument("--codex-home", metavar="DIR")
    panels.add_argument("--results-dir", metavar="DIR")
    panels.add_argument("--max-size", type=positive_int, default=3, metavar="N")
    panels.set_defaults(func=cmd_panels)

    replicates = sub.add_parser("replicates", help="run-to-run spread per pooled arm and a hold-out check of the panels")
    replicate_source = replicates.add_mutually_exclusive_group(required=True)
    replicate_source.add_argument("--suite", metavar="DIR")
    replicate_source.add_argument("--outcomes", metavar="FILE")
    replicates.add_argument("--arm", action="append", metavar="NAME")
    replicates.add_argument("--arms-json", metavar="PATH")
    replicates.add_argument("--ledger", metavar="DIR")
    replicates.add_argument("--codex-home", metavar="DIR")
    replicates.add_argument("--holdout-max-rep", type=positive_int, default=2, metavar="N",
                            help="build panels from reps <= N, score them on reps > N (default 2)")
    replicates.add_argument("--out-dir", metavar="DIR", help="output directory (default <suite>/results)")
    replicates.set_defaults(func=cmd_replicates)

    summary = sub.add_parser("summary", help="every model and effort: capability and usage beside the public numbers")
    summary_source = summary.add_mutually_exclusive_group(required=True)
    summary_source.add_argument("--suite", metavar="DIR")
    summary_source.add_argument("--outcomes", metavar="FILE")
    summary.add_argument("--public", metavar="FILE", help="public numbers (default findings/public.json)")
    summary.add_argument("--arms-json", metavar="PATH", help="catalog (default ~/.claude/usage-optimizer/arms.json)")
    summary.add_argument("--arm", action="append", metavar="NAME")
    summary.add_argument("--ledger", metavar="DIR")
    summary.add_argument("--codex-home", metavar="DIR")
    summary.add_argument("--out-dir", metavar="DIR", help="output directory (default <suite>/results)")
    summary.set_defaults(func=cmd_summary)

    stats = sub.add_parser("stats", help="per-arm statistics, costs, Pareto and effort curves")
    add_common(stats)
    stats.set_defaults(func=cmd_stats)

    compare = sub.add_parser("compare", help="compare arm recall with public benchmark numbers")
    add_common(compare)
    compare.add_argument("--public", metavar="FILE", help="public numbers (default findings/public.json)")
    compare.set_defaults(func=cmd_compare)

    priors = sub.add_parser("priors", help="measured priors per arm; --write merges into arms.local.json")
    priors_source = priors.add_mutually_exclusive_group(required=True)
    priors_source.add_argument("--suite", metavar="DIR")
    priors_source.add_argument("--outcomes", metavar="FILE")
    priors.add_argument("--min-items", type=positive_int, default=30, metavar="N")
    priors.add_argument("--score", choices=("v1", "v2"), default="v1")
    priors.add_argument("--write", metavar="PATH", help="merge into an arms.local.json")
    priors.add_argument("--ledger", metavar="DIR")
    priors.add_argument("--arms-json", metavar="PATH", help="catalog (default ~/.claude/usage-optimizer/arms.json)")
    priors.add_argument("--codex-home", metavar="DIR")
    priors.set_defaults(func=cmd_priors)
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except BenchError as exc:
        print(f"lane-bench: {exc}", file=sys.stderr)
        return 2
    except (ValueError, OSError) as exc:
        print(f"lane-bench: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())

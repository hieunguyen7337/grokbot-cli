class MainUnitMatcher:
    """MAIN_UNIT_RE.fullmatch(name): a unit name is 1 to 48 characters of A-Z a-z 0-9 . _ - and not a device name."""

    @staticmethod
    def fullmatch(name):
        return MAIN_UNIT_PATTERN.fullmatch(name) if not MAIN_DEVICE_RE.fullmatch(name) else None



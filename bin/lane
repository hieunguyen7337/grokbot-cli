class LaneError(Exception):
    def __init__(self, message, code=8, verdict="REFUSED"):
        super().__init__(message)
        self.code = code
        self.verdict = verdict


def utc_now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def run_quiet(argv, cwd=None, timeout=30):
    try:
        return subprocess.run(argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None


def is_git_repo(path):
    result = run_quiet(["git", "-C", path, "rev-parse", "--is-inside-work-tree"])
    return bool(result and result.returncode == 0 and result.stdout.strip() == b"true")


def git_status(path):
    # Only this directory, every untracked file listed: inside an untracked folder of an enclosing repo,
    # plain --short shows just the folder, so a Claude lane's new files read as NOOP (Suite R, 2026-10-20).
    result = run_quiet(["git", "-C", path, "status", "--short", "--untracked-files=all", "--", "."])
    if not result or result.returncode != 0:
        return None
    return result.stdout.decode("utf-8", "replace").splitlines()


def git_head(path):
    result = run_quiet(["git", "-C", path, "rev-parse", "HEAD"])
    if not result or result.returncode != 0:
        return None
    return result.stdout.decode("ascii", "replace").strip()


# UTF-8 text decoded in a single-byte code page and written back: Â or Ã before a continuation-range character,
# the â€ of dashes and quotes, and U+FFFD.
GARBLED_RE = re.compile("[\u00c2\u00c3][\u0080-\u00bf]|\u00e2\u20ac|\ufffd")
TEXT_CHECK_MAX_BYTES = 2000000
TEXT_CHECK_MAX_FILES = 400
WALK_SKIP_DIRS = {".git", "node_modules", ".venv", "venv", "__pycache__", "dist", "build", ".next", "target"}


def changed_files(path, since_epoch):
    """Files a run may have written: git's changed and untracked files, or outside git the files newer than its start."""
    if is_git_repo(path):
        names = []
        for argv in (["git", "-C", path, "diff", "--name-only", "-z", "--relative", "HEAD", "--", "."],
                     ["git", "-C", path, "ls-files", "-z", "--others", "--exclude-standard", "--", "."]):
            result = run_quiet(argv)
            if result and result.returncode == 0:
                names.extend(name for name in result.stdout.decode("utf-8", "replace").split("\0") if name)
        return list(dict.fromkeys(names))[:TEXT_CHECK_MAX_FILES], True
    names, seen = [], 0
    for root, dirs, files in os.walk(path):
        dirs[:] = [name for name in dirs if name not in WALK_SKIP_DIRS]
        for name in files:
            seen += 1
            full = os.path.join(root, name)
            try:
                if os.path.getmtime(full) >= since_epoch:
                    names.append(os.path.relpath(full, path))
            except OSError:
                pass
            if seen >= 20000 or len(names) >= TEXT_CHECK_MAX_FILES:
                return names, False
    return names, False


def text_problems(data):
    if data.startswith((b"\xff\xfe", b"\xfe\xff")):
        return {"utf16": True, "bom": False, "garbled": 0, "crlf": False}
    if b"\0" in data[:8192]:
        return None
    lines = data.count(b"\n")
    return {"utf16": False, "bom": data.startswith(b"\xef\xbb\xbf"),
            "garbled": len(GARBLED_RE.findall(data.decode("utf-8", "replace"))),
            "crlf": lines > 0 and data.count(b"\r\n") == lines}


def git_checks_out_crlf(path, shown):
    # core.autocrlf=true or an eol=crlf attribute writes CRLF on checkout, so CRLF there is no change.
    result = run_quiet(["git", "-C", path, "config", "--get", "core.autocrlf"])
    if result and result.returncode == 0 and result.stdout.strip().lower() == b"true":
        return True
    result = run_quiet(["git", "-C", path, "check-attr", "eol", "--", shown])
    return bool(result and result.returncode == 0 and result.stdout.strip().endswith(b": crlf"))


def encoding_warnings(path, since_epoch):
    """Changed text files that gained a byte-order mark, UTF-16, garbled characters or CRLF against HEAD (or nothing)."""
    warnings = []
    names, in_git = changed_files(path, since_epoch)
    for name in names:
        full = os.path.join(path, name)
        try:
            if os.path.getsize(full) > TEXT_CHECK_MAX_BYTES:
                continue
            with open(full, "rb") as stream:
                now = text_problems(stream.read())
        except OSError:
            continue
        if now is None:
            continue
        before = None
        tracked = False
        shown = name.replace(os.sep, "/")
        if in_git:
            result = run_quiet(["git", "-C", path, "show", "HEAD:./" + shown])
            if result and result.returncode == 0:
                tracked = True
                before = text_problems(result.stdout)
        before = before or {"utf16": False, "bom": False, "garbled": 0, "crlf": False}
        # A Claude lane on Windows saved whole files with CRLF on 2026-10-30; the diff then shows every line changed.
        if in_git and now["crlf"] and not before["crlf"] and not git_checks_out_crlf(path, shown):
            warnings.append("{}: {} CRLF line endings (a Windows editor or tool saved it); the repository uses LF".format(
                shown, "changed to" if tracked else "new file with"))
        if now["utf16"] and not before["utf16"]:
            warnings.append("{}: written as UTF-16 (Out-File or > in Windows PowerShell); most tools expect UTF-8".format(shown))
        if now["bom"] and not before["bom"]:
            warnings.append("{}: starts with a UTF-8 byte-order mark (Set-Content -Encoding UTF8); JSON readers reject it".format(shown))
        if now["garbled"] > before["garbled"]:
            warnings.append("{}: {} new garbled characters (UTF-8 read as ANSI, such as Â· for ·, or text that is not UTF-8)".format(
                shown, now["garbled"] - before["garbled"]))
    return warnings


def read_lines(path):
    try:
        with open(path, "r", encoding="utf-8") as stream:
            return [line.strip() for line in stream if line.strip() and not line.lstrip().startswith("#")]
    except FileNotFoundError:
        return []
    except OSError as exc:
        raise LaneError("cannot read configuration file {}: {}".format(path, exc), 8)


def config_dir():
    return os.path.abspath(os.path.expanduser(os.environ.get("LANES_CONFIG", "~/.config/lanes")))


USAGE_MODES = ("saving", "default", "utilization")


def mode_setting(explore):
    """The usage mode setting: USAGE_OPTIMIZER_MODE, else the first word of ~/.config/lanes/mode, else explore.mode.

    bin/lane-stats resolves it the same way. An unknown value warns once and counts as default.
    """
    value = os.environ.get("USAGE_OPTIMIZER_MODE", "").strip()
    if not value:
        try:
            with open(os.path.join(config_dir(), "mode"), "r", encoding="utf-8") as stream:
                words = stream.read().split()
            value = words[0] if words else ""
        except (OSError, UnicodeDecodeError):
            value = ""
    if not value and isinstance(explore, dict) and isinstance(explore.get("mode"), str):
        value = explore["mode"].strip()
    if not value:
        return "default"
    if value.lower() not in USAGE_MODES + ("auto",):
        print("warning: usage mode {!r} is not saving, default, utilization or auto; using default".format(value),
              file=sys.stderr)
        return "default"
    return value.lower()


def projected_mode(projected, explore):
    # auto: a week heading past saving_pct of the window at reset saves, one at or under utilization_pct spends.
    modes = explore.get("modes") if isinstance(explore, dict) else None
    modes = modes if isinstance(modes, dict) else {}
    limits = []
    for key, fallback in (("saving_pct", 110.0), ("utilization_pct", 90.0)):
        value = modes.get(key)
        valid = isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)
        limits.append(float(value) if valid else fallback)
    if projected is None:
        return "default"
    if projected >= limits[0]:
        return "saving"
    if projected <= limits[1]:
        return "utilization"
    return "default"


def lane_bin_dir():
    return os.path.join(config_dir(), "bin")


def arms_catalog_path():
    override = os.environ.get("LANES_ARMS")
    if override:
        return os.path.abspath(os.path.expanduser(override))
    return os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "arms.json"))


def arms_local_path():
    return os.path.abspath(os.path.expanduser(os.environ.get("LANES_ARMS_LOCAL") or "~/.config/lanes/arms.local.json"))


def read_arms_file(path):
    try:
        with open(path, "r", encoding="utf-8") as stream:
            data = json.load(stream)
    except OSError as exc:
        raise LaneError("cannot read {}: {}".format(path, exc.strerror or exc), 8)
    except ValueError as exc:
        raise LaneError("{} is not valid JSON: {}".format(path, exc), 8)
    arms = data.get("arms", []) if isinstance(data, dict) else None
    if not isinstance(arms, list) or not all(isinstance(arm, dict) for arm in arms):
        raise LaneError("{} is not an arms catalog".format(path), 8)
    return data


def arm_key(arm):
    return (arm.get("lane"), arm.get("model"), arm.get("effort"))


def merge_catalog(base, overlay):
    merged = dict(base)
    for key, value in overlay.items():
        if key == "arms":
            continue
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            merged[key] = dict(base[key], **value)
        else:
            merged[key] = value
    arms = [dict(arm) for arm in base.get("arms", [])]
    for entry in overlay.get("arms", []):
        match = next((arm for arm in arms if arm_key(arm) == arm_key(entry)), None)
        if match is None:
            arms.append(dict(entry))
        else:
            match.update(entry)
    merged["arms"] = arms
    return merged


def load_catalog():
    path = arms_catalog_path()
    catalog = read_arms_file(path)
    if not isinstance(catalog.get("arms"), list):
        raise LaneError("{} has no arms list".format(path), 8)
    local = arms_local_path()
    if os.path.exists(local):
        catalog = merge_catalog(catalog, read_arms_file(local))
    for arm in catalog["arms"]:
        if not all(isinstance(arm.get(field), str) for field in ("lane", "model", "effort", "status")):
            raise LaneError("an arms entry lacks a string lane, model, effort or status", 8)
    return catalog


def load_catalog_or_warn():
    try:
        return load_catalog()
    except LaneError as exc:
        print("lane: arms catalog unavailable ({}); using built-in defaults".format(exc), file=sys.stderr)
        return None


def default_model(catalog, lane):
    lanes = catalog.get("lanes") if catalog else None
    entry = lanes.get(lane) if isinstance(lanes, dict) else None
    model = entry.get("model") if isinstance(entry, dict) else None
    return model if isinstance(model, str) and model else DEFAULT_MODELS[lane]


def arm_for(catalog, lane, model, effort):
    # The exact arm for this effort, else the lane's model-wide "*" entry.
    for wanted in (effort, "*"):
        for arm in catalog["arms"]:
            if (arm["lane"], arm["model"], arm["effort"]) == (lane, model, wanted):
                return arm
    return None


def require_arm(lane, model, effort, arm):
    label = "lane: {} {} ({})".format(lane, effort or "-", model)
    if arm is None:
        raise LaneError("{} is not in the arms catalog; add it to ~/.config/lanes/arms.local.json or pass --off-catalog".format(
            label), 8)
    if arm["status"] not in ("active", "manual"):
        raise LaneError("{} is {}: {}; pass --off-catalog to run it anyway".format(
            label, arm["status"], arm.get("reason", "no reason recorded")), 8)


def resolve_binary(name):
    # Lane-only executables live in <config dir>/bin and win over PATH (PATHEXT via shutil.which).
    found = shutil.which(name, path=lane_bin_dir())
    if found:
        return found, "lane bin folder"
    found = shutil.which(name)
    return (found, "PATH") if found else (None, None)


def format_executable(path, origin):
    if not path:
        return "not found"
    if origin:
        return "{} ({})".format(path, origin)
    return path


WINDOWS_SHIM_VARIABLES = ("USERPROFILE", "LOCALAPPDATA", "APPDATA", "PROGRAMFILES", "PROGRAMDATA")


def windows_shim_target(path):
    """Return the argv prefix a .cmd/.bat launcher runs, or None if it is not a recognised shape.

    cmd.exe re-parses every argument of a batch file (newlines end the command; quotes, % and &
    are reinterpreted), so lane runs the target directly instead of going through the shim.
    Recognised: `"<path>.exe" ["<script>"] %*`, and npm's `"%_prog%" "<script>" %*`.
    """
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as stream:
            text = stream.read()
    except OSError:
        return None
    shim_dir = os.path.dirname(os.path.abspath(path))

    def expand(value):
        value = value.replace("%~dp0", shim_dir + os.sep).replace("%dp0%", shim_dir + os.sep)
        for variable in WINDOWS_SHIM_VARIABLES:
            value = re.sub("%" + variable + "%", lambda _: os.environ.get(variable, ""), value, flags=re.IGNORECASE)
        return os.path.normpath(value)

    npm = re.search(r'"%_prog%"\s+"([^"]+)"\s+%\*', text)
    if npm:
        script = expand(npm.group(1))
        local_node = os.path.join(shim_dir, "node.exe")
        node = local_node if os.path.isfile(local_node) else shutil.which("node")
        if node and os.path.isfile(script):
            return [node, script]
        return None
    direct = re.search(r'"([^"]+\.exe)"(?:\s+"([^"]+)")?\s+%\*', text, flags=re.IGNORECASE)
    if direct:
        target = expand(direct.group(1))
        if os.path.isfile(target):
            script = expand(direct.group(2)) if direct.group(2) else None
            if script is None or os.path.isfile(script):
                return [target, script] if script else [target]
    return None


def launch_prefix(executable):
    """The argv prefix that starts `executable` without a cmd.exe shim on Windows."""
    if IS_WINDOWS and executable and os.path.splitext(executable)[1].lower() in (".cmd", ".bat"):
        target = windows_shim_target(executable)
        if target is None:
            raise LaneError("{} is a batch launcher lane cannot unwrap; cmd.exe would garble the brief. "
                            "Point PATH at the real executable instead".format(executable), 8)
        return target
    return [executable]


def windows_command_line_length(argv):
    return len(subprocess.list2cmdline(argv))


def with_launcher(command, executable):
    if not executable:
        return command
    return launch_prefix(executable) + command[1:]


def build_command(lane, opts, model, dir_path, brief_text, outdir, executable):
    if lane == "codex-cloud":
        return [executable or "codex", "cloud", "exec"]
    if lane in CODEX_LANES:
        argv = [executable or "codex", "exec", "--skip-git-repo-check", "-m", model,
                "-C", dir_path, "-s", "read-only" if opts.ro else "workspace-write",
                "-c", 'approval_policy="never"', "-c", 'model_reasoning_effort="{}"'.format(opts.effort),
                "-o", os.path.join(outdir, "final.md")]
        if opts.web:
            # `codex exec` rejects --search, which only top-level codex takes; web_search is the config key behind it
            # (inferred: exec's help does not list it).
            argv.extend(["-c", 'web_search="live"'])
        if opts.resume:
            argv.extend(["resume", opts.resume])
        argv.append("-")
        return argv
    if lane in CLAUDE_LANES:
        allowed = ["Read", "Glob", "Grep", "Bash"] if opts.ro else ["Bash", "Read", "Edit", "Write", "Glob", "Grep"]
        disallowed = ["Agent", "Workflow"]
        if opts.web:
            allowed.extend(["WebSearch", "WebFetch"])
        else:
            disallowed.extend(["WebSearch", "WebFetch"])
        if opts.ro:
            disallowed.extend(["Edit", "Write"])
        argv = [executable or "claude", "-p", "--model", model, "--effort", opts.effort,
                "--output-format", "json", "--setting-sources", "project,local",
                "--strict-mcp-config", "--permission-mode", "acceptEdits", "--allowedTools"]
        argv.extend(allowed)
        argv.append("--disallowedTools")
        argv.extend(disallowed)
        argv.extend(["--append-system-prompt", WORKER_BLOCK])
        if opts.resume:
            argv.extend(["--resume", opts.resume])
        return argv
    if lane == "gemini":
        argv = [executable or "agy", "--sandbox", "--dangerously-skip-permissions",
                "--add-dir", dir_path, "--output-format", "json", "--model", model,
                "--print-timeout", "25m"]
        if opts.ro:
            argv.extend(["--mode", "plan"])
        if opts.resume:
            argv.extend(["--conversation", opts.resume])
        argv.append("--print=" + brief_text)
        return argv
    return [executable or "cline", "-P", "cline", "-m", model, "-c", dir_path,
            "--auto-approve", "true", "-t", "900", brief_text]


def cloud_process(argv, cwd=None, timeout=30, input_data=None, env=None):
    try:
        return subprocess.run(argv, cwd=cwd, input=input_data, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              timeout=timeout, check=False, env=env)
    except subprocess.TimeoutExpired as exc:
        raise LaneError("cloud command timed out: {}".format(argv[0]), 124, "TIMEOUT") from exc
    except OSError as exc:
        raise LaneError("cannot start cloud command {}: {}".format(argv[0], exc), 4, "FAILED") from exc


def cloud_git(path, args, timeout=30):
    if args and args[0] in ("fetch", "ls-remote", "push"):
        executable, _ = resolve_binary("git")
        prefix = launch_prefix(executable) if executable else ["git"]
    else:
        prefix = ["git"]
    return cloud_process(prefix + ["-C", path] + list(args), cwd=path, timeout=timeout)


def cloud_preflight_git(path, args, timeout=30):
    try:
        return cloud_git(path, args, timeout)
    except LaneError as exc:
        raise LaneError("cloud preflight git check failed: {}".format(args[0]), 8) from exc


def cloud_git_until(path, args, deadline, cap=120):
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise LaneError("cloud run timed out", 124, "TIMEOUT")
    return cloud_git(path, args, timeout=min(float(cap), remaining))


def cloud_output(result):
    return result.stdout.decode("utf-8", "replace").strip()


def cloud_poll_interval():
    raw = os.environ.get("LANES_CLOUD_POLL", "30")
    try:
        value = float(raw)
    except (TypeError, ValueError, OverflowError):
        raise LaneError("LANES_CLOUD_POLL must be a positive number", 8)
    if value <= 0 or not math.isfinite(value):
        raise LaneError("LANES_CLOUD_POLL must be a positive number", 8)
    return value


def cloud_url_is_github(value):
    if re.match(r"^(?:[^@/]+@)?github\.com:", value, re.IGNORECASE):
        return True
    try:
        parsed = urlsplit(value)
    except ValueError:
        return False
    return parsed.scheme.lower() in ("https", "ssh") and (parsed.hostname or "").lower() == "github.com"


def cloud_repo_slug(remote_url, keep_case=False):
    """`owner/repo` (lower case unless keep_case) for a GitHub remote, else None."""
    match = re.match(r"^(?:[^@/]+@)?github\.com:(.+)$", remote_url, re.IGNORECASE)
    if match:
        repo_path = match.group(1)
    else:
        try:
            parsed = urlsplit(remote_url)
        except ValueError:
            return None
        if (parsed.hostname or "").lower() != "github.com":
            return None
        repo_path = parsed.path
    repo_path = repo_path.strip("/")
    if repo_path.lower().endswith(".git"):
        repo_path = repo_path[:-4]
    parts = repo_path.split("/")
    if len(parts) != 2 or not all(parts):
        return None
    slug = "/".join(parts)
    return slug if keep_case else slug.lower()


def claude_app_missing(remote_url):
    """True only when GitHub lists the apps of the remote's organization and the Claude app is not among them.

    Without the app a cloud session runs from an uploaded bundle, cannot push, and lane waits 600 s for a start
    marker that never comes (2026-10-31: seven runs on an organization without the app). A user-owned repository,
    or an account that cannot list the organization's apps, cannot be checked this way and passes.
    """
    slug = cloud_repo_slug(remote_url)
    gh = shutil.which("gh")
    if not slug or not gh or os.environ.get("LANES_CLOUD_SKIP_APP_CHECK") == "1":
        return False
    owner = slug.split("/", 1)[0]
    try:
        result = cloud_process([gh, "api", "orgs/{}/installations".format(owner), "--paginate",
                                "--jq", ".installations[].app_slug"], timeout=30)
    except LaneError:
        return False
    if result.returncode:
        return False
    return "claude" not in cloud_output(result).split()


def codex_cloud_env(remote_url):
    """The Codex Cloud environment for this repository: LANES_CODEX_CLOUD_ENV, else cloud.json, else its name.

    An environment belongs to one repository, so a GitHub remote is looked up by its own `codex_envs` entry; the
    single `codex_env` serves only remotes that are not on GitHub. One environment for every repository would run
    a task in the wrong repository and apply its diff here. Without an entry a GitHub remote passes its own
    `owner/repo`: `codex cloud exec --env` also takes an environment's name, and chatgpt.com/codex names a new
    environment after its repository (2026-10-31).
    """
    env_label = os.environ.get("LANES_CODEX_CLOUD_ENV", "").strip()
    if env_label:
        return env_label
    config_path = os.path.join(config_dir(), "cloud.json")
    try:
        with open(config_path, "r", encoding="utf-8") as stream:
            config = json.load(stream)
    except FileNotFoundError:
        config = {}
    except (OSError, ValueError) as exc:
        raise LaneError("cannot read Codex Cloud setup file {}: {}".format(config_path, exc), 8)
    if not isinstance(config, dict):
        config = {}
    slug = cloud_repo_slug(remote_url)
    envs = config.get("codex_envs")
    if slug and isinstance(envs, dict):
        for key, value in envs.items():
            if isinstance(key, str) and key.strip().lower() == slug and isinstance(value, str) and value.strip():
                return value.strip()
    single = config.get("codex_env")
    if slug is None and isinstance(single, str) and single.strip():
        return single.strip()
    if slug:
        return cloud_repo_slug(remote_url, keep_case=True)
    raise LaneError("codex-cloud needs an environment: create a Codex environment at chatgpt.com/codex/settings/"
                    "environments, then, as this remote is not on GitHub, add its id or name to {} as "
                    "{{\"codex_env\": \"<environment id>\"}} or set LANES_CODEX_CLOUD_ENV".format(config_path), 8)


def cloud_remote_refs(path, deadline=None):
    args = ["ls-remote", "origin", "refs/heads/*"]
    result = cloud_git(path, args, timeout=120) if deadline is None else cloud_git_until(path, args, deadline, 120)
    if result.returncode:
        raise LaneError("cannot read origin branches for cloud run", 8)
    refs = {}
    for line in cloud_output(result).splitlines():
        parts = line.split("\t", 1)
        if len(parts) == 2 and parts[1].startswith("refs/heads/"):
            refs[parts[1][len("refs/heads/"):]] = parts[0]
    return refs


def cloud_preflight(lane_name, path):
    result = cloud_preflight_git(path, ["rev-parse", "--is-inside-work-tree"])
    if result.returncode or result.stdout.strip() != b"true":
        raise LaneError("cloud runs require DIR to be a git work tree", 8)
    top = cloud_preflight_git(path, ["rev-parse", "--show-toplevel"])
    if top.returncode:
        raise LaneError("cannot locate the git work tree root for cloud preflight", 8)
    worktree_root = cloud_output(top)
    status = cloud_preflight_git(worktree_root, ["status", "--porcelain", "--untracked-files=all"])
    if status.returncode:
        raise LaneError("cannot read git status for cloud preflight", 8)
    if status.stdout.strip():
        raise LaneError("cloud runs require a clean work tree (git status --porcelain is not empty)", 8)
    branch_result = cloud_preflight_git(path, ["symbolic-ref", "--quiet", "--short", "HEAD"])
    if branch_result.returncode:
        raise LaneError("cloud runs require a checked out branch (detached HEAD is not supported)", 8)
    branch = cloud_output(branch_result)
    remote_result = cloud_preflight_git(path, ["remote", "get-url", "origin"])
    if remote_result.returncode or not cloud_output(remote_result):
        raise LaneError("cloud runs require a git remote named origin", 8)
    remote_url = cloud_output(remote_result)
    if lane_name in CLAUDE_LANES and os.environ.get("LANES_CLOUD_ANY_REMOTE") != "1" and not cloud_url_is_github(remote_url):
        raise LaneError("Claude cloud runs need the repository on GitHub with the Claude GitHub App installed.", 8)
    if lane_name in CLAUDE_LANES and claude_app_missing(remote_url):
        raise LaneError("the Claude GitHub App is not installed on the GitHub organization of {}: install it "
                        "(github.com/apps/claude) with access to this repository, or the cloud session cannot push "
                        "its work".format(cloud_repo_slug(remote_url)), 8)
    base_result = cloud_preflight_git(path, ["rev-parse", "HEAD"])
    if base_result.returncode:
        raise LaneError("cannot read HEAD for cloud preflight", 8)
    remote_branch = cloud_preflight_git(path, ["ls-remote", "origin", "refs/heads/" + branch], timeout=120)
    if remote_branch.returncode:
        raise LaneError("cannot check the origin branch for cloud preflight", 8)
    existed = any(line.split("\t", 1)[-1] == "refs/heads/" + branch
                  for line in cloud_output(remote_branch).splitlines())
    env_label = codex_cloud_env(remote_url) if lane_name == "codex-cloud" else None
    return {"base": cloud_output(base_result), "branch": branch, "remote_url": remote_url,
            "remote_existed": existed, "env": env_label}


def cloud_run_component(run_id):
    if run_id and re.fullmatch(r"[A-Za-z0-9._-]+", run_id) and ".." not in run_id and not run_id.endswith("."):
        return run_id
    cleaned = re.sub(r"[^A-Za-z0-9._-]", "_", run_id).strip(".")
    if not cleaned or ".." in cleaned:
        cleaned = "run-" + str(abs(hash(run_id)))
    return cleaned


CLOUD_PUSH_ATTEMPTS = 3
CLOUD_BASE_STALE_S = 24 * 3600


def cloud_remote_head(path, branch, deadline=None):
    args = ["ls-remote", "origin", "refs/heads/" + branch]
    try:
        result = cloud_git(path, args, timeout=120) if deadline is None else cloud_git_until(path, args, deadline, 120)
    except LaneError:
        return None
    if result.returncode:
        return None
    for line in cloud_output(result).splitlines():
        sha, _, ref = line.partition("\t")
        if ref == "refs/heads/" + branch:
            return sha
    return None


def cloud_base_dir(plan):
    key = hashlib.sha256("{}\n{}".format(plan["remote_url"], plan["branch"]).encode("utf-8")).hexdigest()[:16]
    return os.path.join(state_dir(), "cloud-bases", key)


def cloud_base_marker(plan, run_id):
    return os.path.join(cloud_base_dir(plan), "run-" + cloud_run_component(run_id))


def cloud_claim_base(plan, run_id):
    """Record, before the push, that this run uses the base branch, so a sibling run's cleanup keeps it.

    `created` marks a branch lane put on origin; the last run to finish deletes it. A branch that was on origin
    before any lane run has no `created` and is never deleted.
    """
    folder = cloud_base_dir(plan)
    try:
        os.makedirs(folder, exist_ok=True)
        with open(cloud_base_marker(plan, run_id), "w", encoding="utf-8") as stream:
            stream.write(plan["base"] + "\n")
        created = os.path.join(folder, "created")
        if not plan["remote_existed"] and not os.path.exists(created):
            with open(created, "w", encoding="utf-8") as stream:
                stream.write(plan["base"] + "\n")
    except OSError:
        pass


def cloud_release_base(path, plan, run_id):
    """Drop this run's claim; True when it should delete the base branch (lane created it, nobody else uses it)."""
    marker = cloud_base_marker(plan, run_id)
    if not os.path.exists(marker):
        return False
    try:
        os.remove(marker)
    except OSError:
        return False
    if not plan.get("base_pushed", True):
        return False
    folder = cloud_base_dir(plan)
    created = os.path.join(folder, "created")
    if not os.path.exists(created):
        return False
    bases = {plan["base"]}
    try:
        names = os.listdir(folder)
    except OSError:
        return False
    for name in names:
        full = os.path.join(folder, name)
        try:
            with open(full, "r", encoding="utf-8") as stream:
                bases.add(stream.read().strip())
            fresh = time.time() - os.path.getmtime(full) < CLOUD_BASE_STALE_S
        except OSError:
            continue
        if name.startswith("run-") and fresh:
            return False
    # Work someone pushed to the branch since lane created it keeps the branch.
    if cloud_remote_head(path, plan["branch"]) not in bases:
        return False
    try:
        os.remove(created)
    except OSError:
        pass
    return True


def cloud_push_branch(path, plan, deadline=None, run_id=None):
    if run_id:
        cloud_claim_base(plan, run_id)
    args = ["push", "origin", "HEAD:refs/heads/" + plan["branch"]]
    detail = ""
    for attempt in range(1, CLOUD_PUSH_ATTEMPTS + 1):
        result = cloud_git(path, args, timeout=120) if deadline is None else cloud_git_until(path, args, deadline, 120)
        if not result.returncode:
            return
        # Two cloud runs started together on one repository push the same branch at once; the loser's push can
        # fail although the commit it wanted is already there (2026-10-31: REFUSED 2 s after a sibling's push).
        if cloud_remote_head(path, plan["branch"], deadline) == plan["base"]:
            return
        lines = result.stderr.decode("utf-8", "replace").strip().splitlines()
        detail = re.sub(r"://[^@/\s]+@", "://", lines[-1]) if lines else ""
        wait = 2.0 * attempt
        if attempt == CLOUD_PUSH_ATTEMPTS or (deadline is not None and time.monotonic() + wait >= deadline):
            break
        time.sleep(wait)
    raise LaneError("could not push the cloud base branch to origin" + (" ({})".format(detail) if detail else ""), 8)


def cloud_cleanup(path, plan, result_branch, run_id):
    if os.environ.get("LANES_CLOUD_KEEP") == "1":
        return
    branches = []
    if result_branch:
        branches.append(result_branch)
    if cloud_release_base(path, plan, run_id):
        branches.append(plan["branch"])
    for branch in dict.fromkeys(branches):
        try:
            cloud_git(path, ["push", "origin", "--delete", branch], timeout=120)
        except LaneError:
            pass
    namespace = "refs/lane-cloud/{}/".format(cloud_run_component(run_id))
    try:
        refs = cloud_git(path, ["for-each-ref", "--format=%(refname)", namespace])
    except LaneError:
        return
    if refs.returncode == 0:
        for ref in cloud_output(refs).splitlines():
            try:
                cloud_git(path, ["update-ref", "-d", ref])
            except LaneError:
                pass


def cloud_apply_diff(path, diff_path, diff_bytes, deadline):
    with open(diff_path, "wb") as stream:
        stream.write(diff_bytes)
    if not diff_bytes:
        return
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise LaneError("cloud run timed out before applying cloud.diff", 124, "TIMEOUT")
    applied = cloud_git(path, ["apply", "--binary", diff_path], timeout=max(0.1, remaining))
    if applied.returncode:
        raise LaneError("could not apply cloud.diff; the diff is kept at {}".format(diff_path), 4, "FAILED")


def cloud_sleep(poll, deadline):
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise LaneError("cloud run timed out", 124, "TIMEOUT")
    if poll:
        time.sleep(min(poll, remaining))


def cloud_write_log(path, data):
    with open(path, "wb") as stream:
        stream.write(data)


def cloud_env_timeout(name, default, minimum=0):
    raw = os.environ.get(name, str(default))
    try:
        value = float(raw)
    except (TypeError, ValueError, OverflowError):
        raise LaneError("{} must be a number".format(name), 8)
    if not math.isfinite(value) or value < minimum:
        raise LaneError("{} must be at least {}".format(name, minimum), 8)
    return value


def cloud_update_meta(meta, meta_path, cloud):
    meta["cloud"] = cloud
    write_meta(meta_path, meta)


def lane_term_path():
    override = os.environ.get("LANES_TERM")
    if override:
        return os.path.abspath(os.path.expanduser(override))
    here = os.path.dirname(os.path.realpath(__file__))
    python_runner = os.path.join(here, "lane-term.py")
    return python_runner if os.path.isfile(python_runner) else os.path.join(here, "lane-term")


# Step 2 of a --verify run: the session only runs the brief's commands and reports their real output.
VERIFY_STEP = (
    '2. Run each command the brief lists, from the repository root, in order, with the brief\'s timeouts. Do not\n'
    '   edit, create or delete tracked files, and commit nothing but the two lane markers. The report holds, per\n'
    '   command, the command, its exit code and the last 40 lines of its combined output verbatim. If every command\n'
    '   exited 0 the done subject is "lane: done {}"; otherwise it is\n'
    '   "lane: done {} PARTIAL: <k> of <n> commands failed".\n')


# Step 2 of a utilization-mode --verify run: the same report, with independent commands and test shards in parallel.
PARALLEL_VERIFY_STEP = (
    '2. Run each command the brief lists, from the repository root, with the brief\'s timeouts. Run independent\n'
    '   commands at the same time as background processes, and split a command that runs the whole test suite into\n'
    '   up to 4 parallel shards by test module, run instead of the whole command, never beside it (two runs in one\n'
    '   checkout share temporary files and fail each other). Build the shards from one list: list the test files\n'
    '   once, give each file to exactly one shard, with no overlapping patterns (so no file runs twice and none is\n'
    '   skipped), and run each shard by naming its test modules or files. The shards cover the list exactly, so\n'
    '   their test counts add up to the whole suite. Do not edit, create or delete tracked files, and commit nothing\n'
    '   but the two lane markers. The report holds, per command, and per shard as its own command in place of the\n'
    '   command it splits, its command line, its exit code and the last 40 lines of its combined output verbatim, and\n'
    '   for each shard the list of files it ran.\n'
    '   If every command exited 0 the done subject is "lane: done {}"; otherwise it is\n'
    '   "lane: done {} PARTIAL: <k> of <n> commands failed", where each shard counts as a command.\n')


# Step 2 of a normal cloud run: the VM has room, and a subagent keeps file dumps out of the main context.
SUBAGENT_STEP = (
    '2. Do the task. Commit all your changes; leave nothing uncommitted.\n'
    '   Use subagents (the Agent tool) for as much of the work as splits off: reading and searching files, edits to\n'
    '   separate files, and running independent test modules. Start independent subagents in one message so they\n'
    '   run in parallel, give each a narrow, self-contained brief, and pass model "{}" (a read-only search may use\n'
    '   "haiku"). Keep the plan, your review of every subagent\'s result and the commits yourself. In a cloud run this\n'
    '   replaces the worker rule against starting agents; workflows and other lanes stay off.\n')


# Step 2 in utilization mode: the shortest time to a usable result, with usage no limit.
UTILIZATION_STEP = (
    '2. Do the task. Commit all your changes; leave nothing uncommitted.\n'
    '   Split the task into as many independent parts as it has and hand them to subagents (the Agent tool), all\n'
    '   started in one message so they run in parallel; split a test suite by module across parallel subagents or\n'
    '   background processes. Pass model "{}" (a read-only search may use "haiku"). The goal is the shortest time\n'
    '   to a usable result; usage is not the limit. Keep the plan, your review of every subagent\'s result and the\n'
    '   commits yourself. In a cloud run this replaces the worker rule against starting agents; workflows and other\n'
    '   lanes stay off.\n')


# Step 2 in saving mode: haiku reads, the session edits, and the suite runs once.
SAVING_STEP = (
    '2. Do the task. Commit all your changes; leave nothing uncommitted.\n'
    '   Use subagents only for reading and searching, with model "haiku"; make the edits yourself and run the test\n'
    '   suite once, at the end. In a cloud run this replaces the worker rule against starting agents; workflows and\n'
    '   other lanes stay off.\n')


def claude_cloud_prompt(sent_text, run_id, alias, verify=False, mode="default"):
    if verify:
        step2 = (PARALLEL_VERIFY_STEP if mode == "utilization" else VERIFY_STEP).format(run_id, run_id)
    else:
        step2 = {"utilization": UTILIZATION_STEP, "saving": SAVING_STEP}.get(mode, SUBAGENT_STEP).format(alias)
    # A verify report is the commands' verbatim output, which a subagent's summary would paraphrase.
    report_tail = ' Then run\n' if verify else (
        '\n   The report also has a line starting "Subagents: <n>" (0 when none), then one short line per subagent\n'
        '   saying what it did. Then run\n')
    cloud_block = (
        'CLOUD RUN {}. Follow these git steps exactly; the caller reads your result only from git.\n'
        '1. Before any other step run: git commit --allow-empty -m "lane: start {}" && git push -u origin HEAD\n'
        + step2 +
        '3. As your very last step, write your final report to a file outside the repository (for example in the\n'
        '   system temp directory). Its first line is exactly "lane: done {}", then a blank line, then the report:\n'
        '   the full return contract the brief asks for, not a summary.'
        + report_tail +
        '   git commit --allow-empty -F <that file> && git push origin HEAD\n'
        '   If you could not finish, the first line is "lane: done {} PARTIAL: <one-line reason>" instead.\n'
        'Do not open a pull request. Do not push to any other branch.').format(run_id, run_id, run_id, run_id)
    return sent_text + "\n\n" + WORKER_BLOCK + " " + WORKER_KIND_SENTENCE + "\n\n" + cloud_block


# Keys sent on a dialog's first paint can be lost to a redraw that resets the choice; seven no-op Left presses
# (about 2 s) let it settle first.
SETTLE_KEYS = "left," * 7


def claude_cloud_command(executable, term, path, prefix, sent_text, run_id, model, effort, verify=False, alias=None,
                         mode="default", prompt=None):
    # alias is the lane name; without it, take it from the model id (claude-haiku-5-5 -> haiku).
    alias = alias or next((name for name in CLAUDE_LANES if name in model), "sonnet")
    # `lane main` passes its own prompt (MAIN_HEAD and the policy), not a worker's.
    if prompt is None:
        prompt = claude_cloud_prompt(sent_text, run_id, alias, verify, mode)
    claude_argv = launch_prefix(executable or "claude")
    return [sys.executable, term, "--out", prefix, "--cwd", path, "--max", "180",
            "--answer", "Yes, I trust this folder=" + SETTLE_KEYS + "down,enter",
            # ~/.claude/CLAUDE.md imports the kit's POLICY.md from outside the folder; keep the preselected No.
            "--answer", "external CLAUDE.md file imports=" + SETTLE_KEYS + "enter",
            "--until", "Resume with:",
            "--grace", "2", "--"] + claude_argv + ["--cloud", prompt,
                                                        "--model", model, "--effort", effort,
                                                        # Without a mode the cloud session starts in acceptEdits.
                                                        "--permission-mode",
                                                        os.environ.get("LANES_CLOUD_PERMISSION_MODE", "auto")]


def cloud_dry_run(opts, path, outdir, sent_text, sent_bytes, model, effort, executable, plan, mode="default",
                  side_reason=None):
    run_id = os.path.basename(os.path.normpath(outdir))
    print("cloud preflight: PASS")
    print("precondition: git work tree: PASS ({})".format(path))
    print("precondition: clean branch: PASS ({})".format(plan["branch"]))
    print("precondition: origin: PASS ({})".format(plan["remote_url"]))
    print("base: {}".format(plan["base"]))
    if side_reason:
        print("side session: {} (a main cloud session is live for this repository)".format(side_reason))
    push = ["git", "-C", path, "push", "origin", "HEAD:refs/heads/" + plan["branch"]]
    print("push: {}".format(json.dumps(push, ensure_ascii=False)))
    if opts.cloud:
        term = lane_term_path()
        prefix = os.path.join(outdir, "cloud-screen")
        launch = claude_cloud_command(executable, term, path, prefix, sent_text, run_id, model, effort,
                                      opts.verify, opts.lane, mode)
        print("launch: {}".format(json.dumps(launch, ensure_ascii=False)))
        print("poll: {} every {} seconds until lane: start/done markers".format(
            json.dumps(["git", "-C", path, "ls-remote", "origin", "refs/heads/*"]),
            os.environ.get("LANES_CLOUD_POLL", "30")))
        print("apply: {}".format(json.dumps(["git", "-C", path, "apply", "--binary",
                                             os.path.join(outdir, "cloud.diff")], ensure_ascii=False)))
    else:
        launch = launch_prefix(executable or "codex") + ["cloud", "exec", "--env", plan["env"],
                                                           "--branch", plan["branch"], "-"]
        print("launch: {}".format(json.dumps(launch, ensure_ascii=False)))
        print("stdin: {}".format(json.dumps(sent_bytes.decode("utf-8"), ensure_ascii=False)))
        print("poll: {}".format(json.dumps(launch_prefix(executable or "codex") +
                                           ["cloud", "status", "<task-id-from-launch>"])))
        print("diff: {}".format(json.dumps(launch_prefix(executable or "codex") +
                                           ["cloud", "diff", "<task-id-from-launch>"])))
        print("apply: {}".format(json.dumps(["git", "-C", path, "apply", "--binary",
                                             os.path.join(outdir, "cloud.diff")], ensure_ascii=False)))
    print("dry-run: no push or cloud launch performed")
    return 0


def cloud_fetch_branch(path, run_id, branch, deadline):
    destination = "refs/lane-cloud/{}/{}".format(cloud_run_component(run_id), branch)
    result = cloud_git_until(path, ["fetch", "--quiet", "--no-tags", "origin",
                                    "+refs/heads/{}:{}".format(branch, destination)], deadline, 120)
    return result.returncode == 0, destination


def cloud_commit_subject(path, ref, deadline=None):
    args = ["log", "-1", "--format=%s", ref]
    result = cloud_git(path, args) if deadline is None else cloud_git_until(path, args, deadline, 30)
    return cloud_output(result) if result.returncode == 0 else None


def cloud_commit_body(path, ref, deadline):
    result = cloud_git_until(path, ["log", "-1", "--format=%b", ref], deadline, 30)
    if result.returncode:
        print("warning: could not read the cloud report from {}; the verdict is unchanged".format(ref), file=sys.stderr)
        return None
    return cloud_output(result) or None


def cloud_ref_head(path, ref, deadline=None):
    """(sha, subject) of a ref's tip, read in one call so both always describe the same commit.

    A fetch can move its ref and still exit non-zero; reading the done marker's subject from the moved ref while
    keeping the last sha seen gave an empty diff and a false NOOP on 2026-10-31 (the work was on the branch).
    """
    args = ["log", "-1", "--format=%H%x09%s", ref]
    result = cloud_git(path, args) if deadline is None else cloud_git_until(path, args, deadline, 30)
    if result.returncode:
        return None
    sha, _, subject = cloud_output(result).partition("\t")
    return (sha, subject) if sha else None


def run_claude_cloud(opts, path, outdir, sent_text, model, effort, executable, plan,
                     meta, meta_path, log_path):
    run_id = os.path.basename(os.path.normpath(outdir))
    deadline = time.monotonic() + opts.timeout
    poll = cloud_poll_interval()
    start_timeout = cloud_env_timeout("LANES_CLOUD_START_TIMEOUT", 600, 0.01)
    cloud = meta["cloud"]
    base_pushed = False
    result_branch = None
    preserve = False
    try:
        prefix = os.path.join(outdir, "cloud-screen")
        screen_path = prefix + ".txt"
        term = lane_term_path()
        if not os.path.isfile(term):
            raise LaneError("lane-term was not found at {}; install bin/lane-term or set LANES_TERM".format(term), 4, "FAILED")
        command = claude_cloud_command(executable, term, path, prefix, sent_text, run_id, model, effort,
                                       opts.verify, opts.lane, meta.get("mode") or "default")
        if IS_WINDOWS and windows_command_line_length(command) > WINDOWS_COMMAND_LINE_LIMIT:
            raise LaneError("the command line exceeds the Windows limit of 32,767 characters; a Claude cloud run passes "
                            "the brief as an argument, so shorten the brief or use codex-cloud", 8)
        meta["cmd"] = command
        cloud_update_meta(meta, meta_path, cloud)
        cloud_push_branch(path, plan, deadline, run_id)
        base_pushed = True
        before_refs = cloud_remote_refs(path, deadline)
        source_env = os.environ
        child_env = {name: value for name, value in source_env.items()
                     if name.upper() == "CLAUDE_CODE_OAUTH_TOKEN"
                     or (name.upper() != "CLAUDECODE" and not name.upper().startswith("CLAUDE_CODE_"))}
        child_env["CLAUDE_CODE_DISABLE_AUTO_MEMORY"] = "1"
        mark_launched(meta, meta_path)
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise LaneError("cloud run timed out before launch", 124, "TIMEOUT")
        launched = cloud_process(command, cwd=path, timeout=min(180, remaining), env=child_env)
        if os.path.isfile(screen_path):
            with open(screen_path, "rb") as stream:
                screen = stream.read()
        else:
            screen = b""
        cloud_write_log(log_path, screen)
        screen_text = screen.decode("utf-8", "replace")
        cloud_id_match = re.search(r"session_[A-Za-z0-9]+", screen_text)
        url_match = re.search(r"https://claude\.ai/code/session_[A-Za-z0-9]+(?:\?[^\s]+)?", screen_text)
        if cloud_id_match:
            cloud["session_id"] = cloud_id_match.group(0)
            meta["session_id"] = cloud["session_id"]
        if url_match:
            cloud["url"] = url_match.group(0).rstrip(".,)")
        cloud_update_meta(meta, meta_path, cloud)
        if launched.returncode:
            raise LaneError("lane-term could not run Claude; screen: {}".format(screen_path), 4, "FAILED")
        if not cloud.get("session_id") or not cloud.get("url"):
            raise LaneError("Claude cloud session was not found in {}; see that screen file".format(screen_path), 4, "FAILED")
        start_deadline = min(deadline, time.monotonic() + start_timeout)
        seen_refs = before_refs
        local_ref = None
        fetched_sha = None
        done_subject = None
        while True:
            refs = cloud_remote_refs(path, deadline)
            if result_branch is None:
                for branch, sha in refs.items():
                    if sha == seen_refs.get(branch):
                        continue
                    fetched, local_ref_candidate = cloud_fetch_branch(path, run_id, branch, deadline)
                    if not fetched:
                        continue
                    commits = cloud_git_until(path, ["log", "--format=%H%x09%s",
                                                     "{}..{}".format(plan["base"], local_ref_candidate)], deadline, 30)
                    marker = "lane: start " + run_id
                    starts = [line.split("\t", 1)[0] for line in cloud_output(commits).splitlines()
                              if line.split("\t", 1)[1:] == [marker]] if commits.returncode == 0 else []
                    if starts:
                        # The diff is taken from the (oldest) start marker, not from our base: a session that cloned
                        # another commit would otherwise hand back the difference between the two as its work.
                        result_branch, local_ref, fetched_sha = branch, local_ref_candidate, sha
                        cloud.update({"result_branch": branch, "result_sha": sha, "start_sha": starts[-1]})
                        parent = cloud_git_until(path, ["rev-parse", starts[-1] + "^"], deadline, 30)
                        cloud["started_from"] = cloud_output(parent) if parent.returncode == 0 else None
                        if cloud["started_from"] != plan["base"]:
                            print("warning: the cloud session started from {}, not the pushed base {}; the diff is "
                                  "taken from its start marker".format(cloud["started_from"], plan["base"]),
                                  file=sys.stderr)
                        cloud_update_meta(meta, meta_path, cloud)
                        break
                seen_refs = refs
            if result_branch is not None:
                sha = refs.get(result_branch)
                if sha is None:
                    cloud_sleep(poll, deadline)
                    continue
                if sha != fetched_sha:
                    fetched, local_ref_candidate = cloud_fetch_branch(path, run_id, result_branch, deadline)
                    if fetched:
                        local_ref, fetched_sha = local_ref_candidate, sha
                head = cloud_ref_head(path, local_ref, deadline)
                done_subject = head[1] if head else None
                if done_subject and done_subject.startswith("lane: done " + run_id):
                    result_sha = head[0]
                    cloud.update({"result_branch": result_branch, "result_sha": result_sha})
                    cloud_update_meta(meta, meta_path, cloud)
                    diff_result = cloud_git_until(path, ["diff", "--binary", cloud["start_sha"], result_sha],
                                                  deadline, 30)
                    if diff_result.returncode:
                        raise LaneError("could not collect the Claude cloud diff", 4, "FAILED")
                    diff_path = os.path.join(outdir, "cloud.diff")
                    if opts.verify:
                        # A verifier changes nothing: an empty diff is the normal case, and any diff is kept, never
                        # applied; the verdict follows the marker either way.
                        with open(diff_path, "wb") as stream:
                            stream.write(diff_result.stdout)
                        if diff_result.stdout:
                            print("warning: verify run changed files; cloud.diff kept, not applied", file=sys.stderr)
                    else:
                        cloud_apply_diff(path, diff_path, diff_result.stdout, deadline)
                    if not diff_result.stdout and not opts.verify:
                        verdict, exit_code = "NOOP", 3
                    elif "PARTIAL:" in done_subject:
                        verdict, exit_code = "PARTIAL", 6
                    else:
                        verdict, exit_code = "OK", 0
                    report = cloud_commit_body(path, result_sha, deadline)
                    if report:
                        report_path = os.path.join(outdir, "report.md")
                        with open(report_path, "w", encoding="utf-8", newline="\n") as stream:
                            stream.write(report + "\n")
                        cloud["report"] = report_path
                        found = re.search(r"^Subagents:\s*(\d+)", report, re.IGNORECASE | re.MULTILINE)
                        if found:
                            cloud["subagents"] = int(found.group(1))
                        cloud_update_meta(meta, meta_path, cloud)
                        print("lane: cloud report saved to {}".format(report_path))
                        if opts.verify:
                            print(report)
                    return verdict, exit_code, cloud["session_id"], screen_text, screen_text
            now = time.monotonic()
            if now >= deadline:
                raise LaneError("Claude cloud run timed out. Session: {}".format(cloud["url"]), 124, "TIMEOUT")
            if result_branch is None and now >= start_deadline:
                raise LaneError("no start marker appeared for Claude cloud run; the GitHub App may be missing and "
                                "the session may be running from a bundle. Session: {}".format(cloud["url"]), 4, "FAILED")
            next_deadline = start_deadline if result_branch is None else deadline
            if poll:
                time.sleep(min(poll, max(0, next_deadline - now), deadline - now))
    except LaneError as exc:
        if exc.verdict == "TIMEOUT":
            preserve = True
        raise
    finally:
        if not preserve:
            cleanup_plan = dict(plan)
            cleanup_plan["remote_existed"] = plan["remote_existed"] or not base_pushed
            cleanup_plan["base_pushed"] = base_pushed
            cloud_cleanup(path, cleanup_plan, result_branch, run_id)


def cloud_task_url(text):
    match = re.search(r"https?://[^\s]+", text)
    if not match:
        return None, None
    url = match.group(0).rstrip(".,);]")
    try:
        parts = urlsplit(url)
    except ValueError:
        return None, None
    task_id = parts.path.rstrip("/").rsplit("/", 1)[-1]
    return (url, task_id) if task_id else (None, None)


def cloud_move_error_log(path, outdir, meta, meta_path, cloud, existed):
    # codex cloud writes a debug error.log (it holds the ChatGPT account id) into its working directory.
    # A file the user already had there is theirs and stays where it is.
    error_log = os.path.join(path, "error.log")
    if existed or not os.path.exists(error_log):
        return
    moved = os.path.join(outdir, "codex-error.log")
    try:
        shutil.move(error_log, moved)
    except OSError as exc:
        # Runs inside run_codex_cloud's finally: a failed move must not hide the verdict or skip the branch cleanup.
        print("warning: codex cloud wrote error.log in the workspace (it holds the ChatGPT account id) and it could "
              "not be moved ({}); delete {} before committing".format(exc, error_log), file=sys.stderr)
        return
    cloud["error_log_moved"] = True
    cloud_update_meta(meta, meta_path, cloud)
    print("warning: codex cloud wrote error.log in the workspace (it holds the ChatGPT account id); moved to {}"
          .format(moved), file=sys.stderr)


def run_codex_cloud(opts, path, outdir, sent_bytes, executable, plan, meta, meta_path, log_path):
    run_id = os.path.basename(os.path.normpath(outdir))
    deadline = time.monotonic() + opts.timeout
    poll = cloud_poll_interval()
    cloud = meta["cloud"]
    base_pushed = False
    preserve = False
    log = bytearray()
    error_log_existed = os.path.exists(os.path.join(path, "error.log"))
    try:
        cloud_push_branch(path, plan, deadline, run_id)
        base_pushed = True
        codex_argv = launch_prefix(executable or "codex")
        command = codex_argv + ["cloud", "exec", "--env", plan["env"], "--branch", plan["branch"], "-"]
        meta["cmd"] = command
        cloud_update_meta(meta, meta_path, cloud)
        mark_launched(meta, meta_path)
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise LaneError("cloud run timed out before launch", 124, "TIMEOUT")
        launched = cloud_process(command, cwd=path, timeout=remaining, input_data=sent_bytes)
        output = launched.stdout + (b"\n" + launched.stderr if launched.stderr else b"")
        log.extend(output)
        text = output.decode("utf-8", "replace")
        url, task_id = cloud_task_url(text)
        if launched.returncode or not task_id:
            cloud_write_log(log_path, bytes(log))
            reason = next((line.strip() for line in reversed(text.splitlines()) if line.strip()), "no output")[:200]
            hint = ""
            if "environment" in reason and "not found" in reason:
                hint = (": create and publish an environment for this repository at "
                        "https://chatgpt.com/codex/settings/environments, or, if it has another name, put its name or "
                        "id in {} under codex_envs (`codex cloud`, then o, lists them)".format(
                            os.path.join(config_dir(), "cloud.json")))
            raise LaneError("Codex Cloud did not return a task URL ({}){}; see {}".format(reason, hint, log_path),
                            4, "FAILED")
        cloud.update({"task_id": task_id, "url": url})
        meta["session_id"] = task_id
        cloud_update_meta(meta, meta_path, cloud)
        status_command = codex_argv + ["cloud", "status", task_id]
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise LaneError("Codex Cloud task timed out. Task: {}".format(url), 124, "TIMEOUT")
            status = cloud_process(status_command, cwd=outdir, timeout=remaining)
            status_text = (status.stdout + b"\n" + status.stderr).decode("utf-8", "replace")
            log.extend(("\n" + status_text).encode("utf-8"))
            # Only a status tag counts: the task title, taken from the brief, can contain "error" anywhere.
            if re.search(r"^\s*(?:\[(?:failed|error|cancelled|canceled)\]|status:\s*(?:failed|error|cancelled|canceled)\b)",
                         status_text, re.IGNORECASE | re.MULTILINE):
                cloud_write_log(log_path, bytes(log))
                raise LaneError("Codex Cloud task failed: {}".format(url), 4, "FAILED")
            if status.returncode == 0:
                break
            cloud_write_log(log_path, bytes(log))
            cloud_sleep(poll, deadline)
        diff_command = codex_argv + ["cloud", "diff", task_id]
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise LaneError("Codex Cloud task timed out before collecting its diff", 124, "TIMEOUT")
        diff = cloud_process(diff_command, cwd=outdir, timeout=remaining)
        if diff.returncode:
            raise LaneError("could not collect the Codex Cloud diff", 4, "FAILED")
        diff_path = os.path.join(outdir, "cloud.diff")
        cloud_apply_diff(path, diff_path, diff.stdout, deadline)
        refs = cloud_remote_refs(path, deadline)
        result_sha = refs.get(plan["branch"])
        cloud.update({"result_branch": plan["branch"], "result_sha": result_sha})
        cloud_update_meta(meta, meta_path, cloud)
        log.extend(b"\n" + diff.stdout)
        cloud_write_log(log_path, bytes(log))
        if not diff.stdout:
            verdict, exit_code = "NOOP", 3
        else:
            verdict, exit_code = "OK", 0
        log_text = bytes(log).decode("utf-8", "replace")
        return verdict, exit_code, task_id, log_text, log_text
    except LaneError as exc:
        if exc.verdict == "TIMEOUT":
            preserve = True
        if log:
            cloud_write_log(log_path, bytes(log))
        raise
    finally:
        cloud_move_error_log(path, outdir, meta, meta_path, cloud, error_log_existed)
        if not preserve:
            cleanup_plan = dict(plan)
            cleanup_plan["remote_existed"] = plan["remote_existed"] or not base_pushed
            cleanup_plan["base_pushed"] = base_pushed
            cloud_cleanup(path, cleanup_plan, None, run_id)


def mask_enabled(lane, flag):
    if flag is not None:
        return flag
    return lane == "glm"


def normalized(path):
    return os.path.realpath(os.path.abspath(os.path.expanduser(path)))


def mask_defaults():
    candidates = list(MASK_DEFAULTS)
    if platform.system().lower() == "darwin":
        candidates.extend(MASK_MACOS_DEFAULTS)
    if hasattr(os, "getuid"):
        candidates.append("/tmp/claude-{}".format(os.getuid()))
    return candidates


def overlaps(left, right):
    left = normalized(left)
    right = normalized(right)
    try:
        return os.path.commonpath((left, right)) == left or os.path.commonpath((left, right)) == right
    except ValueError:
        return False


def make_mask_list(lane, dir_path, outdir, executable, executable_origin):
    candidates = mask_defaults() + read_lines(os.path.join(config_dir(), "mask.local"))
    keeps = {normalized(p) for p in KEEP[lane]}
    paths = []
    warnings = []
    seen = set()
    for candidate in candidates:
        path = normalized(candidate)
        if path in keeps:
            continue
        if not os.path.exists(path):
            continue
        if overlaps(path, dir_path):
            raise LaneError("workspace overlaps masked path {}; move DIR outside it or remove that mask entry".format(path), 8)
        if lane in CODEX_LANES and overlaps(path, outdir):
            if path not in warnings:
                warnings.append(path)
            continue
        if executable and overlaps(path, executable):
            if executable_origin == "lane bin folder":
                raise LaneError(
                    "resolved executable {} lies under masked path {}; "
                    "masked lanes refuse this rather than hiding the binary or unmasking that path".format(
                        executable, path), 8)
            else:
                if path not in warnings:
                    warnings.append(path)
                continue
        if path in seen:
            continue
        seen.add(path)
        paths.append(path)
    return paths, warnings


MASK_ENV_ALWAYS = {
    "PATH", "HOME", "USER", "LOGNAME", "SHELL", "LANG", "LANGUAGE", "TERM",
    "COLORTERM", "NO_COLOR", "TZ", "TMPDIR", "XDG_CONFIG_HOME", "XDG_DATA_HOME",
    "XDG_STATE_HOME", "XDG_CACHE_HOME", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY",
    "http_proxy", "https_proxy", "no_proxy", "SSL_CERT_FILE", "SSL_CERT_DIR",
    "NODE_EXTRA_CA_CERTS",
}
MASK_ENV_CONTROL = {"LANE_MASK_HIDE", "LANE_MASK_CHILD_FILE"}


def env_name_allowed(lane, name):
    if name in MASK_ENV_ALWAYS or name.startswith("LC_"):
        return True
    if lane == "glm" and name.startswith("CLINE_"):
        return True
    return False


def filtered_mask_environment(lane, source=None):
    source = os.environ if source is None else source
    return {name: value for name, value in source.items() if env_name_allowed(lane, name)}


def kept_mask_env_names(lane, source=None, include_control=True):
    source = os.environ if source is None else source
    names = {name for name in source if env_name_allowed(lane, name)}
    if include_control:
        names |= MASK_ENV_CONTROL
    return sorted(names)


def state_dir():
    return os.path.abspath(os.path.expanduser(os.environ.get("LANES_STATE", "~/.local/state/lanes")))


def output_dir(lane, dir_path, explicit):
    if explicit:
        return os.path.abspath(os.path.expanduser(explicit))
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d-%H%M%S")
    return os.path.join(state_dir(), "runs", "{}-{}-{}".format(stamp, lane, os.path.basename(os.path.normpath(dir_path))))


def reserve_run_dir(path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    for candidate in [path] + ["{}-{}".format(path, i) for i in range(2, 1000)]:
        try:
            os.mkdir(candidate)
            return candidate
        except FileExistsError:
            continue
    raise LaneError("cannot allocate unique run directory under {}".format(os.path.dirname(path)), 8)


def version_check(lane, executable):
    name = "codex" if lane in CODEX_LANES else None
    if not name:
        return "not applicable"
    if not executable:
        return "{} executable not found in the lane bin folder or on PATH".format(name)
    try:
        version_argv = launch_prefix(executable) + ["--version"]
    except LaneError:
        return "{} --version could not be run".format(name)
    result = run_quiet(version_argv)
    if result is None:
        return "{} --version could not be run".format(name)
    text = (result.stdout + result.stderr).decode("utf-8", "replace")
    if lane in CODEX_LANES:
        match = re.search(r"codex-cli\s+(\d+)\.(\d+)\.(\d+)", text)
        if not match:
            return "unable to parse codex --version (refused)"
        version = tuple(int(part) for part in match.groups())
        minimum = CODEX_MIN_VERSION[lane]
        if version < minimum:
            return "codex {} is too old for the {} lane; upgrade to {} or newer because older clients report a 400 as an account refusal".format(
                ".".join(map(str, version)), lane, ".".join(map(str, minimum)))
        return "codex version {} accepted".format(".".join(map(str, version)))


def check_version_or_raise(lane, executable):
    result = version_check(lane, executable)
    if lane in CODEX_LANES and any(marker in result for marker in ("refused", "too old", "not found", "could not")):
        raise LaneError(result, 8)
    return result


def nested_values(obj):
    if isinstance(obj, dict):
        for key, value in obj.items():
            yield key, value
            yield from nested_values(value)
    elif isinstance(obj, list):
        for value in obj:
            yield from nested_values(value)


def strip_ansi(text):
    return ANSI_CSI_RE.sub("", text)


def parse_json_objects(text):
    decoder = json.JSONDecoder()
    found = []
    for index, char in enumerate(text):
        if char != "{":
            continue
        try:
            value, end = decoder.raw_decode(text[index:])
        except ValueError:
            continue
        if isinstance(value, dict):
            found.append((index, end, value))
    top_level = []
    for candidate in found:
        start, end, value = candidate
        if any(other[0] < start and other[0] + other[1] >= start + end for other in found):
            continue
        top_level.append((start, value))
    return [entry[1] for entry in top_level]


def last_gemini_object(text):
    objects = parse_json_objects(text)
    return objects[-1] if objects else {}


def usage_window(label, percent, reset):
    try:
        percent = float(percent)
    except (TypeError, ValueError, OverflowError):
        return None
    if not isinstance(label, str) or not label or not 0 <= percent <= 100:
        return None
    return {"label": label, "used_percent": percent, "resets_at": reset}


# usage-status --json lists the plan-window changes of the last week as "window_changes"; run_lane prints them
# in one warning line after the run.
WINDOW_CHANGES = {}


def note_window_changes(data):
    items = data.get("window_changes") if isinstance(data, dict) else None
    for item in items if isinstance(items, list) else []:
        if isinstance(item, dict) and isinstance(item.get("text"), str) and item["text"].strip():
            WINDOW_CHANGES.setdefault(" ".join(item["text"].split()), None)


def window_change_warning():
    return "; ".join(WINDOW_CHANGES) or None


def read_usage(provider):
    if os.environ.get("LANE_NO_USAGE") == "1":
        return None, "disabled"
    if provider == "cline":
        return None, "no meter"
    prefix = [sys.executable, sibling_script("usage-status")]
    if provider == "codex":
        run_quiet(prefix + ["--codex-refresh"], timeout=45)
    command = prefix + ["--json"]
    if provider != "gemini":
        command.append("--no-agy")
    try:
        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                timeout=45, check=False)
    except subprocess.TimeoutExpired:
        return None, "usage-status timed out"
    except OSError:
        return None, "usage-status unavailable"
    if result.returncode:
        return None, "usage-status exited {}".format(result.returncode)
    try:
        data = json.loads(result.stdout)
    except (ValueError, UnicodeError):
        return None, "invalid usage-status JSON"
    note_window_changes(data)
    section = data.get("agy" if provider == "gemini" else provider) if isinstance(data, dict) else None
    if not isinstance(section, dict):
        return None, "no {} reading".format(provider)
    windows = []
    observed = utc_now()
    age = section.get("age_seconds")
    status = section.get("status") or "ok"
    if provider == "codex":
        raw_windows = section.get("windows")
        for item in raw_windows if isinstance(raw_windows, list) else []:
            if isinstance(item, dict):
                windows.append(usage_window(item.get("label"), item.get("used_percent"), item.get("resets_at")))
        reading = section.get("reading")
        timestamp = reading.get("timestamp") if isinstance(reading, dict) else None
        # Live codex JSON exposes the age but no timestamp; rollout readings include one.
        if timestamp:
            observed = timestamp
        elif isinstance(age, (int, float)) and 0 <= age < 10 ** 10:
            observed = (datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(seconds=age)).isoformat(
                timespec="seconds").replace("+00:00", "Z")
    elif provider == "claude":
        reading = section.get("reading")
        if not isinstance(reading, dict):
            return None, "no claude reading"
        observed = reading.get("observed_at")
        raw_windows = section.get("windows")
        for key, label in (("five_hour", "5h"), ("seven_day", "weekly")):
            item = raw_windows.get(key) if isinstance(raw_windows, dict) else None
            if isinstance(item, dict):
                windows.append(usage_window(label, item.get("used_percentage"), item.get("resets_at")))
        status = "stale" if section.get("stale") else "ok"
    else:
        if section.get("error") or section.get("exit_code", 0) != 0:
            return None, "agy meter failed"
        age = 0
        buckets = section.get("buckets")
        for item in buckets if isinstance(buckets, list) else []:
            if not isinstance(item, dict):
                continue
            label = item.get("id") or item.get("window") or "bucket"
            window = item.get("window")
            if label in ("gemini-weekly", "gemini-5h") and window in ("weekly", "5h"):
                # The Gemini models' own pool: the labels lane-stats attributes.
                label = window
            elif isinstance(label, str) and isinstance(window, str) and window not in label:
                label = "{} {}".format(label, window)
            windows.append(usage_window(label, item.get("used_percentage"), item.get("reset_time")))
    windows = [item for item in windows if item is not None]
    if not windows:
        return None, "no {} windows".format(provider)
    snapshot = {"observed_at": observed, "age_seconds": age, "status": status, "windows": windows}
    if provider == "codex" and isinstance(section.get("plan_type"), str):
        snapshot["plan"] = section["plan_type"]
    return snapshot, None


def snapshot_projected(snapshot, now=None):
    """Projected weekly % at reset from a read_usage snapshot, as lane-stats provider_pace computes it."""
    windows = snapshot.get("windows") if isinstance(snapshot, dict) else None
    weekly = next((item for item in windows or [] if isinstance(item, dict) and item.get("label") == "weekly"), None)
    if weekly is None:
        return None
    used = weekly.get("used_percent")
    reset = parse_utc(weekly.get("resets_at"))
    if not isinstance(used, (int, float)) or reset is None:
        return None
    now = now or datetime.datetime.now(datetime.timezone.utc)
    elapsed = min(1.0, max(0.05, 1.0 - (reset - now).total_seconds() / (7 * 86400.0)))
    return used / elapsed


def run_mode(setting, snapshot, explore):
    # A fixed setting applies to every provider; auto reads the meter reading lane takes before the run.
    return projected_mode(snapshot_projected(snapshot), explore) if setting == "auto" else setting


def sibling_script(name):
    """The kit tool `name` beside this one, as a file python can run.

    A Windows install keeps each Python tool at bin/<name>.py and puts a bash wrapper at bin/<name>, which python
    cannot run (SyntaxError), so the .py goes first; a checkout and a Linux install have only bin/<name>."""
    folder = os.path.dirname(os.path.realpath(__file__))
    script = os.path.join(folder, name + ".py")
    return script if os.path.isfile(script) else os.path.join(folder, name)


def estimate_eta(lane, model, effort, unit_class, tag, brief_bytes=None):
    if os.environ.get("LANE_NO_ETA") == "1":
        return None
    script = os.environ.get("LANE_STATS")
    if script is None:
        script = sibling_script("lane-stats")
    command = [sys.executable, script, "eta", "--lane", lane, "--model", model]
    for option, value in (("--effort", effort), ("--class", unit_class), ("--tag", tag),
                          ("--brief-bytes", str(brief_bytes) if brief_bytes else None)):
        if value is not None:
            command.extend((option, value))
    command.append("--json")
    try:
        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                timeout=20, check=False)
        if result.returncode:
            return None
        data = json.loads(result.stdout)
    except Exception:
        return None
    if not isinstance(data, dict) or not is_eta_minutes(data.get("minutes")):
        return None
    return data


def is_eta_minutes(value):
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        return False
    try:
        return math.isfinite(value) and value > 0
    except (OverflowError, TypeError, ValueError):
        return False


def format_eta_value(minutes):
    if minutes < 10:
        return "{:.1f}".format(minutes)
    if minutes < 90:
        return "{}".format(int(round(minutes)))
    return "{:.1f} h".format(minutes / 60)


def print_eta(estimate):
    if estimate is None:
        return
    minutes = estimate["minutes"]
    eta_value = format_eta_value(minutes)
    eta_unit = "" if minutes >= 90 else " min"
    p80 = estimate.get("p80_minutes")
    p80_value = format_eta_value(p80) if is_eta_minutes(p80) else "unknown"
    tier = estimate.get("tier") or "unknown"
    if not isinstance(tier, str):
        tier = "unknown"
    run_keys = {"measured": "arm_class", "arm": "arm", "class": "class", "machine": "machine"}
    count = None
    run_key = run_keys.get(tier)
    runs = estimate.get("runs")
    if run_key and isinstance(runs, dict):
        count = runs.get(run_key)
    run_suffix = ", {} runs".format(count) if count is not None else ""
    print("lane: eta ~{}{} (p80 {}; {}{})".format(eta_value, eta_unit, p80_value, tier, run_suffix),
          file=sys.stderr)


def eta_summary_suffix(duration, eta_s):
    if not is_eta_minutes(eta_s):
        return ""
    took_minutes = duration / 60
    took = "{:.1f} h".format(took_minutes / 60) if took_minutes >= 90 else "{:.1f} min".format(took_minutes)
    eta_minutes = eta_s / 60
    eta = format_eta_value(eta_minutes)
    return " | took {}, eta {}".format(took, eta)


def token_count(value):
    return value if isinstance(value, int) and not isinstance(value, bool) and value >= 0 else None


def token_fields(source, aliases):
    counts = {name: next((token_count(source[key]) for key in keys if token_count(source.get(key)) is not None), None)
              for name, keys in aliases.items()}
    if not any(value is not None for value in counts.values()):
        return None
    if counts["total"] is None and all(counts[key] is not None for key in ("input", "cached", "output")):
        counts["total"] = counts["input"] + counts["cached"] + counts["output"]
    return counts


def run_tokens(lane, log_text, stdout_text):
    if lane in CODEX_LANES:
        matches = re.findall(r"tokens used\s*\n\s*([0-9][0-9,]*)", strip_ansi(log_text), re.IGNORECASE)
        return {"input": None, "cached": None, "output": None,
                "total": int(matches[-1].replace(",", ""))} if matches else None
    data = last_gemini_object(strip_ansi(stdout_text or ""))
    if lane in CLAUDE_LANES:
        source = data.get("usage")
        if not isinstance(source, dict):
            return None
        counts = token_fields(source, {"input": ("input_tokens",), "cached": ("cache_read_input_tokens",),
                                       "output": ("output_tokens",), "total": ()})
        creation = token_count(source.get("cache_creation_input_tokens"))
        if creation is not None:
            if counts is None:
                counts = {"input": None, "cached": None, "output": None, "total": None}
            counts["input"] = (counts["input"] or 0) + creation
        if counts is not None and all(counts[key] is not None for key in ("input", "cached", "output")):
            counts["total"] = counts["input"] + counts["cached"] + counts["output"]
        return counts
    if lane == "gemini":
        aliases = {"input": ("input_tokens", "prompt_tokens", "promptTokenCount", "input"),
                   "cached": ("cached_tokens", "cache_read_input_tokens", "cachedContentTokenCount", "cached"),
                   "output": ("output_tokens", "completion_tokens", "candidatesTokenCount", "candidates"),
                   "total": ("total_tokens", "totalTokenCount", "total")}
        for key, source in nested_values(data):
            if key in ("usage", "usageMetadata", "token_usage", "tokens") and isinstance(source, dict):
                counts = token_fields(source, aliases)
                if counts is not None:
                    return counts
    return None


def cgroup_directories():
    """This process's cgroup v2 directory and each parent up to the cgroup root, or None."""
    proc_path = os.environ.get("LANES_PROC_CGROUP", "/proc/self/cgroup")
    cgroup_root = os.path.realpath(os.environ.get("LANES_CGROUP_ROOT", "/sys/fs/cgroup"))
    try:
        with open(proc_path, "r", encoding="utf-8") as stream:
            cgroup_path = next((line.rstrip("\n").split(":", 2)[2] for line in stream
                                if line.startswith("0::")), None)
    except (OSError, UnicodeError, IndexError):
        return None
    if cgroup_path is None:
        return None
    # cgroup paths always use '/', whatever os.sep is.
    directory = os.path.realpath(os.path.join(cgroup_root, cgroup_path.lstrip("/")))
    if directory != cgroup_root and not directory.startswith(cgroup_root + os.sep):
        return None
    directories = []
    while True:
        directories.append(directory)
        if directory == cgroup_root:
            return directories
        parent = os.path.dirname(directory)
        if parent == directory or not parent.startswith(cgroup_root):
            return None
        directory = parent


def cgroup_task_headroom():
    directories = cgroup_directories()
    if directories is None:
        return None
    try:
        headrooms = []
        for directory in directories:
            with open(os.path.join(directory, "pids.max"), "r", encoding="ascii") as stream:
                maximum = stream.read().strip()
            if maximum != "max":
                limit = int(maximum)
                with open(os.path.join(directory, "pids.current"), "r", encoding="ascii") as stream:
                    current = int(stream.read().strip())
                if limit < 0 or current < 0:
                    return None
                headrooms.append(limit - current)
        return min(headrooms) if headrooms else None
    except (OSError, UnicodeError, ValueError, IndexError):
        return None


def task_reserve(lane):
    value = os.environ.get("LANES_PIDS_RESERVE")
    try:
        reserve = int(value) if value is not None else (150 if lane in CODEX_LANES else 40)
    except ValueError:
        raise LaneError("LANES_PIDS_RESERVE must be a non-negative integer", 8)
    if reserve < 0:
        raise LaneError("LANES_PIDS_RESERVE must be non-negative", 8)
    return reserve


def wait_for_task_headroom(lane):
    reserve = task_reserve(lane)
    headroom = cgroup_task_headroom()
    if headroom is None or headroom >= reserve:
        return headroom
    try:
        wait_seconds = int(os.environ.get("LANES_PIDS_WAIT", "600"))
    except ValueError:
        raise LaneError("LANES_PIDS_WAIT must be a non-negative integer", 8)
    if wait_seconds < 0:
        raise LaneError("LANES_PIDS_WAIT must be a non-negative integer", 8)
    # 2026-10-19: a 1,024-task slice refused 203 forks; Codex uses about 80–90 tasks, including 65 core-sized
    # tokio-rt-worker threads; TOKIO_WORKER_THREADS is ignored, so reserve task headroom before every launch.
    print("lane: task headroom {} below reserve {}; waiting up to {}s".format(
        headroom, reserve, wait_seconds), file=sys.stderr)
    deadline = time.monotonic() + wait_seconds
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        time.sleep(min(10, remaining))
        headroom = cgroup_task_headroom()
        if headroom is None or headroom >= reserve:
            return headroom
    raise LaneError("task headroom {} remains below reserve {}".format(headroom, reserve), 70, "BUSY")


def windows_memory_snapshot():
    import ctypes
    from ctypes import wintypes

    class MEMORYSTATUSEX(ctypes.Structure):
        _fields_ = [("dwLength", wintypes.DWORD), ("dwMemoryLoad", wintypes.DWORD),
                    ("ullTotalPhys", ctypes.c_ulonglong), ("ullAvailPhys", ctypes.c_ulonglong),
                    ("ullTotalPageFile", ctypes.c_ulonglong), ("ullAvailPageFile", ctypes.c_ulonglong),
                    ("ullTotalVirtual", ctypes.c_ulonglong), ("ullAvailVirtual", ctypes.c_ulonglong),
                    ("ullAvailExtendedVirtual", ctypes.c_ulonglong)]

    status = MEMORYSTATUSEX()
    status.dwLength = ctypes.sizeof(MEMORYSTATUSEX)
    if not ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(status)):
        return None
    return {"available_mb": status.ullAvailPhys // MB, "total_mb": status.ullTotalPhys // MB, "source": "windows"}


def linux_memory_snapshot():
    values = {}
    with open(os.environ.get("LANES_MEMINFO", "/proc/meminfo"), "r", encoding="ascii") as stream:
        for line in stream:
            name, _, rest = line.partition(":")
            if name in ("MemAvailable", "MemTotal"):
                # meminfo reports kB.
                values[name] = int(rest.split()[0]) * 1024
    if "MemAvailable" not in values or "MemTotal" not in values:
        return None
    available, total, source = values["MemAvailable"], values["MemTotal"], "meminfo"
    # Walk the same cgroup levels as the pids check: a slice's memory.max can be far below the machine's free memory.
    for directory in cgroup_directories() or []:
        try:
            with open(os.path.join(directory, "memory.max"), "r", encoding="ascii") as stream:
                maximum = stream.read().strip()
        except FileNotFoundError:
            continue
        if maximum == "max":
            continue
        limit = int(maximum)
        with open(os.path.join(directory, "memory.current"), "r", encoding="ascii") as stream:
            current = int(stream.read().strip())
        if limit - current < available:
            available, source = max(0, limit - current), "cgroup"
        total = min(total, limit)
    return {"available_mb": available // MB, "total_mb": total // MB, "source": source}


def memory_snapshot():
    fake = os.environ.get("LANES_MEM_FAKE")
    if fake:
        try:
            available, total = (int(part) for part in fake.split(":"))
        except ValueError:
            return None
        return {"available_mb": available, "total_mb": total, "source": "fake"}
    try:
        if IS_WINDOWS:
            return windows_memory_snapshot()
        if platform.system().lower() == "linux":
            return linux_memory_snapshot()
    except (OSError, UnicodeError, ValueError, IndexError, AttributeError):
        return None
    return None


def positive_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and value > 0


def memory_config(catalog):
    config = dict(MEMORY_DEFAULTS, lane_mb=dict(MEMORY_DEFAULTS["lane_mb"]))
    explore = catalog.get("explore") if isinstance(catalog, dict) else None
    block = explore.get("memory") if isinstance(explore, dict) else None
    if not isinstance(block, dict):
        return config
    if isinstance(block.get("lane_mb"), dict):
        config["lane_mb"].update({name: value for name, value in block["lane_mb"].items() if positive_number(value)})
    for key in ("default_mb", "reserve_mb", "reserve_fraction", "recent_runs", "min_runs", "young_run_seconds"):
        value = block.get(key)
        if isinstance(value, (int, float)) and not isinstance(value, bool) and value >= 0:
            config[key] = value
    for key in ("default_mb", "recent_runs", "min_runs"):
        if config[key] <= 0:
            config[key] = MEMORY_DEFAULTS[key]
    return config


def env_integer(name, minimum):
    value = os.environ.get(name)
    if value is None or value == "":
        return None
    try:
        number = int(value)
    except ValueError:
        number = minimum - 1
    if number < minimum:
        raise LaneError("{} must be a {} integer".format(name, "positive" if minimum > 0 else "non-negative"), 8)
    return number


def ledger_records():
    records = []
    try:
        with open(os.path.join(state_dir(), "ledger.jsonl"), "r", encoding="utf-8", errors="replace") as stream:
            for line in stream:
                try:
                    record = json.loads(line)
                except ValueError:
                    continue
                if isinstance(record, dict):
                    records.append(record)
    except OSError:
        pass
    return records


def memory_need(lane, records, config):
    override = env_integer("LANES_MEM_NEED_MB", 1)
    if override is not None:
        return override, "env", 0
    peaks = [record["peak_mem_mb"] for record in records
             if record.get("lane") == lane and positive_number(record.get("peak_mem_mb"))]
    peaks = peaks[-int(config["recent_runs"]):]
    if len(peaks) >= config["min_runs"]:
        return max(1, int(round(statistics.median(peaks)))), "measured", len(peaks)
    if lane in config["lane_mb"]:
        return int(round(config["lane_mb"][lane])), "prior", len(peaks)
    return int(round(config["default_mb"])), "default", len(peaks)


def memory_reserve(total_mb, config):
    override = env_integer("LANES_MEM_RESERVE_MB", 0)
    if override is not None:
        return override
    return max(int(round(config["reserve_mb"])), int(round(config["reserve_fraction"] * total_mb)))


def parse_utc(value):
    try:
        moment = datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (AttributeError, TypeError, ValueError):
        return None
    return moment if moment.tzinfo else moment.replace(tzinfo=datetime.timezone.utc)


def young_runs_mb(records, config, exclude=None):
    """Memory held back for runs that started too recently to have grown to their need."""
    now = datetime.datetime.now(datetime.timezone.utc)
    runs = os.path.join(state_dir(), "runs")
    try:
        names = os.listdir(runs)
    except OSError:
        return 0
    excluded = os.path.normcase(os.path.realpath(exclude)) if exclude else None
    total = 0
    for name in names:
        # Run directories start with their UTC stamp, so only the last ten minutes' meta.json files are read.
        try:
            stamp = datetime.datetime.strptime(name[:15], "%Y%m%d-%H%M%S").replace(tzinfo=datetime.timezone.utc)
        except ValueError:
            continue
        if now - stamp > datetime.timedelta(minutes=10):
            continue
        path = os.path.join(runs, name)
        if excluded and os.path.normcase(os.path.realpath(path)) == excluded:
            continue
        try:
            with open(os.path.join(path, "meta.json"), "r", encoding="utf-8") as stream:
                meta = json.load(stream)
        except (OSError, ValueError):
            continue
        if not isinstance(meta, dict) or meta.get("ended_at"):
            continue
        # Count from the worker's launch: a run still waiting for memory holds none, and one that waited is young
        # again once it launches. Runs from a lane before launched_at count from started_at.
        launched = parse_utc(meta["launched_at"] if "launched_at" in meta else meta.get("started_at"))
        if launched is None or (now - launched).total_seconds() > config["young_run_seconds"]:
            continue
        total += memory_need(meta.get("lane"), records, config)[0]
    return total


def memory_fit(lane, catalog, run_dir=None):
    snapshot = memory_snapshot()
    if snapshot is None:
        return None
    config = memory_config(catalog)
    records = ledger_records()
    need, basis, runs = memory_need(lane, records, config)
    reserve = memory_reserve(snapshot["total_mb"], config)
    young = young_runs_mb(records, config, run_dir)
    fits = max(0, (snapshot["available_mb"] - reserve - young) // need)
    return dict(snapshot, reserve_mb=reserve, young_mb=young, need_mb=need, basis=basis, runs=runs, fits=fits)


def memory_line(fit):
    if fit is None:
        return "lane: memory unknown on this OS"
    return "lane: memory {:,} MB available of {:,} (reserve {:,}, starting runs {:,}) | needs ~{:,} MB ({}, n={}) | fits {}".format(
        fit["available_mb"], fit["total_mb"], fit["reserve_mb"], fit["young_mb"], fit["need_mb"], fit["basis"],
        fit["runs"], fit["fits"])


def mark_launched(meta, meta_path):
    # Other lanes count this run as starting from here (young_runs_mb), not from when lane began waiting.
    meta["launched_at"] = utc_now()
    write_meta(meta_path, meta)


def wait_for_memory(lane, catalog, run_dir):
    if os.environ.get("LANES_MEM_CHECK", "").lower() == "off":
        return None
    fit = memory_fit(lane, catalog, run_dir)
    if fit is None or fit["fits"] >= 1:
        return fit
    try:
        wait_seconds = int(os.environ.get("LANES_MEM_WAIT", "600"))
    except ValueError:
        raise LaneError("LANES_MEM_WAIT must be a non-negative integer", 8)
    if wait_seconds < 0:
        raise LaneError("LANES_MEM_WAIT must be a non-negative integer", 8)
    # 2026-10-24: parallel lane runs exhausted one machine's memory and a reap killed 6 jobs.
    print(memory_line(fit), file=sys.stderr)
    deadline = time.monotonic() + wait_seconds
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        time.sleep(min(10, remaining))
        fit = memory_fit(lane, catalog, run_dir)
        if fit is None or fit["fits"] >= 1:
            return fit
    raise LaneError("memory: {:,} MB available, {:,} reserved, {:,} held for starting runs; this run needs ~{:,} MB ({}); "
                    "wait for running lanes or lower LANES_MEM_RESERVE_MB".format(
                        fit["available_mb"], fit["reserve_mb"], fit["young_mb"], fit["need_mb"], fit["basis"]),
                    70, "BUSY")


def codex_rollout_paths(session_id, started_at, ended_at):
    if not session_id:
        return []
    dates = set()
    for value in (started_at, ended_at):
        try:
            moment = datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
            local_date = moment.astimezone().date()
        except (AttributeError, TypeError, ValueError):
            continue
        for offset in (-1, 0, 1):
            dates.add(local_date + datetime.timedelta(days=offset))
    home = os.path.abspath(os.path.expanduser(os.environ.get("CODEX_HOME", "~/.codex")))
    paths = []
    for day in sorted(dates):
        folder = os.path.join(home, "sessions", day.strftime("%Y"), day.strftime("%m"), day.strftime("%d"))
        paths.extend(glob.glob(os.path.join(folder, "*-{}.jsonl".format(session_id))))
    return paths


def codex_usage(session_id, started_at, ended_at, catalog):
    empty = {"tokens": None, "credits": None, "list_usd": None, "model_observed": None}

    def failed(reason, model=None):
        result = dict(empty)
        result["model_observed"] = model
        result["tokens_error"] = reason
        return result

    if not session_id:
        return failed("session id unavailable")
    paths = codex_rollout_paths(session_id, started_at, ended_at)
    if not paths:
        return failed("rollout not found")
    try:
        path = max(set(paths), key=os.path.getmtime)
        last_usage = None
        saw_token_event = False
        observed_model = None
        with open(path, "r", encoding="utf-8") as stream:
            for line in stream:
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                payload = event.get("payload") if isinstance(event, dict) else None
                if not isinstance(payload, dict):
                    continue
                if event.get("type") == "turn_context" or payload.get("type") == "turn_context":
                    model = payload.get("model")
                    if isinstance(model, str) and model:
                        observed_model = model
                if event.get("type") == "event_msg" and payload.get("type") == "token_count":
                    info = payload.get("info")
                    saw_token_event = True
                    last_usage = info.get("total_token_usage") if isinstance(info, dict) else None
    except (OSError, ValueError):
        return failed("rollout unreadable")
    if not saw_token_event or not isinstance(last_usage, dict):
        return failed("token usage unavailable", observed_model)
    if not observed_model:
        return failed("model unavailable")
    providers = catalog.get("providers") if isinstance(catalog, dict) else None
    codex = providers.get("codex") if isinstance(providers, dict) else None
    rate_card = codex.get("rate_card") if isinstance(codex, dict) else None
    rate = rate_card.get(observed_model) if isinstance(rate_card, dict) else None
    if not isinstance(rate, dict):
        return failed("model absent from rate card", observed_model)
    counts = {name: token_count(last_usage.get(source)) for name, source in (
        ("input", "input_tokens"), ("cached_input", "cached_input_tokens"),
        ("output", "output_tokens"), ("reasoning_output", "reasoning_output_tokens"))}
    if any(value is None for value in counts.values()):
        return failed("token usage incomplete", observed_model)
    rates = {name: rate.get(name) for name in ("input", "cached_input", "output")}
    if any(not isinstance(value, (int, float)) or isinstance(value, bool) for value in rates.values()):
        return failed("rate card incomplete", observed_model)
    credits = ((counts["input"] - counts["cached_input"]) * rates["input"] +
               counts["cached_input"] * rates["cached_input"] + counts["output"] * rates["output"]) / 1000000
    usd_per_credit = codex.get("usd_per_credit")
    if not isinstance(usd_per_credit, (int, float)) or isinstance(usd_per_credit, bool):
        return failed("credit conversion unavailable", observed_model)
    return {"tokens": counts, "credits": credits, "list_usd": credits * usd_per_credit,
            "model_observed": observed_model}


def append_ledger(run_dir, meta):
    fields = ("lane", "provider", "model", "effort", "class", "tag", "pick_id", "arm", "off_catalog", "ro", "resume",
              "place", "started_at", "ended_at", "duration_s", "verdict", "exit_code", "session_id", "usage",
              "eta_s", "eta_p80_s", "eta_tier", "brief_bytes", "peak_mem_mb", "mode")
    # .get: a run recovered from an older lane has no pick_id, arm, off_catalog or peak_mem_mb.
    record = {key: meta.get(key) for key in fields}
    if meta.get("verify"):
        # Only a verify run carries the key, so lane-stats can leave it out; unit rows keep their shape.
        record["verify"] = True
    subagents = (meta.get("cloud") or {}).get("subagents")
    if subagents is not None:
        # Only a cloud run whose report counted its subagents carries the key.
        record["subagents"] = subagents
    record["run_dir"] = os.path.abspath(run_dir)
    state = state_dir()
    os.makedirs(state, exist_ok=True)
    with open(os.path.join(state, "ledger.jsonl"), "a", encoding="utf-8") as stream:
        stream.write(json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n")


def text_value(obj, names):
    result = None
    for key, value in nested_values(obj):
        if isinstance(value, str) and key.lower() in names:
            result = value
    return result


def quota_words_in_structured_error(value):
    if isinstance(value, str):
        return bool(QUOTA_RE.search(value))
    if isinstance(value, (int, float)):
        return value == 429
    if isinstance(value, dict):
        return any(quota_words_in_structured_error(child) for child in value.values())
    if isinstance(value, list):
        return any(quota_words_in_structured_error(child) for child in value)
    return False


def gemini_structured_quota(data):
    statuses = [value for key, value in nested_values(data) if key == "status"]
    status_matches = any(quota_words_in_structured_error(value) for value in statuses)
    error_values = []
    for key, value in nested_values(data):
        if key in ("error", "errors", "error_kind", "error_code", "code"):
            error_values.append(value)
    error_present = bool(error_values)
    error_matches = any(quota_words_in_structured_error(value) for value in error_values)
    not_success = not any(isinstance(value, str) and value.upper() == "SUCCESS" for value in statuses)
    return status_matches or (not_success and error_present and error_matches)


def gemini_stderr_quota(stderr_text):
    for line in strip_ansi(stderr_text).splitlines():
        try:
            json.loads(line)
        except ValueError:
            if QUOTA_RE.search(line):
                return True
    return False


def codex_event_has_usage_limit_error(value):
    if isinstance(value, dict):
        error = value.get("error")
        if isinstance(error, dict) and error.get("codex_error_info") == "usage_limit_exceeded":
            return True
        return any(codex_event_has_usage_limit_error(child) for child in value.values())
    if isinstance(value, list):
        return any(codex_event_has_usage_limit_error(child) for child in value)
    return False


def codex_rollout_quota(session_id, started_at, ended_at):
    paths = codex_rollout_paths(session_id, started_at, ended_at)
    if not paths:
        return False, False
    try:
        path = max(set(paths), key=os.path.getmtime)
        with open(path, "r", encoding="utf-8") as stream:
            for line in stream:
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if codex_event_has_usage_limit_error(event):
                    return True, True
    except (OSError, ValueError):
        return False, False
    return True, False


def codex_log_quota(log_text, final_path):
    final_lines = set()
    try:
        if os.path.isfile(final_path) and os.path.getsize(final_path) > 0:
            with open(final_path, "r", encoding="utf-8", errors="replace") as stream:
                final_lines = {strip_ansi(line).strip() for line in stream}
    except OSError:
        pass
    for line in strip_ansi(log_text).splitlines()[-60:]:
        candidate = line.lstrip()
        if candidate.strip() in final_lines:
            continue
        if candidate.startswith("ERROR:") and "usage limit" in candidate.lower():
            return True
    return False


def write_meta(path, meta):
    temp = path + ".tmp"
    with open(temp, "w", encoding="utf-8") as stream:
        json.dump(meta, stream, indent=2, sort_keys=True)
        stream.write("\n")
    # On Windows the rename fails with "Access is denied" while another process has meta.json open (lane-stats
    # and turn-meter read every run's meta.json; so may a virus scanner). The work is done by now, so wait.
    for attempt in range(20):
        try:
            os.replace(temp, path)
            return
        except PermissionError:
            if attempt == 19:
                raise
            time.sleep(0.25)


def append_log(path, content):
    with open(path, "ab") as stream:
        if content and not content.endswith(b"\n"):
            content += b"\n"
        stream.write(content)


def kill_process_tree(proc):
    if IS_WINDOWS:
        # taskkill /T also ends the worker's children (node shells, sandboxes) that Popen.kill would orphan.
        subprocess.run(["taskkill", "/T", "/F", "/PID", str(proc.pid)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        return
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


class WindowsJobMeter:
    """A Job Object with no limits; its PeakJobMemoryUsed covers the worker and every process it starts."""

    def __init__(self):
        import ctypes
        from ctypes import wintypes

        class IO_COUNTERS(ctypes.Structure):
            _fields_ = [(name, ctypes.c_ulonglong) for name in (
                "ReadOperationCount", "WriteOperationCount", "OtherOperationCount",
                "ReadTransferCount", "WriteTransferCount", "OtherTransferCount")]

        class JOBOBJECT_BASIC_LIMIT_INFORMATION(ctypes.Structure):
            _fields_ = [("PerProcessUserTimeLimit", ctypes.c_longlong), ("PerJobUserTimeLimit", ctypes.c_longlong),
                        ("LimitFlags", wintypes.DWORD), ("MinimumWorkingSetSize", ctypes.c_size_t),
                        ("MaximumWorkingSetSize", ctypes.c_size_t), ("ActiveProcessLimit", wintypes.DWORD),
                        ("Affinity", ctypes.c_size_t), ("PriorityClass", wintypes.DWORD),
                        ("SchedulingClass", wintypes.DWORD)]

        class JOBOBJECT_EXTENDED_LIMIT_INFORMATION(ctypes.Structure):
            _fields_ = [("BasicLimitInformation", JOBOBJECT_BASIC_LIMIT_INFORMATION), ("IoInfo", IO_COUNTERS),
                        ("ProcessMemoryLimit", ctypes.c_size_t), ("JobMemoryLimit", ctypes.c_size_t),
                        ("PeakProcessMemoryUsed", ctypes.c_size_t), ("PeakJobMemoryUsed", ctypes.c_size_t)]

        self.ctypes = ctypes
        self.info_type = JOBOBJECT_EXTENDED_LIMIT_INFORMATION
        self.kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        self.kernel32.CreateJobObjectW.restype = wintypes.HANDLE
        self.kernel32.CreateJobObjectW.argtypes = (ctypes.c_void_p, wintypes.LPCWSTR)
        self.kernel32.AssignProcessToJobObject.argtypes = (wintypes.HANDLE, wintypes.HANDLE)
        self.kernel32.QueryInformationJobObject.argtypes = (wintypes.HANDLE, ctypes.c_int, ctypes.c_void_p,
                                                            wintypes.DWORD, ctypes.c_void_p)
        self.kernel32.CloseHandle.argtypes = (wintypes.HANDLE,)
        self.job = self.kernel32.CreateJobObjectW(None, None)
        self.assigned = False

    def start(self, proc):
        if self.job:
            self.assigned = bool(self.kernel32.AssignProcessToJobObject(self.job, int(proc._handle)))

    def finish(self):
        if not self.job:
            return None
        try:
            info = self.info_type()
            # 9: JobObjectExtendedLimitInformation.
            if not self.assigned or not self.kernel32.QueryInformationJobObject(
                    self.job, 9, self.ctypes.byref(info), self.ctypes.sizeof(info), None):
                return None
            return info.PeakJobMemoryUsed or None
        finally:
            self.kernel32.CloseHandle(self.job)
            self.job = None


def session_resident_bytes(session_id, page_size):
    total = 0
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        try:
            with open(os.path.join("/proc", name, "stat"), "rb") as stream:
                stat = stream.read()
            # The command name in parentheses may hold spaces; the session id is field 6, the fourth after ')'.
            if int(stat[stat.rindex(b")") + 1:].split()[3]) != session_id:
                continue
            with open(os.path.join("/proc", name, "statm"), "rb") as stream:
                total += int(stream.read().split()[1]) * page_size
        except (OSError, ValueError, IndexError):
            continue
    return total


class SessionMemoryMeter:
    """Samples the resident memory of the worker's session (start_new_session makes it the leader)."""

    def __init__(self):
        try:
            self.interval = float(os.environ.get("LANES_MEM_SAMPLE_SECONDS", "2"))
        except ValueError:
            self.interval = 2.0
        if not self.interval > 0:
            self.interval = 2.0
        self.page_size = os.sysconf("SC_PAGE_SIZE")
        self.peak = None
        self.failed = False
        self.stop = threading.Event()
        self.thread = None

    def sample(self, session_id):
        try:
            value = session_resident_bytes(session_id, self.page_size)
        except Exception:
            self.failed = True
            return
        if value > 0 and (self.peak is None or value > self.peak):
            self.peak = value

    def start(self, proc):
        self.sample(proc.pid)
        if self.failed:
            return

        def loop():
            while not self.stop.wait(self.interval):
                self.sample(proc.pid)

        self.thread = threading.Thread(target=loop, daemon=True)
        self.thread.start()

    def finish(self):
        self.stop.set()
        if self.thread is not None:
            self.thread.join(timeout=5)
        return None if self.failed else self.peak


def memory_meter():
    try:
        return WindowsJobMeter() if IS_WINDOWS else SessionMemoryMeter()
    except Exception:
        return None


def meter_call(meter, method, *args):
    # A measurement error loses the peak, never the run.
    if meter is None:
        return None
    try:
        return getattr(meter, method)(*args)
    except Exception:
        return None


def larger_peak(left, right):
    values = [value for value in (left, right) if value is not None]
    return max(values) if values else None


def run_process(argv, cwd, log_path, timeout, stdin_data, env=None):
    started = time.monotonic()
    timed_out = False
    stdout_bytes = b""
    stderr_bytes = b""
    peak_bytes = None
    if IS_WINDOWS:
        group = {"creationflags": subprocess.CREATE_NEW_PROCESS_GROUP}
    else:
        group = {"start_new_session": True}
    meter = memory_meter()
    try:
        with open(log_path, "w+b") as log, tempfile.TemporaryFile() as stderr_log:
            try:
                proc = subprocess.Popen(argv, cwd=cwd, stdin=subprocess.PIPE if stdin_data is not None else subprocess.DEVNULL,
                                        stdout=log, stderr=stderr_log, env=env, **group)
            except OSError:
                meter_call(meter, "finish")
                raise
            meter_call(meter, "start", proc)
            try:
                proc.communicate(input=stdin_data, timeout=timeout)
            except subprocess.TimeoutExpired:
                timed_out = True
                kill_process_tree(proc)
                proc.communicate()
            peak_bytes = meter_call(meter, "finish")
            code = 124 if timed_out else proc.returncode
            log.flush()
            log.seek(0)
            stdout_bytes = log.read()
            stderr_log.seek(0)
            stderr_bytes = stderr_log.read()
        if stderr_bytes:
            if stdout_bytes and not stdout_bytes.endswith(b"\n"):
                append_log(log_path, b"\n")
            append_log(log_path, stderr_bytes)
    except OSError as exc:
        diagnostic = ("could not start worker: {}\n".format(exc)).encode("utf-8", "replace")
        append_log(log_path, diagnostic)
        stdout_bytes += diagnostic
        code = 127
    peak_mb = int(round(peak_bytes / MB)) if peak_bytes else None
    return (code, timed_out, time.monotonic() - started,
            stdout_bytes.decode("utf-8", "replace"), stderr_bytes.decode("utf-8", "replace"), peak_mb)


def protected_run_argv(argv, lane, mask_paths, dir_path, outdir, executable, marker_path):
    system = platform.system().lower()
    if system == "linux":
        unshare = shutil.which("unshare")
        if not unshare:
            raise LaneError("unshare is unavailable; rerun with --no-mask", 8)
        env_hide = "\n".join(mask_paths)
        env = filtered_mask_environment(lane)
        env["LANE_MASK_HIDE"] = env_hide
        env["LANE_MASK_CHILD_FILE"] = marker_path
        mask_script = os.path.join(os.path.dirname(os.path.realpath(__file__)), "lane-mask")
        return [unshare, "-rm", "--pid", "--fork", "--mount-proc", "--propagation", "private",
                mask_script, "--"] + argv, env
    if system == "darwin":
        sandbox = shutil.which("sandbox-exec")
        if not sandbox:
            raise LaneError("sandbox-exec is unavailable; rerun with --no-mask", 8)
        pieces = ["(version 1)", "(allow default)"]
        for path in mask_paths:
            quoted = path.replace("\\", "\\\\").replace('"', '\\"')
            if os.path.isdir(path):
                pieces.append('(deny file-read* file-write* (subpath "{}"))'.format(quoted))
            else:
                pieces.append('(deny file-read* file-write* (literal "{}"))'.format(quoted))
        profile = "\n".join(pieces)
        return [sandbox, "-p", profile] + argv, filtered_mask_environment(lane)
    if system == "windows":
        raise LaneError("credential masking is unsupported on Windows: a --no-mask worker can read every file you "
                        "can, including ~/.claude, ~/.codex and browser profiles. Prefer luna or gemini; rerun with "
                        "--no-mask only for a unit whose workspace and brief you would hand over anyway", 8)
    raise LaneError("credential masking is unsupported on {}; rerun with --no-mask".format(system), 8)


def status_clean(path):
    status = git_status(path)
    return status is not None and not status


def compose_brief(lane, brief_bytes, ro):
    separator = b"\n\n" if brief_bytes and not brief_bytes.endswith(b"\n") else b"\n"
    if lane == "gemini":
        return brief_bytes + separator + GEMINI_BLOCK.encode("utf-8") + b"\n" + PROCESS_RULE.encode("utf-8") + b"\n"
    if lane in CLAUDE_LANES and ro:
        return b"READ-ONLY UNIT: do not modify any file.\n" + brief_bytes
    if lane in CLAUDE_LANES:
        return brief_bytes
    # Claude lanes carry the rule in WORKER_BLOCK; codex and cline see only the brief.
    rules = PROCESS_RULE
    if IS_WINDOWS and lane in CODEX_LANES + ("codex-cloud",):
        rules += "\n\n" + WINDOWS_CODEX_RULE
    return brief_bytes + separator + rules.encode("utf-8") + b"\n"


def decide_verdict(lane, code, timed_out, log_text, outdir, dir_path,
                   stdout_text=None, stderr_text=None, before_status=None, ro=False, before_head=None,
                   started_at=None, ended_at=None):
    log_text = strip_ansi(log_text)
    if timed_out:
        return "TIMEOUT", 124, None
    if lane in CODEX_LANES:
        sessions = re.findall(r"session id: ([0-9a-f-]{36})", log_text, re.IGNORECASE)
        session = sessions[0] if sessions else None
        final_path = os.path.join(outdir, "final.md")
        rollout_readable, rollout_quota = codex_rollout_quota(session, started_at, ended_at)
        if rollout_quota or (not rollout_readable and codex_log_quota(log_text, final_path)):
            return "QUOTA", 75, session
        if code != 0:
            return "FAILED", 4, session
        if (not os.path.isfile(final_path) or os.path.getsize(final_path) == 0) and is_git_repo(dir_path) and status_clean(dir_path):
            return "NOOP", 3, session
        return "OK", 0, session
    if lane in CLAUDE_LANES:
        data = last_gemini_object(strip_ansi(stdout_text if stdout_text is not None else log_text))
        session = data.get("session_id")
        if code != 0 or data.get("is_error"):
            if CLAUDE_QUOTA_RE.search(str(data.get("result", "")) + "\n" + strip_ansi(stderr_text or "")):
                return "QUOTA", 75, session
            return "FAILED", 4, session
        if not data:
            return "FAILED", 4, session
        after_head = git_head(dir_path) if before_head is not None else None
        if not ro and before_status is not None and git_status(dir_path) == before_status and after_head == before_head:
            return "NOOP", 3, session
        return "OK", 0, session
    if lane == "gemini":
        stdout_text = strip_ansi(stdout_text if stdout_text is not None else log_text)
        stderr_text = strip_ansi(stderr_text or "")
        data = last_gemini_object(stdout_text)
        session = None
        for key, value in nested_values(data):
            if isinstance(value, str) and ("conversation" in key.lower() or "session" in key.lower()):
                session = value
                break
        response = text_value(data, {"response"}) or ""
        if "print timeout" in log_text.lower():
            return "PARTIAL", 6, session
        stderr_json_quota = any(gemini_structured_quota(obj) for obj in parse_json_objects(stderr_text))
        if gemini_structured_quota(data) or stderr_json_quota or gemini_stderr_quota(stderr_text):
            return "QUOTA", 75, session
        if "background" in response.lower() and is_git_repo(dir_path) and status_clean(dir_path):
            return "NOOP", 3, session
        status = text_value(data, {"status"})
        if code != 0 or status != "SUCCESS":
            return "FAILED", 4, session
        return "OK", 0, session
    if code == 86:
        return "DISABLED", 5, None
    if code != 0:
        return "FAILED", 4, None
    return "OK", 0, None


def final_text(lane, outdir, log_text, stdout_text=None):
    """The worker's whole final answer ("" when it gave none), or None when the lane has no structured one."""
    if lane in CODEX_LANES:
        try:
            with open(os.path.join(outdir, "final.md"), "r", encoding="utf-8", errors="replace") as stream:
                return strip_ansi(stream.read())
        except OSError:
            return None
    source = strip_ansi(stdout_text if stdout_text is not None else log_text)
    if lane == "gemini":
        return text_value(last_gemini_object(source), {"response"}) or ""
    if lane in CLAUDE_LANES:
        final = last_gemini_object(source).get("result")
        return final if isinstance(final, str) else ""
    return None


def final_message(lane, outdir, log_text, stdout_text=None):
    final = final_text(lane, outdir, log_text, stdout_text)
    if final is None:
        return strip_ansi(log_text).splitlines()[-5:]
    return final.splitlines()[-5:]


def parse_pick(value):
    if not PICK_RE.fullmatch(value):
        raise argparse.ArgumentTypeError("must be 1 to 64 characters of A-Z, a-z, 0-9, '.', '_' or '-'")
    return value


def build_parser():
    parser = argparse.ArgumentParser(prog="lane", description="Run one of the configured worker CLIs.",
                                     epilog="The macOS sandbox-exec masking path is untested.")
    parser.add_argument("lane", choices=LANES)
    parser.add_argument("-C", dest="dir_path", required=True, metavar="DIR")
    parser.add_argument("-b", dest="brief", required=True, metavar="BRIEF")
    parser.add_argument("-e", dest="effort", choices=("low", "medium", "high", "xhigh", "max"))
    parser.add_argument("-m", "--model", dest="model")
    parser.add_argument("--ro", action="store_true")
    parser.add_argument("--web", action="store_true")
    parser.add_argument("--resume")
    parser.add_argument("-o", "--outdir", dest="outdir")
    parser.add_argument("--class", dest="unit_class", choices=("mechanical", "substantive", "hard", "design", "review", "research"))
    parser.add_argument("--tag")
    parser.add_argument("--pick", dest="pick_id", type=parse_pick, metavar="ID")
    parser.add_argument("--off-catalog", dest="off_catalog", action="store_true")
    masks = parser.add_mutually_exclusive_group()
    masks.add_argument("--mask", dest="mask", action="store_true")
    masks.add_argument("--no-mask", dest="mask", action="store_false")
    parser.set_defaults(mask=None)
    parser.add_argument("--timeout", type=int, default=3600, metavar="SEC")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--cloud", action="store_true", help="run a Claude lane in its cloud VM")
    parser.add_argument("--verify", action="store_true",
                        help="with --cloud: run the commands the brief lists and return their output; change nothing")
    parser.add_argument("--subagent", action="store_true",
                        help="prepare a Claude lane run for a subagent of the main session")
    parser.add_argument("--side", metavar="REASON",
                        help="with --cloud: run a worker VM beside a live main cloud session (see `lane main`)")
    return parser


def subagent_prompt(run_id, dir_path, ro, sent_text):
    lines = ["lane-run: " + run_id, "Work only in this directory: " + dir_path]
    if ro:
        lines.append("Read-only run: do not create, modify or delete any file.")
    body = sent_text if sent_text.endswith("\n") else sent_text + "\n"
    # A local worker gets WORKER_BLOCK through --append-system-prompt; a subagent reads it here.
    return "\n".join(lines) + "\n\n" + body + "\n" + WORKER_BLOCK + "\n\n" + SUBAGENT_PARTIAL_RULE + "\n"


def subagent_launch(lane, effort, unit_class, run_id, prompt_path):
    return {"subagent_type": "lane-{}-{}".format(lane, effort),
            "description": "{} {} {}".format(lane, effort, unit_class or "-"),
            "prompt": "lane-run: {}\nYour brief is in {}. Read it in full first and follow it exactly.".format(
                run_id, prompt_path)}


def prepare_subagent_run(opts, model, arm_name, dir_path, brief_bytes, sent_bytes, outdir):
    run_id = os.path.basename(os.path.normpath(outdir))
    prompt_path = os.path.join(outdir, "prompt.md")
    prompt_text = subagent_prompt(run_id, dir_path, opts.ro, sent_bytes.decode("utf-8"))
    launch = subagent_launch(opts.lane, opts.effort, opts.unit_class, run_id, prompt_path)
    if opts.unit_class is None:
        print("note: pass --class so lane-stats can compare lanes", file=sys.stderr)
    eta = estimate_eta(opts.lane, model, opts.effort, opts.unit_class, opts.tag, len(brief_bytes))
    print_eta(eta)
    if opts.dry_run:
        print("subagent: would write {} ({} bytes) and {}".format(
            prompt_path, len(prompt_text.encode("utf-8")), os.path.join(outdir, "meta.json")))
        print("subagent: launch with the Agent tool; the SubagentStop hook (lane hook subagent-stop) records the result")
        print(json.dumps(launch, ensure_ascii=False))
        print("dry-run: nothing written")
        return 0
    os.makedirs(outdir, exist_ok=True)
    with open(os.path.join(outdir, "brief.md"), "wb") as stream:
        stream.write(brief_bytes)
    with open(os.path.join(outdir, "brief.sent.md"), "wb") as stream:
        stream.write(sent_bytes)
    meta_path = os.path.join(outdir, "meta.json")
    started_at = utc_now()
    before, before_error = read_usage("claude")
    usage = {"before": before, "after": None, "tokens": None, "list_usd": None}
    if before_error:
        usage["error"] = before_error
    before_status = git_status(dir_path)
    before_head = git_head(dir_path) if is_git_repo(dir_path) else None
    eta_s = round(eta["minutes"] * 60, 1) if eta is not None else None
    p80_minutes = eta.get("p80_minutes") if eta is not None else None
    meta = {"lane": opts.lane, "provider": "claude", "model": model, "effort": opts.effort, "dir": dir_path,
            "class": opts.unit_class, "tag": opts.tag, "pick_id": opts.pick_id, "arm": arm_name,
            "off_catalog": bool(opts.off_catalog), "usage": usage, "place": "subagent",
            "eta_s": eta_s, "eta_p80_s": round(p80_minutes * 60, 1) if is_eta_minutes(p80_minutes) else None,
            "eta_tier": eta.get("tier") if eta is not None else None, "brief_bytes": len(brief_bytes),
            "ro": bool(opts.ro), "web": False, "masked": False, "mask_paths": [], "resume": None,
            "started_at": started_at, "started_epoch": time.time() - 2, "ended_at": None, "duration_s": None,
            "exit_code": None, "verdict": None, "session_id": None, "launched_at": None, "peak_mem_mb": None,
            "log": None, "cmd": None, "executable": None, "prompt": prompt_path,
            "git_before": {"status": before_status, "head": before_head},
            "subagent": {"agent_type": launch["subagent_type"], "parent_session_id": None, "later_stops": []}}
    with open(prompt_path, "w", encoding="utf-8", newline="\n") as stream:
        stream.write(prompt_text)
    # The subagent runs inside Claude Code's own process: no memory or task-headroom wait.
    meta["launched_at"] = utc_now()
    write_meta(meta_path, meta)
    print("lane: subagent run {} prepared; launch it with the Agent tool:".format(run_id))
    print(json.dumps(launch, ensure_ascii=False))
    return 0


def read_transcript(path):
    entries = []
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as stream:
            for line in stream:
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if isinstance(entry, dict):
                    entries.append(entry)
    except (OSError, TypeError, ValueError):
        return []
    return entries


def message_text(message):
    content = message.get("content") if isinstance(message, dict) else None
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(block["text"] for block in content
                         if isinstance(block, dict) and isinstance(block.get("text"), str))
    return ""


def transcript_run_id(entries):
    """The run id named on the first user entry's first line, or None."""
    first = next((entry for entry in entries if entry.get("type") == "user"), None)
    match = re.match(r"lane-run: (\S+)", message_text(first.get("message")) if first else "")
    if not match:
        return None
    run_id = match.group(1)
    if run_id in (".", "..") or os.path.basename(run_id) != run_id or "/" in run_id or "\\" in run_id:
        return None
    return run_id


def transcript_last_text(entries):
    for entry in reversed(entries):
        if entry.get("type") == "assistant":
            text = message_text(entry.get("message"))
            if text:
                return text
    return ""


def transcript_usage(entries):
    """Tokens, priced messages, models and efforts of a subagent transcript's assistant entries."""
    messages = {}
    order = []
    models, efforts = [], []
    for index, entry in enumerate(entries):
        message = entry.get("message")
        if entry.get("type") != "assistant" or not isinstance(message, dict):
            continue
        model = message.get("model")
        # Claude Code's own error stand-ins carry model "<synthetic>" and no usage.
        if model == "<synthetic>":
            continue
        if isinstance(model, str) and model not in models:
            models.append(model)
        effort = entry.get("effort")
        if isinstance(effort, str) and effort not in efforts:
            efforts.append(effort)
        usage = message.get("usage") if isinstance(message.get("usage"), dict) else {}
        creation = usage.get("cache_creation")
        if isinstance(creation, dict):
            write_5m = token_count(creation.get("ephemeral_5m_input_tokens")) or 0
            write_1h = token_count(creation.get("ephemeral_1h_input_tokens")) or 0
        else:
            write_5m, write_1h = token_count(usage.get("cache_creation_input_tokens")) or 0, 0
        tokens = {"input": token_count(usage.get("input_tokens")) or 0,
                  "output": token_count(usage.get("output_tokens")) or 0,
                  "cache_read": token_count(usage.get("cache_read_input_tokens")) or 0,
                  "cache_write_5m": write_5m, "cache_write_1h": write_1h}
        # One API response is written as one entry per content block, all with its message id; the later
        # entries carry the final output count.
        key = message.get("id") if isinstance(message.get("id"), str) else "#{}".format(index)
        if key not in messages:
            order.append(key)
        elif tokens["output"] < messages[key][1]["output"]:
            continue
        messages[key] = (model, tokens)
    totals = {"input": 0, "output": 0, "cache_read": 0, "cache_write_5m": 0, "cache_write_1h": 0}
    for key in order:
        for name, value in messages[key][1].items():
            totals[name] += value
    return {"tokens": totals, "messages": [messages[key] for key in order], "models_seen": models,
            "efforts_seen": efforts}


PRICE_FIELDS = ("input", "output", "cache_write_5m", "cache_write_1h", "cache_read")


def claude_prices():
    try:
        catalog = load_catalog()
    except LaneError:
        return {}
    providers = catalog.get("providers")
    claude = providers.get("claude") if isinstance(providers, dict) else None
    prices = claude.get("prices") if isinstance(claude, dict) else None
    return prices if isinstance(prices, dict) else {}


def price_for(prices, model):
    if not isinstance(model, str):
        return None
    # A dated id (claude-haiku-5-5-20261001) takes its family's price.
    candidates = [key for key in prices if model == key or model.startswith(key + "-")]
    price = prices.get(max(candidates, key=len)) if candidates else None
    if not isinstance(price, dict) or not all(isinstance(price.get(name), (int, float)) for name in PRICE_FIELDS):
        return None
    return price


def message_list_usd(price, tokens):
    rates = price
    long_context = price.get("long_context")
    prompt = tokens["input"] + tokens["cache_read"] + tokens["cache_write_5m"] + tokens["cache_write_1h"]
    if isinstance(long_context, dict) and isinstance(long_context.get("above_prompt_tokens"), (int, float)) \
            and prompt > long_context["above_prompt_tokens"] \
            and all(isinstance(long_context.get(name), (int, float)) for name in PRICE_FIELDS):
        rates = long_context
    return sum(tokens[name] * rates[name] for name in PRICE_FIELDS) / 1e6


def transcript_list_usd(messages, prices):
    """List USD of the messages, or None and the unpriced models."""
    total = 0.0
    unknown = []
    for model, tokens in messages:
        price = price_for(prices, model)
        if price is None:
            label = model if isinstance(model, str) else "unknown"
            if label not in unknown:
                unknown.append(label)
            continue
        total += message_list_usd(price, tokens)
    return (None if unknown else round(total, 6)), unknown


def subagent_verdict(meta, last_message):
    # decide_verdict's rules for a Claude lane, from the git state stored at preparation.
    if SUBAGENT_PARTIAL_RE.search(last_message or ""):
        return "PARTIAL", 6
    if meta.get("ro"):
        return ("OK", 0) if (last_message or "").strip() else ("NOOP", 3)
    before = meta.get("git_before") if isinstance(meta.get("git_before"), dict) else {}
    dir_path = meta.get("dir")
    before_status, before_head = before.get("status"), before.get("head")
    if isinstance(dir_path, str) and before_status is not None:
        after_head = git_head(dir_path) if before_head is not None else None
        if git_status(dir_path) == before_status and after_head == before_head:
            return "NOOP", 3
    return "OK", 0


def bounded_usage(provider, seconds=8):
    # A hook must return within seconds; usage-status may wait up to 45 for a meter.
    result = [None, "usage-status timed out"]

    def read():
        result[:] = read_usage(provider)

    reader = threading.Thread(target=read, daemon=True)
    reader.start()
    reader.join(seconds)
    return result[0], result[1]


def finish_subagent_run(run_dir, meta, stop, entries, ended_epoch, recovered=False):
    meta_path = os.path.join(run_dir, "meta.json")
    dir_path = meta.get("dir")
    ended = datetime.datetime.fromtimestamp(ended_epoch, datetime.timezone.utc)
    started = parse_utc(meta.get("started_at"))
    duration = (ended - started).total_seconds() if started else None
    summary = transcript_usage(entries)
    list_usd, unknown = transcript_list_usd(summary["messages"], claude_prices())
    warnings = [item for item in meta.get("warnings") or [] if isinstance(item, str)]
    if unknown:
        warnings.append("no list price for model {}; list_usd is null".format(", ".join(unknown)))
    usage = meta.get("usage") if isinstance(meta.get("usage"), dict) else {}
    meta["usage"] = usage
    usage["tokens"] = summary["tokens"]
    usage["list_usd"] = list_usd
    last_message = stop.get("last_message") or ""
    verdict, exit_code = subagent_verdict(meta, last_message)
    text_warnings = []
    started_epoch = meta.get("started_epoch")
    if not meta.get("ro") and isinstance(dir_path, str) and os.path.isdir(dir_path) \
            and isinstance(started_epoch, (int, float)):
        text_warnings = encoding_warnings(dir_path, started_epoch)
    error = usage.get("error")
    if recovered:
        usage["after"] = None
        usage["error"] = (str(error) + "; " if error else "") + "recovered: no after-reading"
    else:
        usage["after"], after_error = bounded_usage("claude")
        errors = list(dict.fromkeys(item for item in (error, after_error) if item))
        if errors:
            usage["error"] = "; ".join(errors)
    if last_message:
        with open(os.path.join(run_dir, "final.md"), "w", encoding="utf-8", newline="\n") as stream:
            stream.write(last_message if last_message.endswith("\n") else last_message + "\n")
    subagent = meta.get("subagent") if isinstance(meta.get("subagent"), dict) else {}
    later_stops = subagent.get("later_stops") if isinstance(subagent.get("later_stops"), list) else []
    subagent.update({"agent_id": stop.get("agent_id"), "agent_type": stop.get("agent_type") or subagent.get("agent_type"),
                     "transcript": stop.get("transcript"),
                     "parent_session_id": stop.get("parent_session_id") or subagent.get("parent_session_id"),
                     "models_seen": summary["models_seen"], "efforts_seen": summary["efforts_seen"],
                     "later_stops": later_stops})
    meta["subagent"] = subagent
    arm_effort = meta.get("effort")
    if arm_effort not in summary["efforts_seen"]:
        warnings.append("subagent ran at effort {}; the arm is {}".format(
            ", ".join(summary["efforts_seen"]) or "unknown", arm_effort))
    if warnings:
        meta["warnings"] = warnings
    if text_warnings:
        meta["text_warnings"] = text_warnings
    meta.update({"ended_at": ended.isoformat(timespec="seconds").replace("+00:00", "Z"),
                 "duration_s": round(duration, 3) if duration is not None else None, "exit_code": exit_code,
                 "verdict": verdict, "session_id": stop.get("agent_id"), "peak_mem_mb": None})
    if recovered:
        meta.update({"recovered": True, "recovered_at": utc_now()})
    write_meta(meta_path, meta)
    append_ledger(run_dir, meta)
    return verdict, exit_code, duration


def subagent_stop_hook(text):
    data = json.loads(text)
    if not isinstance(data, dict):
        raise ValueError("SubagentStop input is not a JSON object")
    agent_type = data.get("agent_type")
    if not isinstance(agent_type, str) or not agent_type.startswith("lane-"):
        return 0
    transcript = data.get("agent_transcript_path")
    entries = read_transcript(transcript) if isinstance(transcript, str) and transcript else []
    run_id = transcript_run_id(entries)
    if run_id is None:
        return 0
    run_dir = os.path.join(state_dir(), "runs", run_id)
    meta_path = os.path.join(run_dir, "meta.json")
    try:
        with open(meta_path, "r", encoding="utf-8") as stream:
            meta = json.load(stream)
    except (OSError, ValueError):
        return 0
    if not isinstance(meta, dict):
        return 0
    if meta.get("verdict") is not None:
        subagent = meta.get("subagent") if isinstance(meta.get("subagent"), dict) else {}
        if not isinstance(subagent.get("later_stops"), list):
            subagent["later_stops"] = []
        subagent["later_stops"].append({"at": utc_now(), "agent_id": data.get("agent_id")})
        meta["subagent"] = subagent
        write_meta(meta_path, meta)
        return 0
    last_message = data.get("last_assistant_message")
    if not isinstance(last_message, str):
        last_message = transcript_last_text(entries)
    stop = {"agent_id": data.get("agent_id"), "agent_type": agent_type, "transcript": transcript,
            "parent_session_id": data.get("session_id"), "last_message": last_message}
    finish_subagent_run(run_dir, meta, stop, entries, time.time())
    return 0


def run_hook(handler):
    # Hook stdout is fed to the subagent, and a failing hook must not disturb it: print nothing, exit 0.
    real_stdout = sys.stdout
    sys.stdout = open(os.devnull, "w", encoding="utf-8")
    try:
        handler(sys.stdin.buffer.read().decode("utf-8", "replace"))
    except Exception:
        try:
            os.makedirs(state_dir(), exist_ok=True)
            with open(os.path.join(state_dir(), "hook-errors.log"), "a", encoding="utf-8") as stream:
                stream.write("{} lane hook {}\n{}\n".format(utc_now(), " ".join(sys.argv[1:3]), traceback.format_exc()))
        except Exception:
            pass
    finally:
        sys.stdout.close()
        sys.stdout = real_stdout
    return 0


def claude_projects_root():
    return os.path.abspath(os.path.expanduser(os.environ.get("LANES_CLAUDE_PROJECTS") or "~/.claude/projects"))


def first_user_entry(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as stream:
            for line in stream:
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if isinstance(entry, dict) and entry.get("type") == "user":
                    return entry
    except OSError:
        return None
    return None


def find_subagent_transcript(run_id):
    pattern = os.path.join(glob.escape(claude_projects_root()), "*", "*", "subagents", "agent-*.jsonl")
    for path in sorted(glob.glob(pattern), key=lambda item: os.path.getmtime(item), reverse=True):
        entry = first_user_entry(path)
        if entry is not None and transcript_run_id([entry]) == run_id:
            return path
    return None


def recover_subagent_run(run_arg, run_dir, meta, transcript, force):
    now = time.time()
    if not force and now - os.path.getmtime(transcript) < 120:
        print("lane: cannot recover {}: the subagent transcript was modified in the last 120 seconds "
              "(pass --force)".format(run_arg), file=sys.stderr)
        return 2
    entries = read_transcript(transcript)
    first = next((entry for entry in entries if entry.get("type") == "user"), {})
    name = os.path.basename(transcript)
    agent_id = first.get("agentId") or name[len("agent-"):-len(".jsonl")]
    agent_type = None
    try:
        with open(transcript[:-len(".jsonl")] + ".meta.json", "r", encoding="utf-8") as stream:
            sidecar = json.load(stream)
        agent_type = sidecar.get("agentType") if isinstance(sidecar, dict) else None
    except (OSError, ValueError):
        pass
    parent = first.get("sessionId") or os.path.basename(os.path.dirname(os.path.dirname(transcript)))
    stop = {"agent_id": agent_id, "agent_type": agent_type, "transcript": transcript,
            "parent_session_id": parent, "last_message": transcript_last_text(entries)}
    verdict, exit_code, duration = finish_subagent_run(run_dir, meta, stop, entries, os.path.getmtime(transcript),
                                                       recovered=True)
    duration = duration or 0
    print("lane={} verdict={} exit={} session={} secs={} out={} recovered=1{}".format(
        meta.get("lane") or "-", verdict, exit_code, agent_id or "-", int(duration + 0.5), run_dir,
        eta_summary_suffix(duration, meta.get("eta_s"))))
    return 0


def recover_run(run_arg, force=False):
    runs_dir = os.path.join(state_dir(), "runs")
    run_dir = os.path.abspath(os.path.expanduser(run_arg))
    if not os.path.isdir(run_dir):
        run_dir = os.path.join(runs_dir, run_arg)
    meta_path = os.path.join(run_dir, "meta.json")
    try:
        with open(meta_path, "r", encoding="utf-8") as stream:
            meta = json.load(stream)
    except (OSError, ValueError):
        print("lane: cannot recover {}: meta.json is missing or invalid".format(run_arg), file=sys.stderr)
        return 2
    if not isinstance(meta, dict):
        print("lane: cannot recover {}: meta.json is missing or invalid".format(run_arg), file=sys.stderr)
        return 2
    if meta.get("ended_at"):
        print("lane: cannot recover {}: run already ended".format(run_arg), file=sys.stderr)
        return 2
    if meta.get("place") == "subagent" and meta.get("verdict") is None:
        transcript = find_subagent_transcript(os.path.basename(os.path.normpath(run_dir)))
        if transcript:
            return recover_subagent_run(run_arg, run_dir, meta, transcript, force)
    log_path = os.path.join(run_dir, "run.log")
    final_path = os.path.join(run_dir, "final.md")
    artifacts = [path for path in (log_path, final_path) if os.path.isfile(path)]
    if not os.path.isfile(log_path):
        print("lane: cannot recover {}: run.log is missing".format(run_arg), file=sys.stderr)
        return 2
    now = time.time()
    if not force and any(now - os.path.getmtime(path) < 120 for path in artifacts):
        print("lane: cannot recover {}: run artifacts were modified in the last 120 seconds (pass --force)".format(
            run_arg), file=sys.stderr)
        return 2
    try:
        with open(log_path, "r", encoding="utf-8", errors="replace") as stream:
            log_text = strip_ansi(stream.read())
        stdout_text = log_text
        lane_name = meta.get("lane")
        ended = datetime.datetime.fromtimestamp(max(os.path.getmtime(path) for path in artifacts),
                                                datetime.timezone.utc)
        ended_at = ended.isoformat(timespec="seconds").replace("+00:00", "Z")
        started = datetime.datetime.fromisoformat(str(meta.get("started_at", "")).replace("Z", "+00:00"))
        duration = (ended - started).total_seconds()
    except (OSError, TypeError, ValueError, OverflowError):
        print("lane: cannot recover {}: run timestamps or artifacts are invalid".format(run_arg), file=sys.stderr)
        return 2
    data = last_gemini_object(log_text)
    session = None
    if lane_name in CODEX_LANES:
        sessions = re.findall(r"session id: ([0-9a-f-]{36})", strip_ansi(log_text), re.IGNORECASE)
        session = sessions[0] if sessions else None
        message = final_message(lane_name, run_dir, log_text, stdout_text)
        verdict = "OK" if message else "UNKNOWN"
    elif lane_name in CLAUDE_LANES:
        session = data.get("session_id")
        verdict = "OK" if data.get("type") == "result" and data.get("subtype") == "success" else "UNKNOWN"
    elif lane_name == "gemini":
        for key, value in nested_values(data):
            if isinstance(value, str) and ("conversation" in key.lower() or "session" in key.lower()):
                session = value
                break
        verdict = "OK" if data else "UNKNOWN"
    else:
        verdict = "UNKNOWN"
    usage = meta.get("usage")
    if not isinstance(usage, dict):
        usage = {}
        meta["usage"] = usage
    if lane_name in CODEX_LANES:
        try:
            catalog = read_arms_file(arms_catalog_path())
        except LaneError:
            catalog = None
        usage.update(codex_usage(session, meta.get("started_at"), ended_at, catalog))
    else:
        usage["tokens"] = run_tokens(lane_name, log_text, stdout_text)
    if lane_name in CLAUDE_LANES:
        usage["list_usd"] = data.get("total_cost_usd")
    usage["after"] = None
    error = usage.get("error")
    usage["error"] = (str(error) + "; " if error else "") + "recovered: no after-reading"
    meta.update({"ended_at": ended_at, "duration_s": round(duration, 3), "exit_code": None,
                 "verdict": verdict, "session_id": session, "recovered": True, "recovered_at": utc_now()})
    write_meta(meta_path, meta)
    append_ledger(run_dir, meta)
    print("lane={} verdict={} exit=null session={} secs={} out={} recovered=1{}".format(
        lane_name or "-", verdict, session or "-", int(duration + 0.5), run_dir,
        eta_summary_suffix(duration, meta.get("eta_s"))))
    return 0


def validate_options(parser, opts, catalog):
    if not os.path.isabs(opts.dir_path) or not os.path.isdir(opts.dir_path):
        parser.error("DIR must be an absolute path to an existing directory")
    if not os.path.isfile(opts.brief) or not os.access(opts.brief, os.R_OK):
        parser.error("BRIEF must be a readable file")
    if opts.timeout <= 0:
        parser.error("--timeout must be greater than zero")
    if opts.cloud and opts.lane not in CLAUDE_LANES:
        parser.error("--cloud is only available for haiku, sonnet, or opus")
    if opts.verify and (not opts.cloud or opts.lane not in CLAUDE_LANES):
        parser.error("--verify needs --cloud and a Claude lane (haiku, sonnet, or opus)")
    if opts.cloud and (opts.resume is not None or opts.web or opts.mask is True):
        parser.error("--cloud cannot be combined with --resume, --web, or --mask")
    if opts.side is not None:
        if not opts.cloud:
            parser.error("--side needs --cloud")
        if not opts.side.strip() or len(opts.side.strip()) > 200:
            parser.error("--side needs a reason of 1 to 200 characters")
    if opts.subagent and opts.lane not in CLAUDE_LANES:
        parser.error("--subagent is only available for haiku, sonnet, or opus")
    if opts.subagent and (opts.cloud or opts.resume is not None or opts.web or opts.mask is True):
        parser.error("--subagent cannot be combined with --cloud, --resume, --web, or --mask")
    if opts.subagent and opts.outdir:
        # The SubagentStop hook finds the run by its id under lane's own runs directory.
        parser.error("--subagent cannot be combined with -o; its run lives under lane's runs directory")
    if opts.lane == "codex-cloud" and (opts.effort or opts.model is not None):
        parser.error("codex-cloud does not take -e or --model")
    if opts.lane == "codex-cloud" and (opts.resume is not None or opts.web or opts.mask is True):
        parser.error("codex-cloud does not support --resume, --web, or --mask")
    if opts.lane in CODEX_LANES + CLAUDE_LANES and not opts.effort:
        suggestion = {"luna": "; medium for mechanical, xhigh for substantive, max for the hardest",
                      "terra": "; low, medium, high, xhigh, or max",
                      "sol": "; medium for a hard unit, low when the brief is tight, xhigh for the hardest",
                      "astra": "; low, medium, high, xhigh, or max",
                      "haiku": "; low, medium, high, or xhigh",
                      "sonnet": "; low, medium, high, xhigh, or max",
                      "opus": "; medium, high, xhigh, or max"}[opts.lane]
        parser.error("-e is required{}".format(suggestion))
    # The refusals below are the built-in fallback; with the arms catalog loaded, the arm check decides instead.
    if catalog is None and opts.lane in ("sol", "haiku") and opts.effort == "max":
        # Artificial Analysis coding agents, 2026-10-04: sol max scored 60.1 at $1.55 a task, below xhigh's 62.9 at $1.04.
        parser.error("{} effort must be low, medium, high, or xhigh; max costs more than xhigh and scores lower".format(opts.lane))
    if catalog is None and opts.lane == "luna" and opts.model and opts.model not in ("gpt-6-luna", "gpt-5.6-luna"):
        raise LaneError("luna model must be gpt-6-luna or gpt-5.6-luna", 8)
    if catalog is None and opts.lane == "sol" and opts.model and opts.model != "gpt-6.1-sol":
        raise LaneError("sol model must be gpt-6.1-sol", 8)
    claude_home = os.path.normcase(os.path.realpath(os.path.expanduser("~/.claude")))
    workspace = os.path.normcase(os.path.realpath(opts.dir_path))
    if opts.lane in CLAUDE_LANES and not opts.ro and (workspace == claude_home or workspace.startswith(claude_home + os.sep)):
        # Claude Code treats everything under ~/.claude as sensitive and refuses to edit it headlessly.
        parser.error("{} cannot edit under ~/.claude (Claude Code protects it); use a workspace outside it".format(opts.lane))
    if opts.web and opts.lane == "glm":
        parser.error("glm cannot take --web: the cline lane has no web switch")
    if opts.web and opts.lane == "gemini":
        # agy --help lists no search switch and does not say whether search is on under --sandbox, so the run is
        # refused rather than recorded as a web run that may not search.
        parser.error("gemini cannot take --web: agy --help has no search switch")
    if catalog is None and opts.lane in ("terra", "astra") + CLAUDE_LANES and opts.model and opts.model != DEFAULT_MODELS[opts.lane]:
        raise LaneError("{} model must be {}".format(opts.lane, DEFAULT_MODELS[opts.lane]), 8)


def dry_run(opts, dir_path, outdir, sent_bytes, sent_text, executable, executable_origin, command, masks, warnings,
            headroom, reserve, mask_error=None, memory=None):
    display = [WORKER_BLOCK[:40] + "..." if arg == WORKER_BLOCK else arg for arg in command]
    print("argv: {}".format(json.dumps(display, ensure_ascii=False)))
    print("executable: {}".format(format_executable(executable, executable_origin)))
    print("mask_paths: {}".format(json.dumps(masks, ensure_ascii=False)))
    print("precondition: DIR exists and is absolute: PASS")
    print("precondition: BRIEF readable: PASS")
    if IS_WINDOWS:
        length = windows_command_line_length(command)
        print("precondition: Windows command line length: {} ({} of {} characters)".format(
            "PASS" if length <= WINDOWS_COMMAND_LINE_LIMIT else "FAIL", length, WINDOWS_COMMAND_LINE_LIMIT))
    if opts.lane in CODEX_LANES:
        print("precondition: {} version: not checked during dry-run".format(opts.lane))
    if mask_enabled(opts.lane, opts.mask):
        include_control = platform.system().lower() == "linux"
        env_names = kept_mask_env_names(opts.lane, include_control=include_control)
        if mask_error:
            print("precondition: credential mask: FAIL ({})".format(mask_error))
        else:
            print("precondition: credential mask: PASS")
    else:
        env_names = []
    print("mask_env_names: {}".format(json.dumps(env_names)))
    print("task headroom: {}; reserve: {}".format(
        "unavailable" if headroom is None else headroom, reserve))
    print(memory_line(memory))
    if warnings:
        for path in warnings:
            print("warning: mask path overlaps protected path and was removed: {}".format(path), file=sys.stderr)
    return 0


def run_lane(opts, parser):
    catalog = load_catalog_or_warn()
    validate_options(parser, opts, catalog)
    if opts.verify and opts.tag is None:
        opts.tag = "verify"
    model = opts.model or default_model(catalog, opts.lane)
    effort = opts.effort or (model.rsplit("-", 1)[-1] if opts.lane == "gemini" else
                             "default" if opts.lane == "codex-cloud" else None)
    arm = arm_for(catalog, opts.lane, model, effort) if catalog is not None else None
    if catalog is not None and not opts.off_catalog:
        require_arm(opts.lane, model, effort, arm)
    arm_name = "/".join((arm["lane"], arm["model"], arm["effort"])) if arm else None
    dir_path = os.path.realpath(opts.dir_path)
    brief_path = os.path.abspath(os.path.expanduser(opts.brief))
    try:
        with open(brief_path, "rb") as stream:
            brief_bytes = stream.read()
        brief_bytes.decode("utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        parser.error("cannot read BRIEF as UTF-8: {}".format(exc))
    sent_bytes = compose_brief(opts.lane, brief_bytes, opts.ro)
    sent_text = sent_bytes.decode("utf-8")
    outdir = output_dir(opts.lane, dir_path, opts.outdir)
    cloud_mode = bool(opts.cloud or opts.lane == "codex-cloud")
    if not opts.dry_run and not opts.outdir and not cloud_mode:
        outdir = reserve_run_dir(outdir)
    if opts.subagent:
        return prepare_subagent_run(opts, model, arm_name, dir_path, brief_bytes, sent_bytes, outdir)
    provider = PROVIDERS[opts.lane]
    executable_name = {"codex": "codex", "claude": "claude", "gemini": "agy", "cline": "cline"}[provider]
    executable, executable_origin = resolve_binary(executable_name)
    cloud_plan = cloud_preflight(opts.lane, dir_path) if cloud_mode else None
    # A live main cloud session runs the project's units itself; a separate worker VM needs a stated reason.
    side_reason = main_side_check(opts, cloud_plan) if opts.cloud else None
    if not opts.dry_run and not opts.outdir and cloud_mode:
        outdir = reserve_run_dir(outdir)
    command = build_command(opts.lane, opts, model, dir_path, sent_text, outdir, executable)
    use_mask = mask_enabled(opts.lane, opts.mask)
    masks, warnings = [], []
    explore = catalog.get("explore") if isinstance(catalog, dict) else None
    setting = mode_setting(explore)
    if opts.dry_run and cloud_mode:
        # No meter reading in a dry run: auto shows the default mode's prompt.
        return cloud_dry_run(opts, dir_path, outdir, sent_text, sent_bytes, model, effort, executable, cloud_plan,
                             run_mode(setting, None, explore), side_reason)
    if opts.dry_run:
        eta = estimate_eta(opts.lane, model, effort, opts.unit_class, opts.tag, len(brief_bytes))
        print_eta(eta)
        headroom = cgroup_task_headroom()
        reserve = task_reserve(opts.lane)
        memory = memory_fit(opts.lane, catalog)
        command = with_launcher(command, executable)
        if use_mask:
            masks, warnings = make_mask_list(opts.lane, dir_path, outdir, executable, executable_origin)
        display_command = command
        mask_error = None
        if use_mask:
            try:
                display_command, _ = protected_run_argv(command, opts.lane, masks, dir_path, outdir,
                                                         executable, "<child-start-marker>")
            except LaneError as exc:
                mask_error = str(exc)
        return dry_run(opts, dir_path, outdir, sent_bytes, sent_text, executable, executable_origin,
                       display_command, masks, warnings, headroom, reserve, mask_error, memory)
    os.makedirs(outdir, exist_ok=True)
    with open(os.path.join(outdir, "brief.md"), "wb") as stream:
        stream.write(brief_bytes)
    with open(os.path.join(outdir, "brief.sent.md"), "wb") as stream:
        stream.write(sent_bytes)
    log_path = os.path.join(outdir, "run.log")
    meta_path = os.path.join(outdir, "meta.json")
    started_at = utc_now()
    if opts.lane == "astra":
        print("note: astra draws about 5x sol per token from the Codex weekly window", file=sys.stderr)
    if opts.unit_class is None and not opts.verify:
        print("note: pass --class so lane-stats can compare lanes", file=sys.stderr)
    # Every run but a verify run gets a pre-launch eta, cloud runs too. lane-stats skips verify runs, so a
    # verify run makes no eta call.
    eta = None if opts.verify else estimate_eta(opts.lane, model, effort, opts.unit_class, opts.tag, len(brief_bytes))
    print_eta(eta)
    before, before_error = read_usage(provider)
    mode = run_mode(setting, before, explore)
    print("lane: mode {} ({})".format(mode, "auto" if setting == "auto" else "setting " + setting), file=sys.stderr)
    # The worker's own time: the meter readings around it can take up to a minute.
    started_clock = time.monotonic()
    started_epoch = time.time() - 2
    usage = {"before": before, "after": None, "tokens": None, "list_usd": None}
    if opts.lane in CODEX_LANES:
        usage.update({"credits": None, "model_observed": None})
    if before_error:
        usage["error"] = before_error
    eta_s = round(eta["minutes"] * 60, 1) if eta is not None else None
    p80_minutes = eta.get("p80_minutes") if eta is not None else None
    eta_p80_s = round(p80_minutes * 60, 1) if is_eta_minutes(p80_minutes) else None
    cloud_meta = None
    if cloud_mode:
        cloud_meta = {"kind": "claude" if opts.cloud else "codex",
                      "branch": cloud_plan["branch"], "base": cloud_plan["base"],
                      "result_branch": None, "result_sha": None}
        if opts.cloud:
            cloud_meta["session_id"] = None
            cloud_meta["url"] = None
            if side_reason:
                cloud_meta["side_reason"] = side_reason
        else:
            cloud_meta["task_id"] = None
            cloud_meta["url"] = None
            cloud_meta["env"] = cloud_plan["env"]
    meta = {"lane": opts.lane, "provider": provider, "model": model,
            "effort": effort if opts.lane == "codex-cloud" else opts.effort, "dir": dir_path,
            "class": opts.unit_class, "tag": opts.tag, "pick_id": opts.pick_id, "arm": arm_name,
            "off_catalog": bool(opts.off_catalog), "usage": usage,
            "place": "cloud" if cloud_mode else "local",
            "eta_s": eta_s, "eta_p80_s": eta_p80_s, "eta_tier": eta.get("tier") if eta is not None else None,
            "brief_bytes": len(brief_bytes), "mode": mode,
            "ro": bool(opts.ro), "web": bool(opts.web), "masked": bool(use_mask), "mask_paths": masks,
            "resume": opts.resume, "started_at": started_at, "ended_at": None,
            "duration_s": None, "exit_code": None, "verdict": None,
            "session_id": None, "launched_at": None, "peak_mem_mb": None, "log": log_path, "cmd": command,
            "executable": format_executable(executable, executable_origin)}
    if cloud_meta is not None:
        meta["cloud"] = cloud_meta
    if opts.verify:
        # Not a unit: lane-stats and turn-meter's review list skip runs marked verify.
        meta["verify"] = True
    write_meta(meta_path, meta)
    stdout_text = None
    stderr_text = ""
    log_text = ""
    marker_path = None
    peak_mem_mb = None
    try:
        if cloud_mode:
            if opts.cloud:
                verdict, exit_code, session, stdout_text, log_text = run_claude_cloud(
                    opts, dir_path, outdir, sent_text, model, effort, executable, cloud_plan,
                    meta, meta_path, log_path)
            else:
                verdict, exit_code, session, stdout_text, log_text = run_codex_cloud(
                    opts, dir_path, outdir, sent_bytes, executable, cloud_plan, meta, meta_path, log_path)
            stderr_text = ""
        else:
            command = with_launcher(command, executable)
            meta["cmd"] = command
            if use_mask:
                masks, warnings = make_mask_list(opts.lane, dir_path, outdir, executable, executable_origin)
                meta["mask_paths"] = masks
            write_meta(meta_path, meta)
            if opts.lane in CODEX_LANES:
                check_version_or_raise(opts.lane, executable)
            stdin_data = sent_bytes if opts.lane in CODEX_LANES + CLAUDE_LANES else None
            actual_argv = command
            child_env = None
            if use_mask:
                if platform.system().lower() == "linux":
                    marker_fd, marker_path = tempfile.mkstemp(prefix="lane-child-start-")
                    os.close(marker_fd)
                    os.unlink(marker_path)
                actual_argv, child_env = protected_run_argv(command, opts.lane, masks, dir_path, outdir, executable, marker_path)
            if opts.lane in CLAUDE_LANES:
                source_env = os.environ if child_env is None else child_env
                child_env = {name: value for name, value in source_env.items()
                             if name.upper() == "CLAUDE_CODE_OAUTH_TOKEN"
                             or (name.upper() != "CLAUDECODE" and not name.upper().startswith("CLAUDE_CODE_"))}
                # A worker's auto-memory lands in the repository's project folder (linked worktrees share it) and would
                # load into the user's own later sessions there, so workers keep no memory.
                child_env["CLAUDE_CODE_DISABLE_AUTO_MEMORY"] = "1"
            if warnings:
                for path in warnings:
                    print("warning: mask path overlaps protected path and was removed: {}".format(path), file=sys.stderr)
            if IS_WINDOWS and windows_command_line_length(actual_argv) > WINDOWS_COMMAND_LINE_LIMIT:
                raise LaneError("the command line exceeds the Windows limit of 32,767 characters; {} passes the brief as an "
                                "argument, so shorten the brief or use luna, which reads it from stdin".format(opts.lane), 8)
            before_status = git_status(dir_path) if opts.lane in CLAUDE_LANES else None
            before_head = git_head(dir_path) if opts.lane in CLAUDE_LANES and is_git_repo(dir_path) else None
            if opts.lane == "gemini":
                wait_for_memory(opts.lane, catalog, outdir)
                wait_for_task_headroom(opts.lane)
                mark_launched(meta, meta_path)
                code, timed_out, _, stdout_text, stderr_text, peak_mem_mb = run_process(
                    actual_argv, dir_path, log_path, opts.timeout, stdin_data, child_env)
                if not timed_out and os.path.getsize(log_path) < 400:
                    first_text = strip_ansi(stdout_text + "\n" + stderr_text)
                    if "Eligibility check failed" in first_text:
                        time.sleep(30)
                        retry_log = os.path.join(outdir, "run.retry.log")
                        wait_for_memory(opts.lane, catalog, outdir)
                        wait_for_task_headroom(opts.lane)
                        mark_launched(meta, meta_path)
                        retry_code, retry_timeout, _, stdout_text, stderr_text, retry_peak = run_process(
                            actual_argv, dir_path, retry_log, opts.timeout, stdin_data, child_env)
                        peak_mem_mb = larger_peak(peak_mem_mb, retry_peak)
                        retry_data = open(retry_log, "rb").read()
                        append_log(log_path, b"\n--- retry ---\n" + retry_data)
                        code, timed_out = retry_code, retry_timeout
            else:
                wait_for_memory(opts.lane, catalog, outdir)
                wait_for_task_headroom(opts.lane)
                mark_launched(meta, meta_path)
                code, timed_out, _, stdout_text, stderr_text, peak_mem_mb = run_process(
                    actual_argv, dir_path, log_path, opts.timeout, stdin_data, child_env)
            if use_mask and marker_path:
                started = os.path.exists(marker_path)
                if not started:
                    raise LaneError("unshare or lane-mask failed before the worker started; rerun with --no-mask", 8)
            with open(log_path, "r", encoding="utf-8", errors="replace") as stream:
                log_text = strip_ansi(stream.read())
            verdict, exit_code, session = decide_verdict(opts.lane, code, timed_out, log_text, outdir, dir_path,
                                                          stdout_text, stderr_text, before_status, opts.ro, before_head,
                                                          started_at, utc_now())
    except LaneError as exc:
        verdict, exit_code, session = exc.verdict, exc.code, meta.get("session_id")
        if exc.verdict != "BUSY":
            print(str(exc), file=sys.stderr)
            # The reason goes into the run's record too: a cloud run that FAILED once kept only its launch lines.
            meta["error"] = str(exc)
            try:
                append_log(log_path, ("\nlane: " + str(exc) + "\n").encode("utf-8"))
            except OSError:
                pass
        log_text = ""
        if os.path.exists(log_path):
            with open(log_path, "r", encoding="utf-8", errors="replace") as stream:
                log_text = strip_ansi(stream.read())
    finally:
        if marker_path:
            try:
                os.unlink(marker_path)
            except OSError:
                pass
    duration = time.monotonic() - started_clock
    usage["after"], after_error = read_usage(provider)
    errors = list(dict.fromkeys(error for error in (before_error, after_error) if error))
    if errors:
        usage["error"] = "; ".join(errors)
    ended_at = utc_now()
    if opts.lane in CODEX_LANES:
        usage.update(codex_usage(session, started_at, ended_at, catalog))
    elif not cloud_mode:
        usage["tokens"] = run_tokens(opts.lane, log_text, stdout_text)
    if opts.lane in CLAUDE_LANES and not opts.cloud:
        usage["list_usd"] = last_gemini_object(strip_ansi(stdout_text or "")).get("total_cost_usd")
    # Codex writes final.md itself; the other lanes get one too, so a caller (an automation, a reviewer) reads
    # one file instead of each CLI's output format.
    if opts.lane not in CODEX_LANES:
        answer = final_text(opts.lane, outdir, log_text, stdout_text)
        if answer:
            with open(os.path.join(outdir, "final.md"), "w", encoding="utf-8", newline="\n") as stream:
                stream.write(answer if answer.endswith("\n") else answer + "\n")
    text_warnings = []
    if not opts.ro and verdict not in ("BUSY", "REFUSED") and os.path.isdir(dir_path):
        text_warnings = encoding_warnings(dir_path, started_epoch)
    meta.update({"ended_at": ended_at, "duration_s": round(duration, 3), "exit_code": exit_code,
                 "verdict": verdict, "session_id": session, "peak_mem_mb": peak_mem_mb})
    if text_warnings:
        meta["text_warnings"] = text_warnings
    write_meta(meta_path, meta)
    append_ledger(outdir, meta)
    print("lane={} verdict={} exit={} session={} secs={} out={} class={}{}{}".format(
        opts.lane, verdict, exit_code, session or "-", int(duration + 0.5), outdir, opts.unit_class or "-",
        " web" if opts.web else "", eta_summary_suffix(duration, meta.get("eta_s"))))
    for warning in text_warnings:
        print("warning: " + warning)
    window_change = window_change_warning()
    if window_change:
        print("warning: " + window_change)
    status = git_status(dir_path)
    if status is not None:
        for line in status[:20]:
            print(line)
    for line in final_message(opts.lane, outdir, log_text, stdout_text):
        print(line)
    return exit_code


# ---------------------------------------------------------------------------------------------------------------
# lane main: a project's mirror (one standing cloud session per repository), its markers and its hand-offs.
# Wire formats: the spec for kit release 2026-10-31.15; the policy side is POLICY.md "Main cloud sessions".
# ---------------------------------------------------------------------------------------------------------------

def main_state_path():
    return os.path.join(state_dir(), "mains.json")


def main_load():
    """mains.json as {"version": 1, "mains": {repo key: entry}}; a missing file is an empty one."""
    path = main_state_path()
    try:
        with open(path, "r", encoding="utf-8") as stream:
            data = json.load(stream)
    except FileNotFoundError:
        return {"version": 1, "mains": {}}
    except (OSError, ValueError) as exc:
        raise LaneError("cannot read {}: {}".format(path, exc), 8)
    if not isinstance(data, dict) or not isinstance(data.get("mains"), dict):
        raise LaneError("{} is not a mains file (expected {{\"version\": 1, \"mains\": {{...}}}})".format(path), 8)
    data.setdefault("version", 1)
    data["mains"] = {key: entry for key, entry in data["mains"].items() if isinstance(entry, dict)}
    return data


def main_save(data):
    """Write mains.json through a temp file of its own, flushed to disk, then os.replace (no half-written file)."""
    path = main_state_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    descriptor, temp = tempfile.mkstemp(prefix="mains.json.", suffix=".tmp", dir=os.path.dirname(path))
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as stream:
            json.dump(data, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        for attempt in range(20):
            try:
                os.replace(temp, path)
                return
            except PermissionError:
                if attempt == 19:
                    raise
                time.sleep(0.25)
    finally:
        if os.path.exists(temp):
            try:
                os.unlink(temp)
            except OSError:
                pass


class MainLock:
    """A lock file around a read-modify-write of mains.json. A lock older than 30 s is a dead writer's and is taken."""

    def __enter__(self):
        os.makedirs(state_dir(), exist_ok=True)
        self.path = main_state_path() + ".lock"
        deadline = time.monotonic() + 10
        while True:
            try:
                os.close(os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY))
                return self
            except FileExistsError:
                try:
                    if time.time() - os.path.getmtime(self.path) > 30:
                        os.unlink(self.path)
                        continue
                except OSError:
                    pass
                if time.monotonic() >= deadline:
                    raise LaneError("mains.json is locked by another lane main call ({}); delete the lock file if no "
                                    "such call is running".format(self.path), 8)
                time.sleep(0.05)

    def __exit__(self, *exc_info):
        try:
            os.unlink(self.path)
        except OSError:
            pass


def main_update_entry(key, main_id=None, **fields):
    """Re-read mains.json, change one entry and write it back, so a parallel `lane main` call keeps its changes.

    With main_id the entry is changed only while it still belongs to that session: a watch of a replaced session
    must not write its tip into the new one.
    """
    with MainLock():
        data = main_load()
        entry = data["mains"].get(key)
        if entry is not None and (main_id is None or entry.get("main_id") == main_id):
            entry.update(fields)
            main_save(data)


def main_repo_key(remote_url):
    """`owner/repo` (lower case) for a GitHub origin, else `local/<last path part without .git>`."""
    slug = cloud_repo_slug(remote_url)
    if slug:
        return slug
    tail = re.split(r"[\\/:]", remote_url.strip().rstrip("/\\"))[-1]
    if tail.lower().endswith(".git"):
        tail = tail[:-4]
    if not tail:
        raise LaneError("cannot name the repository of origin {}".format(remote_url), 8)
    return "local/" + tail


def main_checkout_key(path):
    """The repo key of the checkout at `path`, or None when it has no readable origin."""
    try:
        result = cloud_git(path, ["remote", "get-url", "origin"])
        if result.returncode or not cloud_output(result):
            return None
        return main_repo_key(cloud_output(result))
    except LaneError:
        return None


def main_find_entry(data, value):
    """(key, entry) for a repo key or a checkout path; entry is None when nothing is registered, key None when unknown."""
    mains = data["mains"]
    if value in mains:
        return value, mains[value]
    if os.path.isdir(value):
        key = main_checkout_key(os.path.abspath(value))
        return (key, mains.get(key)) if key else (None, None)
    for key in mains:
        if key.lower() == value.lower():
            return key, mains[key]
    return None, None


def main_registered(data, value):
    key, entry = main_find_entry(data, value)
    if entry is None:
        raise LaneError("no main cloud session is registered for {}; see lane main --list".format(value), 2)
    for field in ("main_id", "branch", "checkout"):
        if not isinstance(entry.get(field), str) or not entry[field]:
            raise LaneError("the entry for {} in mains.json has no {}".format(key, field), 8)
    return key, entry


def main_dir(key):
    return os.path.join(state_dir(), "mains", cloud_run_component(key.replace("/", "_")))


def main_quote(arg):
    """One argument of a printed command. On Windows the commands chain with && (which Windows PowerShell 5.1 lacks),
    so they go to Git Bash or cmd.exe: bash strips unquoted backslashes, so paths print with forward slashes, which
    Windows and cmd.exe accept, and double quotes, which both shells read."""
    return subprocess.list2cmdline([arg.replace("\\", "/")]) if IS_WINDOWS else shlex.quote(arg)


def main_tool_command(script):
    """A printed command that runs the kit's Python tool `script`. On Windows a shebang does nothing and Git Bash
    resolves `env python3` to the Microsoft Store stub, so this python goes first."""
    if not IS_WINDOWS and os.access(script, os.X_OK):
        return main_quote(script)
    return main_quote(sys.executable) + " " + main_quote(script)


def main_lane_command():
    return main_tool_command(os.path.realpath(__file__))


def main_kit_root():
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def main_policy_path():
    override = os.environ.get("LANES_POLICY")
    if override:
        return os.path.abspath(os.path.expanduser(override))
    return os.path.join(main_kit_root(), "POLICY.md")


def main_policy_text():
    path = main_policy_path()
    try:
        with open(path, "r", encoding="utf-8") as stream:
            return stream.read()
    except (OSError, UnicodeDecodeError) as exc:
        raise LaneError("cannot read the kit policy {}: {}".format(path, exc), 8)


def main_release(policy_text):
    """The kit release from POLICY.md's line `Claude Usage Optimizer version: X.`, else None."""
    match = re.search(r"^Claude Usage Optimizer version: (\S+?)\.?(?:\s|$)", policy_text, re.MULTILINE)
    return match.group(1) if match else None


def main_section(policy_text, accepts):
    """The lines from the first heading `accepts` up to the next `## ` heading, cut exactly as in the file."""
    lines = policy_text.split("\n")
    start = next((index for index, line in enumerate(lines) if accepts(line.rstrip("\r"))), None)
    if start is None:
        return None
    end = next((index for index in range(start + 1, len(lines)) if lines[index].startswith("## ")), len(lines))
    text = "\n".join(lines[start:end])
    # A heading follows (end < len): the last line cut still ends in its newline. At the end of the file the final
    # split element already holds what follows the last newline.
    return text + "\n" if end < len(lines) or not text.endswith("\n") else text


def main_fold_ascii(text):
    """Fold the typographic characters to ASCII; any other non-ASCII character is refused by name."""
    text = text.translate(MAIN_FOLD)
    if text.isascii():
        return text
    import unicodedata
    char = next(c for c in text if ord(c) > 127)
    line = next(part for part in text.split("\n") if char in part)
    raise LaneError("POLICY.md has a character the command line cannot carry: U+{:04X} ({}) near {}; use plain ASCII "
                    "there".format(ord(char), unicodedata.name(char, "unnamed").encode("ascii", "replace").decode("ascii"),
                                   ascii(line.strip()[:60])), 8)


def main_check_prompt(text, what):
    for phrase in MAIN_FORBIDDEN_PHRASES:
        # cloud-notify tells a worker from the main session by these phrases.
        if phrase in text:
            raise LaneError("the main cloud prompt must not contain {!r} ({})".format(phrase, what), 8)
    if len(text) > MAIN_PROMPT_LIMIT:
        raise LaneError("the main cloud prompt is {} characters, over the limit of {} ({}); shorten it".format(
            len(text), MAIN_PROMPT_LIMIT, what), 8)


def main_block(main_id, release, policy_text):
    """MAIN_HEAD plus the policy sections `## Main cloud sessions` and `## Briefs` of POLICY.md, as ASCII."""
    main_text = main_section(policy_text, lambda line: line.startswith("## Main cloud sessions"))
    if main_text is None:
        raise LaneError("POLICY.md has no 'Main cloud sessions' section", 8)
    briefs_text = main_section(policy_text, lambda line: line.rstrip() == "## Briefs")
    if briefs_text is None:
        raise LaneError("POLICY.md has no 'Briefs' section", 8)
    head = MAIN_HEAD.format(main_id=main_id, picks_branch=MAIN_PICKS_BRANCH,
                            result_prefix=MAIN_RESULT_ROOT + main_id + "/")
    block = main_fold_ascii(head + "\n\nKIT POLICY (from POLICY.md, release {}; it addresses you)\n\n".format(
        release or "unknown") + main_text + briefs_text)
    main_check_prompt(block, "kit text")
    return block


def main_prompt(main_id, release, policy_text, brief_text):
    prompt = main_block(main_id, release, policy_text) + "\n\nPROJECT BRIEF\n\n" + brief_text.rstrip() + "\n"
    main_check_prompt(prompt, "kit text and project brief")
    return prompt


def main_new_id():
    return datetime.datetime.now().strftime("%Y%m%d-%H%M%S") + "-main"


def main_stderr_tail(result):
    lines = result.stderr.decode("utf-8", "replace").strip().splitlines()
    return re.sub(r"://[^@/\s]+@", "://", lines[-1]) if lines else ""


def main_plumbing(path, args, input_data=None, env=None):
    """Run a git plumbing command in `path` and return its trimmed output; a failure is FAILED (4)."""
    result = cloud_process(["git", "-C", path] + list(args), cwd=path, timeout=60, input_data=input_data, env=env)
    if result.returncode:
        detail = main_stderr_tail(result)
        raise LaneError("git {} failed{}".format(args[0], ": " + detail if detail else ""), 4, "FAILED")
    return cloud_output(result)


def main_remote_tip(path, branch):
    """The sha of origin's branch, None when it does not exist; an unreadable origin is FAILED (4)."""
    result = cloud_git(path, ["ls-remote", "origin", "refs/heads/" + branch], timeout=120)
    if result.returncode:
        raise LaneError("cannot read origin branch {}".format(branch), 4, "FAILED")
    for line in cloud_output(result).splitlines():
        sha, _, ref = line.partition("\t")
        if ref == "refs/heads/" + branch:
            return sha
    return None


def main_exclude_value(parser, text):
    """--exclude as sorted, comma-joined lane names; a name the catalog lacks is an error before anything starts.

    A typo (gemni) would otherwise exclude nothing, and the mirror would draw the lane it was meant to skip."""
    names = sorted({value.strip() for value in text.split(",") if value.strip()})
    catalog = load_catalog_or_warn()
    lanes = catalog.get("lanes") if catalog else None
    if isinstance(lanes, dict):
        unknown = [name for name in names if name not in lanes]
        if unknown:
            parser.error("unknown lane in --exclude: {} (lanes: {})".format(", ".join(unknown),
                                                                          ", ".join(sorted(lanes))))
    return ",".join(names)


def main_picks_table(key, release, exclude=""):
    """Run `lane-stats main-picks` (LANES_* in the environment pass through) and add kit and repo.

    exclude is a --exclude value (comma-separated lanes) that the table leaves out of every class."""
    command = [sys.executable, sibling_script("lane-stats"), "main-picks"]
    if not os.path.isfile(command[1]):
        raise LaneError("lane-stats was not found at {}".format(command[1]), 4, "FAILED")
    if exclude:
        command += ["--exclude", exclude]
    result = cloud_process(command, timeout=300)
    if result.returncode:
        detail = main_stderr_tail(result)
        raise LaneError("lane-stats main-picks failed{}".format(": " + detail if detail else ""), 4, "FAILED")
    try:
        table = json.loads(result.stdout.decode("utf-8"))
    except ValueError:
        table = None
    if not isinstance(table, dict):
        raise LaneError("lane-stats main-picks did not print a JSON object", 4, "FAILED")
    table["kit"] = release
    table["repo"] = key
    return table


def main_push_picks(path, table):
    """Push picks.json as the next commit of PICKS_BRANCH with git plumbing only; never touches tree or index."""
    payload = (json.dumps(table, indent=2) + "\n").encode("utf-8")
    env = dict(os.environ)
    env.update({"GIT_AUTHOR_NAME": "kit", "GIT_AUTHOR_EMAIL": "kit@localhost",
                "GIT_COMMITTER_NAME": "kit", "GIT_COMMITTER_EMAIL": "kit@localhost"})
    detail = ""
    for _ in range(2):
        parent = None
        if main_remote_tip(path, MAIN_PICKS_BRANCH):
            fetched = cloud_git(path, ["fetch", "--quiet", "--no-tags", "origin",
                                       "+refs/heads/{}:refs/lane-main/picks".format(MAIN_PICKS_BRANCH)], timeout=120)
            if fetched.returncode:
                raise LaneError("cannot fetch {} from origin".format(MAIN_PICKS_BRANCH), 4, "FAILED")
            parent = main_plumbing(path, ["rev-parse", "--verify", "refs/lane-main/picks^{commit}"])
        blob = main_plumbing(path, ["hash-object", "-w", "--stdin"], input_data=payload)
        tree = main_plumbing(path, ["mktree"], input_data="100644 blob {}\tpicks.json\n".format(blob).encode("ascii"))
        commit = main_plumbing(path, ["commit-tree", tree] + (["-p", parent] if parent else []) +
                               ["-m", "lane: picks " + utc_now()], env=env)
        pushed = cloud_git(path, ["push", "origin", "{}:refs/heads/{}".format(commit, MAIN_PICKS_BRANCH)], timeout=120)
        if not pushed.returncode:
            return commit
        # A second local call may have pushed first: read the tip again and build on it.
        detail = main_stderr_tail(pushed)
    raise LaneError("could not push {} to origin{}".format(MAIN_PICKS_BRANCH, " ({})".format(detail) if detail else ""),
                    4, "FAILED")


def main_claude_env():
    env = {name: value for name, value in os.environ.items()
           if name.upper() == "CLAUDE_CODE_OAUTH_TOKEN"
           or (name.upper() != "CLAUDECODE" and not name.upper().startswith("CLAUDE_CODE_"))}
    env["CLAUDE_CODE_DISABLE_AUTO_MEMORY"] = "1"
    return env


def main_side_check(opts, plan):
    """The `--side` reason to record, or None. A live mirror for this repository refuses a cloud worker without one."""
    reason = opts.side.strip() if opts.side else None
    live = None
    if not opts.verify:
        try:
            key = main_repo_key(plan["remote_url"])
            entry = main_load()["mains"].get(key)
        except LaneError as exc:
            # An unreadable registry cannot say there is no mirror: refuse, unless the caller gave a reason.
            if not reason:
                raise LaneError("cannot tell whether a main cloud session is live for this repository ({}). Repair or "
                                "delete the file, or give --side \"<reason>\" to start a worker VM anyway.".format(exc), 8)
            print("warning: could not check for a main cloud session: {}".format(exc), file=sys.stderr)
            return reason
        if entry is not None and entry.get("status") == "live":
            live = (key, entry)
    if live is None:
        if reason:
            print("note: --side ignored; {}".format("--verify runs never need it" if opts.verify else
                                                    "no main cloud session is live for this repository"),
                  file=sys.stderr)
        return None
    if not reason:
        raise LaneError(
            "a main cloud session is live for {} ({}). Run this unit as a subagent of that session instead of a "
            "separate cloud VM. A unit that needs its own VM (a heavy suite, more memory than the mirror can share, a "
            "meter probe that must run alone), or that runs while the mirror is stopped or past its compaction "
            "ceiling, takes --side \"<reason>\".".format(live[0], live[1].get("url") or "no link recorded"), 8)
    return reason


def build_main_parser():
    parser = argparse.ArgumentParser(
        prog="lane main", allow_abbrev=False,
        description="Start and follow a project's main cloud session (the mirror): one standing cloud session that "
                    "runs the kit's policy in its own VM.",
        epilog="Start: lane main -C DIR -b BRIEF. Then: lane main --watch REPO. REPO is a repo key (owner/repo) or "
               "a checkout path.")
    parser.add_argument("-C", dest="dir_path", metavar="DIR", help="start: the checkout; --return: the work tree")
    parser.add_argument("-b", dest="brief", metavar="BRIEF", help="start: the project brief file")
    parser.add_argument("-m", "--model", dest="model", help="start: the session's model (default opus)")
    parser.add_argument("-e", "--effort", dest="effort", choices=MAIN_EFFORTS, help="start: effort (default xhigh)")
    parser.add_argument("--replace", action="store_true", help="start: replace a live main cloud session")
    parser.add_argument("--timeout", type=float, metavar="SEC",
                        help="start: bound the whole start (default 3600); --watch: give up (default 21600)")
    parser.add_argument("--dry-run", action="store_true", help="start or --picks: change and launch nothing")
    parser.add_argument("--list", action="store_true", help="list the registered main cloud sessions")
    parser.add_argument("--json", action="store_true", help="with --list: print mains.json")
    parser.add_argument("--watch", metavar="REPO", help="wait for the next marker from the main session, print it, exit")
    parser.add_argument("--poll", type=float, metavar="SEC", help="with --watch: seconds between polls (default 60)")
    parser.add_argument("--picks", metavar="REPO", help="push the pick table to the lane-main/picks branch")
    parser.add_argument("--exclude", dest="exclude", metavar="LANES",
                        help="start or --picks: leave these lanes out of the pick table, comma-separated (for "
                             "example gemini); --picks without it reuses the value saved for the repository")
    parser.add_argument("--return", dest="return_args", nargs=2, metavar=("REPO", "UNIT"),
                        help="push a hand-off result from the work tree -C DIR")
    parser.add_argument("--verdict", help="with --return: the verdict word (default OK)")
    parser.add_argument("--forget", metavar="REPO", help="drop the registry entry")
    parser.add_argument("--write-files", dest="write_files", metavar="DIR",
                        help="copy the kit's lane agent files into DIR/.claude/agents")
    return parser


def main_poll_default():
    raw = os.environ.get("LANES_CLOUD_POLL")
    if raw is None:
        return 60.0
    try:
        value = float(raw)
    except (TypeError, ValueError, OverflowError):
        raise LaneError("LANES_CLOUD_POLL must be a positive number", 8)
    if value <= 0 or not math.isfinite(value):
        raise LaneError("LANES_CLOUD_POLL must be a positive number", 8)
    return value


def run_main(argv):
    parser = build_main_parser()
    opts = parser.parse_args(argv)
    modes = [name for name, active in (("--list", opts.list), ("--watch", opts.watch is not None),
                                       ("--picks", opts.picks is not None), ("--return", opts.return_args is not None),
                                       ("--forget", opts.forget is not None),
                                       ("--write-files", opts.write_files is not None)) if active]
    if len(modes) > 1:
        parser.error("use only one of {}".format(", ".join(modes)))
    mode = modes[0] if modes else "start"
    allowed = {"start": {"dir_path", "brief", "model", "effort", "replace", "timeout", "dry_run", "exclude"},
               "--list": {"json"}, "--watch": {"timeout", "poll"}, "--picks": {"dry_run", "exclude"},
               "--return": {"dir_path", "verdict"}, "--forget": set(), "--write-files": set()}[mode]
    labels = {"dir_path": "-C", "brief": "-b", "model": "--model", "effort": "-e", "replace": "--replace",
              "timeout": "--timeout", "dry_run": "--dry-run", "json": "--json", "poll": "--poll",
              "verdict": "--verdict", "exclude": "--exclude"}
    for name, label in labels.items():
        if getattr(opts, name) not in (None, False) and name not in allowed:
            parser.error("{} does not go with {}".format(label, mode if mode != "start" else "starting a session"))
    if mode == "start" and (opts.dir_path is None or opts.brief is None):
        parser.error("lane main needs -C DIR and -b BRIEF (or one of --list, --watch, --picks, --return, --forget, "
                     "--write-files)")
    for name in ("timeout", "poll"):
        value = getattr(opts, name)
        if value is not None and (value <= 0 or not math.isfinite(value)):
            parser.error("--{} must be greater than zero".format(name))
    if opts.exclude is not None:
        opts.exclude = main_exclude_value(parser, opts.exclude)
    try:
        if mode == "--list":
            return main_list(opts)
        if mode == "--watch":
            return main_watch(opts)
        if mode == "--picks":
            return main_picks(opts)
        if mode == "--return":
            return main_return(parser, opts)
        if mode == "--forget":
            return main_forget(opts)
        if mode == "--write-files":
            return main_write_files(parser, opts)
        return main_start(parser, opts)
    except LaneError as exc:
        print(str(exc), file=sys.stderr)
        return exc.code


def main_list(opts):
    data = main_load()
    if opts.json:
        print(json.dumps(data, indent=2, sort_keys=True))
        return 0
    mains = data["mains"]
    if not mains:
        print("no main cloud sessions")
        return 0
    rows = [("repo", "status", "model/effort", "since", "branch", "url")]
    for key in sorted(mains):
        entry = mains[key]
        rows.append((key, str(entry.get("status") or "-"),
                     "{}/{}".format(entry.get("model") or "-", entry.get("effort") or "-"),
                     str(entry.get("started_at") or "-"), str(entry.get("branch") or "-"), str(entry.get("url") or "-")))
    widths = [max(len(row[column]) for row in rows) for column in range(5)]
    for row in rows:
        print("  ".join(row[column].ljust(widths[column]) for column in range(5)) + "  " + row[5])
    return 0


def main_forget(opts):
    with MainLock():
        data = main_load()
        key, entry = main_find_entry(data, opts.forget)
        if entry is None:
            raise LaneError("no main cloud session is registered for {}; see lane main --list".format(opts.forget), 2)
        del data["mains"][key]
        main_save(data)
    checkout, main_id = entry.get("checkout"), entry.get("main_id")
    if checkout and main_id and os.path.isdir(checkout):
        try:
            cloud_git(checkout, ["update-ref", "-d", "refs/lane-main/" + main_id])
        except LaneError:
            pass
    print("forgot the main cloud session of {}".format(key))
    print("reminder: the session itself keeps running until you archive it in the Claude app{}".format(
        " ({})".format(entry["url"]) if entry.get("url") else ""))
    return 0


def main_picks(opts):
    data = main_load()
    key, entry = main_find_entry(data, opts.picks)
    if key is None:
        raise LaneError("unknown repository {}: give a repo key from lane main --list or a checkout path".format(
            opts.picks), 2)
    checkout = entry["checkout"] if entry is not None and entry.get("checkout") else os.path.abspath(opts.picks)
    if not os.path.isdir(checkout):
        raise LaneError("the checkout {} no longer exists".format(checkout), 8)
    try:
        release = main_release(main_policy_text())
    except LaneError:
        release = None
    # --exclude replaces the value saved for the repository; without it the saved value applies (none when unset).
    saved = entry.get("exclude") if entry is not None else None
    exclude = opts.exclude if opts.exclude is not None else (saved if isinstance(saved, str) else "")
    table = main_picks_table(key, release, exclude)
    classes = table.get("classes")
    summary = "{} classes".format(len(classes)) if isinstance(classes, dict) else "no classes"
    if opts.dry_run:
        print(json.dumps(table, indent=2))
        print("exclude: {}".format(exclude or "none"))
        print("dry-run: pick table for {} ({}); nothing pushed".format(key, summary))
        return 0
    commit = main_push_picks(checkout, table)
    if opts.exclude is not None and entry is not None:
        main_update_entry(key, exclude=exclude)
    print("pushed the pick table for {} ({}) to {} as {}".format(key, summary, MAIN_PICKS_BRANCH, commit[:12]))
    return 0


def main_identity_args(path):
    """-c options that give a commit an identity when the repository and the user have none."""
    for name in ("user.name", "user.email"):
        result = cloud_git(path, ["config", name])
        if result.returncode or not cloud_output(result):
            return ["-c", "user.name=kit", "-c", "user.email=kit@localhost"]
    return []


def main_return(parser, opts):
    repo, unit = opts.return_args
    if not MAIN_UNIT_RE.fullmatch(unit):
        raise LaneError("bad unit name {!r}: use 1 to 48 characters of A-Z a-z 0-9 . _ -".format(unit), 8)
    verdict = opts.verdict or "OK"
    if not MAIN_VERDICT_RE.fullmatch(verdict):
        parser.error("--verdict must be 1 to 32 characters of A-Z a-z 0-9 _ -")
    data = main_load()
    key, entry = main_find_entry(data, repo)
    if entry is None or not entry.get("main_id") or not entry.get("checkout"):
        raise LaneError("no main cloud session is registered for {}; see lane main --list".format(repo), 8)
    if not opts.dir_path:
        parser.error("--return needs -C DIR (the work tree that holds the result)")
    # The unit grammar allows names git cannot use in a branch name (.., .hidden, a.lock, trailing dot); refuse them
    # before anything is added or committed in DIR.
    ref_check = run_quiet(["git", "check-ref-format", "refs/heads/{}{}/{}".format(MAIN_RESULT_ROOT, entry["main_id"], unit)])
    if ref_check is None or ref_check.returncode:
        raise LaneError("bad unit name {!r}: git cannot use it in a branch name (no leading or trailing '.', no '..', "
                        "not ending in '.lock')".format(unit), 8)
    dir_path = os.path.realpath(opts.dir_path)
    if not os.path.isdir(dir_path):
        parser.error("DIR must be an existing directory")
    inside = cloud_git(dir_path, ["rev-parse", "--is-inside-work-tree"])
    top = cloud_git(dir_path, ["rev-parse", "--show-toplevel"])
    if inside.returncode or cloud_output(inside) != "true" or top.returncode:
        raise LaneError("{} is not a git work tree".format(dir_path), 8)
    registered = cloud_git(entry["checkout"], ["rev-parse", "--show-toplevel"]) if os.path.isdir(entry["checkout"]) else None
    registered_top = cloud_output(registered) if registered is not None and not registered.returncode else entry["checkout"]
    if os.path.normcase(os.path.realpath(cloud_output(top))) in (
            os.path.normcase(os.path.realpath(registered_top)), os.path.normcase(os.path.realpath(entry["checkout"]))):
        raise LaneError("DIR is the registered checkout of {}; --return commits everything in DIR, so use the work "
                        "tree the hand-off ran in (git worktree add ...)".format(key), 8)
    branch = "{}{}/{}".format(MAIN_RESULT_ROOT, entry["main_id"], unit)
    added = cloud_git(dir_path, ["add", "-A"])
    if added.returncode:
        raise LaneError("git add failed in {}: {}".format(dir_path, main_stderr_tail(added)), 4, "FAILED")
    subject = "lane: result {} verdict={}".format(unit, verdict)
    committed = cloud_git(dir_path, main_identity_args(dir_path) + ["commit", "--quiet", "--allow-empty", "-m", subject])
    if committed.returncode:
        raise LaneError("git commit failed in {}: {}".format(dir_path, main_stderr_tail(committed)), 4, "FAILED")
    sha = cloud_output(cloud_git(dir_path, ["rev-parse", "HEAD"]))
    pushed = cloud_git(dir_path, ["push", "origin", "HEAD:refs/heads/" + branch], timeout=120)
    if pushed.returncode:
        detail = main_stderr_tail(pushed)
        raise LaneError("could not push {} to origin{}".format(branch, " ({})".format(detail) if detail else ""),
                        4, "FAILED")
    print("pushed {} to {} ({})".format(sha[:12], branch, subject))
    print("the main session reads it with: git ls-remote origin '{}'".format(branch))
    return 0


# Control characters in text from a remote session are shown as "?", so a marker cannot move the cursor or recolour.
MAIN_CONTROL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")


def main_clean(text):
    return MAIN_CONTROL_RE.sub("?", text)


def main_number(value):
    return value == "-" or bool(MAIN_NUMBER_RE.fullmatch(value))


def main_parse_marker(subject):
    """(kind, fields) of an `orch:` commit subject; ("BAD", None) when it does not parse. Strict, never guessed."""
    subject = subject.strip()
    match = re.fullmatch(r"orch: START ([A-Za-z0-9._-]+)", subject)
    if match:
        return "START", {"id": match.group(1)}
    match = re.fullmatch(r"orch: (STATUS|READY) (\d+): (\S.*)", subject)
    if match:
        return match.group(1), {"n": match.group(2), "title": match.group(3)}
    # class= arrived in 2026-10-31.16; a mirror started before that sends none.
    match = re.fullmatch(r"orch: LOCAL lane (\S+) (\S+) (\S+)(?: class=(\S+))?", subject)
    if match:
        unit, arm, brief, unit_class = match.groups()
        if (MAIN_UNIT_RE.fullmatch(unit) and MAIN_ARM_RE.fullmatch(arm) and arm.split("/")[0] in LANES
                and brief == ".lane-main/briefs/{}.md".format(unit)
                and (unit_class is None or unit_class in MAIN_CLASSES)):
            return "LOCAL", {"unit": unit, "arm": arm, "path": brief, "class": unit_class}
        return "BAD", None
    if subject.startswith("orch: REVIEW "):
        tokens = subject[len("orch: REVIEW "):].split(" ")
        if len(tokens) < 7 or "" in tokens or not MAIN_UNIT_RE.fullmatch(tokens[0]) or tokens[1] not in MAIN_OUTCOMES:
            return "BAD", None
        values = {}
        for token in tokens[2:]:
            name, separator, value = token.partition("=")
            if not separator or name in values or name not in ("arm", "class", "min", "tok", "usd", "fix", "via"):
                return "BAD", None
            values[name] = value
        checks = {"arm": lambda v: v == "-" or bool(MAIN_ARM_RE.fullmatch(v)),
                  "class": lambda v: v == "-" or v in MAIN_CLASSES, "min": main_number, "usd": main_number,
                  "fix": main_number, "tok": lambda v: v == "-" or bool(MAIN_TOKENS_RE.fullmatch(v)),
                  "via": lambda v: v in ("-", "local", "subagent")}
        if any(name not in values for name in ("arm", "class", "min", "tok", "usd")):
            return "BAD", None
        if not all(checks[name](value) for name, value in values.items()):
            return "BAD", None
        return "REVIEW", {"text": subject[len("orch: REVIEW "):]}
    return "BAD", None


def main_local_next(key, entry, unit, arm, brief_path, unit_class=None):
    """The ready-to-run hand-off commands for a LOCAL marker, on one line.

    unit_class comes from the marker; without one the run goes without --class (lane warns), never with a
    placeholder, which a shell would read as a redirection."""
    checkout, main_id = entry["checkout"], entry["main_id"]
    parts = arm.split("/")
    lane_name, effort, model = parts[0], parts[-1], "/".join(parts[1:-1])
    worktree = os.path.join(os.path.dirname(checkout), os.path.basename(checkout) + "-main-" + unit)
    lane_cmd = main_lane_command()
    run = "{} {} -C {} -b {}".format(lane_cmd, lane_name, main_quote(worktree), main_quote(brief_path))
    if lane_name in CODEX_LANES + CLAUDE_LANES:
        run += " -e " + effort
    if model and model != DEFAULT_MODELS.get(lane_name):
        run += " -m " + main_quote(model)
    # The tag is how lane-stats import-orch finds this run when the REVIEW marker says via=local.
    if unit_class:
        run += " --class " + unit_class
    run += " --tag orch-{}-{}".format(main_id, unit)
    return " && ".join((
        "git -C {} worktree add --detach {} refs/lane-main/{}".format(main_quote(checkout), main_quote(worktree), main_id),
        run,
        "{} main --return {} {} -C {}".format(lane_cmd, main_quote(key), unit, main_quote(worktree))))


def main_read_markers(checkout, ref, last_seen, main_id):
    """[(sha, subject, body)] of the commits after last_seen, oldest first (all after START when last_seen is unusable)."""
    log_format = "--format=%H%x1f%s%x1f%b%x1e"
    result = None
    if last_seen:
        result = cloud_git(checkout, ["log", "--reverse", log_format, "{}..{}".format(last_seen, ref)], timeout=60)
    if result is None or result.returncode:
        result = cloud_git(checkout, ["log", "--reverse", log_format, ref], timeout=60)
        if result.returncode:
            raise LaneError("cannot read the commits of {}".format(ref), 4, "FAILED")
        records = main_parse_log(result.stdout)
        start = "orch: START " + main_id
        for index, record in enumerate(records):
            if record[1].strip() == start:
                return records[index + 1:]
        return records
    return main_parse_log(result.stdout)


def main_parse_log(raw):
    records = []
    for chunk in raw.decode("utf-8", "replace").split("\x1e"):
        chunk = chunk.lstrip("\n")
        if not chunk.strip():
            continue
        fields = chunk.split("\x1f", 2)
        if len(fields) == 3:
            records.append((fields[0], fields[1], fields[2].strip("\n")))
    return records


def main_watch_report(key, entry, records):
    """Print one line per `orch:` commit; returns how many there were."""
    count = 0
    checkout = entry["checkout"]
    for sha, subject, body in records:
        if not subject.startswith("orch:"):
            continue
        count += 1
        short = sha[:12]
        kind, fields = main_parse_marker(subject)
        if kind == "START":
            print("orch START {} id={}".format(short, fields["id"]))
        elif kind in ("STATUS", "READY"):
            print("orch {} {} n={} title={}".format(kind, short, fields["n"], main_clean(fields["title"])))
            for line in body.splitlines():
                print("  " + main_clean(line))
        elif kind == "LOCAL":
            shown = main_save_brief(key, checkout, sha, fields)
            if shown is None:
                print("orch BAD {} {}".format(short, main_clean(subject)))
                print("  the brief {} is not in that commit".format(fields["path"]))
            else:
                unit_class = fields.get("class")
                print("orch LOCAL {} unit={} arm={}{} brief={}".format(
                    short, fields["unit"], fields["arm"], " class=" + unit_class if unit_class else "", shown))
                print("  next: " + main_local_next(key, entry, fields["unit"], fields["arm"], shown, unit_class))
                if not unit_class:
                    print("  note: the marker names no class (a mirror started before 2026-10-31.16); add --class to "
                          "the lane step when you know it, so the run counts for that class")
        elif kind == "REVIEW":
            print("orch REVIEW {} {}".format(short, fields["text"]))
        else:
            print("orch BAD {} {}".format(short, main_clean(subject)))
    sys.stdout.flush()
    return count


def main_save_brief(key, checkout, sha, fields):
    """Save the hand-off brief out of the marker's own commit; its path, or None when the commit lacks the file."""
    shown = cloud_git(checkout, ["show", "{}:{}".format(sha, fields["path"])], timeout=60)
    if shown.returncode:
        return None
    folder = os.path.join(main_dir(key), "briefs")
    os.makedirs(folder, exist_ok=True)
    target = os.path.join(folder, fields["unit"] + ".md")
    with open(target, "wb") as stream:
        stream.write(shown.stdout)
    return target


def main_watch_check(key, entry, last_seen):
    """One poll. Returns (last_seen, printed); a changed tip with no marker moves last_seen and prints nothing."""
    branch, main_id, checkout = entry["branch"], entry["main_id"], entry["checkout"]
    tip = main_remote_tip(checkout, branch)
    if tip is None or tip == last_seen:
        return last_seen, False
    ref = "refs/lane-main/" + main_id
    fetched = cloud_git(checkout, ["fetch", "--quiet", "--no-tags", "origin", "+refs/heads/{}:{}".format(branch, ref)],
                        timeout=120)
    if fetched.returncode:
        raise LaneError("cannot fetch {} from origin".format(branch), 4, "FAILED")
    # The branch can move between ls-remote and fetch: what was read is the fetched ref, so that is what is remembered.
    read = cloud_git(checkout, ["rev-parse", "--verify", "--quiet", ref + "^{commit}"])
    tip = cloud_output(read) if not read.returncode and cloud_output(read) else tip
    records = main_read_markers(checkout, ref, last_seen, main_id)
    printed = main_watch_report(key, entry, records)
    main_update_entry(key, main_id=main_id, last_seen=tip)
    return tip, printed > 0


def main_watch(opts):
    data = main_load()
    key, entry = main_registered(data, opts.watch)
    if not os.path.isdir(entry["checkout"]):
        raise LaneError("the checkout {} of {} no longer exists".format(entry["checkout"], key), 8)
    timeout = opts.timeout if opts.timeout is not None else 21600.0
    poll = opts.poll if opts.poll is not None else main_poll_default()
    deadline = time.monotonic() + timeout
    last_seen = entry.get("last_seen")
    failures = 0
    while True:
        try:
            last_seen, printed = main_watch_check(key, entry, last_seen)
            failures = 0
            if printed:
                return 0
        except LaneError as exc:
            failures += 1
            print("warning: {}".format(exc), file=sys.stderr)
            if failures >= 5:
                raise LaneError("giving up after {} failed polls: {}".format(failures, exc), 4, "FAILED")
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise LaneError("no marker in {} seconds".format(int(timeout) if timeout == int(timeout) else timeout),
                            124, "TIMEOUT")
        time.sleep(min(poll, remaining))


def main_write_files(parser, opts):
    target = os.path.abspath(opts.write_files)
    if not os.path.isdir(target):
        parser.error("DIR must be an existing directory (a checkout)")
    kit = main_kit_root()
    sources = sorted(path for lane_name in CLAUDE_LANES
                     for path in glob.glob(os.path.join(kit, "agents", "lane-{}-*.md".format(lane_name))))
    if not sources:
        raise LaneError("no lane agent files (agents/lane-<lane>-<effort>.md) found in {}".format(kit), 8)
    folder = os.path.join(target, ".claude", "agents")
    os.makedirs(folder, exist_ok=True)
    print("agent files in {}:".format(folder))
    counts = {"wrote": 0, "changed": 0, "unchanged": 0}
    for source in sources:
        with open(source, "rb") as stream:
            data = stream.read()
        destination = os.path.join(folder, os.path.basename(source))
        state = "wrote"
        if os.path.isfile(destination):
            with open(destination, "rb") as stream:
                state = "unchanged" if stream.read() == data else "changed"
        if state != "unchanged":
            with open(destination, "wb") as stream:
                stream.write(data)
        counts[state] += 1
        print("  {} {}".format(state, os.path.basename(source)))
    print("{} written, {} changed, {} unchanged".format(counts["wrote"], counts["changed"], counts["unchanged"]))
    probe = run_quiet(["git", "-C", target, "check-ignore", "-q", ".claude/agents/" + os.path.basename(sources[0])])
    if probe is not None and probe.returncode == 0:
        print("warning: git ignores .claude/agents in this repository; the cloud VM clones what is committed, so "
              "remove that ignore rule or the agents will not be there")
    print("")
    print("Add these lines to the repository's CLAUDE.md (lane main never edits it):")
    print("  ## Main cloud session (Claude Usage Optimizer)")
    print("  - The session started by `lane main` may commit to and push its own branch (the claude/... branch it is on),")
    print("    including empty marker commits whose subject starts with \"orch: \".")
    print("  - No session pushes main or a release branch, a tag or a pull request, and none force-pushes.")
    print("")
    print("For the phone notice and the main-session mark, also run:")
    print("  {} install --repo {}".format(main_tool_command(os.path.join(kit, "bin", "cloud-notify")),
                                          main_quote(target)))
    print("Commit and push these files yourself: the cloud VM sees only what is committed. Nothing is committed here.")
    return 0


def main_start(parser, opts):
    dir_path = os.path.realpath(opts.dir_path)
    if not os.path.isdir(dir_path):
        parser.error("DIR must be an existing directory")
    brief_path = os.path.abspath(os.path.expanduser(opts.brief))
    try:
        with open(brief_path, "rb") as stream:
            brief_text = stream.read().decode("utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        parser.error("cannot read BRIEF as UTF-8: {}".format(exc))
    model = opts.model or "opus"
    effort = opts.effort or "xhigh"
    exclude = opts.exclude or ""
    plan = cloud_preflight("opus", dir_path)
    key = main_repo_key(plan["remote_url"])
    data = main_load()
    previous_entry = data["mains"].get(key)
    live = previous_entry is not None and previous_entry.get("status") == "live"
    main_id = main_new_id()
    policy_text = main_policy_text()
    release = main_release(policy_text)
    prompt = main_prompt(main_id, release, policy_text, brief_text)
    term = lane_term_path()
    executable, _ = resolve_binary("claude")
    folder = main_dir(key)
    prefix = os.path.join(folder, main_id + "-screen")
    command = claude_cloud_command(executable, term, dir_path, prefix, "", main_id, model, effort, prompt=prompt)
    if IS_WINDOWS and windows_command_line_length(command) > WINDOWS_COMMAND_LINE_LIMIT:
        raise LaneError("the command line exceeds the Windows limit of 32,767 characters; a Claude cloud session "
                        "takes its prompt as an argument, so shorten the project brief", 8)
    if opts.dry_run:
        os.makedirs(state_dir(), exist_ok=True)
        prompt_path = os.path.join(state_dir(), "main-prompt-{}.md".format(main_id))
        with open(prompt_path, "w", encoding="utf-8", newline="\n") as stream:
            stream.write(prompt)
        print("cloud preflight: PASS")
        print("repo: {}".format(key))
        print("branch: {} (base {})".format(plan["branch"], plan["base"]))
        print("live mirror: {}".format("yes ({}); a real start needs --replace".format(
            previous_entry.get("url") or "no link recorded") if live else "no"))
        print("main id: {}".format(main_id))
        print("model: {} effort: {}".format(model, effort))
        print("exclude: {}".format(exclude or "none"))
        print("prompt: {} characters (limit {}); written to {}".format(len(prompt), MAIN_PROMPT_LIMIT, prompt_path))
        print("launch: {}".format(json.dumps(["<prompt>" if arg == prompt else arg for arg in command],
                                             ensure_ascii=False)))
        print("dry-run: no push or cloud launch performed")
        return 0
    if live and not opts.replace:
        raise LaneError("a main cloud session is already live for {} ({}); use --replace to start another".format(
            key, previous_entry.get("url") or "no link recorded"), 8)
    if not os.path.isfile(term):
        raise LaneError("lane-term was not found at {}; install bin/lane-term or set LANES_TERM".format(term), 4, "FAILED")
    timeout = opts.timeout if opts.timeout is not None else 3600.0
    deadline = time.monotonic() + timeout
    poll = cloud_poll_interval()
    start_timeout = cloud_env_timeout("LANES_CLOUD_START_TIMEOUT", 600, 0.01)
    os.makedirs(folder, exist_ok=True)
    base_pushed = False
    preserve = False
    old = None
    try:
        cloud_push_branch(dir_path, plan, deadline, main_id)
        base_pushed = True
        try:
            release_table = main_picks_table(key, release, exclude)
            main_push_picks(dir_path, release_table)
        except LaneError as exc:
            print("warning: the pick table was not published ({}); the main session will use its fallback".format(exc),
                  file=sys.stderr)
        before_refs = cloud_remote_refs(dir_path, deadline)
        started_at = utc_now()
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise LaneError("main cloud start timed out before launch", 124, "TIMEOUT")
        launched = cloud_process(command, cwd=dir_path, timeout=min(180, remaining), env=main_claude_env())
        screen_path = prefix + ".txt"
        screen = b""
        if os.path.isfile(screen_path):
            with open(screen_path, "rb") as stream:
                screen = stream.read()
        screen_text = screen.decode("utf-8", "replace")
        session_match = re.search(r"session_[A-Za-z0-9]+", screen_text)
        url_match = re.search(r"https://claude\.ai/code/session_[A-Za-z0-9]+(?:\?[^\s]+)?", screen_text)
        if launched.returncode:
            raise LaneError("lane-term could not run Claude; screen: {}".format(screen_path), 4, "FAILED")
        if not session_match or not url_match:
            raise LaneError("Claude cloud session was not found in {}; see that screen file".format(screen_path), 4,
                            "FAILED")
        session_id = session_match.group(0)
        url = url_match.group(0).rstrip(".,)")
        start_deadline = min(deadline, time.monotonic() + start_timeout)
        seen_refs = before_refs
        found = None
        marker = "orch: START " + main_id
        while found is None:
            refs = cloud_remote_refs(dir_path, deadline)
            for branch, sha in refs.items():
                if (sha == seen_refs.get(branch) or branch == plan["branch"] or branch == MAIN_PICKS_BRANCH
                        or branch.startswith(MAIN_RESULT_ROOT)):
                    continue
                fetched, local_ref = cloud_fetch_branch(dir_path, main_id, branch, deadline)
                if not fetched:
                    continue
                commits = cloud_git_until(dir_path, ["log", "--format=%H%x09%s", "{}..{}".format(plan["base"], local_ref)],
                                          deadline, 30)
                starts = [line.split("\t", 1)[0] for line in cloud_output(commits).splitlines()
                          if line.split("\t", 1)[1:] == [marker]] if commits.returncode == 0 else []
                if starts:
                    found = (branch, starts[-1])
                    break
            seen_refs = refs
            if found is not None:
                break
            now = time.monotonic()
            if now >= deadline:
                raise LaneError("main cloud start timed out. Session: {}".format(url), 124, "TIMEOUT")
            if now >= start_deadline:
                raise LaneError("no START marker appeared for the main cloud session; the GitHub App may be missing "
                                "and the session may be running from a bundle. Session: {}".format(url), 4, "FAILED")
            time.sleep(min(poll, max(0, start_deadline - now), deadline - now))
        branch, start_sha = found
        entry = {"main_id": main_id, "status": "live", "session_id": session_id, "url": url, "branch": branch,
                 "checkout": dir_path, "remote": re.sub(r"://[^@/\s]+@", "://", plan["remote_url"]),
                 "model": model, "effort": effort, "exclude": exclude, "started_at": started_at,
                 "last_seen": start_sha, "previous": []}
        with MainLock():
            data = main_load()
            old = data["mains"].get(key)
            if old is not None:
                kept = dict(old)
                kept.pop("previous", None)
                kept["status"] = "replaced"
                entry["previous"] = [item for item in old.get("previous", []) if isinstance(item, dict)] + [kept]
            data["mains"][key] = entry
            main_save(data)
    except LaneError as exc:
        if exc.verdict == "TIMEOUT":
            preserve = True
        raise
    finally:
        if not preserve:
            cleanup_plan = dict(plan)
            cleanup_plan["remote_existed"] = plan["remote_existed"] or not base_pushed
            cleanup_plan["base_pushed"] = base_pushed
            # The session's own branch stays: it is the mirror.
            cloud_cleanup(dir_path, cleanup_plan, None, main_id)
    print("main cloud session started for {}".format(key))
    print("session: {}".format(url))
    print("branch: {}".format(branch))
    print("main id: {}".format(main_id))
    if old is not None and old.get("status") == "live":
        print("reminder: archive the replaced session in the Claude app ({})".format(old.get("url") or "no link recorded"))
    print("next: {} main --watch {}".format(main_lane_command(), main_quote(key)))
    return 0


def use_utf8_streams():
    # Windows pipes default to the ANSI code page, which cannot encode worker output or paths.
    if IS_WINDOWS:
        for stream in (sys.stdout, sys.stderr):
            if hasattr(stream, "reconfigure"):
                stream.reconfigure(encoding="utf-8", errors="replace")


def main(argv=None):
    use_utf8_streams()
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "--recover":
        if len(argv) not in (2, 3) or (len(argv) == 3 and argv[2] != "--force"):
            print("lane: usage: lane --recover RUN [--force]", file=sys.stderr)
            return 2
        return recover_run(argv[1], len(argv) == 3)
    if argv[:2] == ["hook", "subagent-stop"]:
        return run_hook(subagent_stop_hook)
    if argv and argv[0] in ("muse", "grok", "prep-muse"):
        print("lane: {} was retired on 2026-10-17 (see POLICY.md)".format(argv[0]), file=sys.stderr)
        return 2
    if argv and argv[0] == "main":
        return run_main(argv[1:])
    parser = build_parser()
    opts = parser.parse_args(argv)
    try:
        return run_lane(opts, parser)
    except LaneError as exc:
        print(str(exc), file=sys.stderr)
        return exc.code


if __name__ == "__main__":
    sys.exit(main())

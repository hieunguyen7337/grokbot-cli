  "explore": {
    "min_runs": 2,
    "floor": 0.2,
    "half_life_days": 60,
    "shrink": 2.0,
    "review_points": 0.01,
    "fix_points_per_minute": 0.003,
    "weeks_per_month": 4.345,
    "places": ["process", "subagent", "cloud"],
    "points_basis": "Cost points are plan dollars. A run's cost is its share of the provider's weekly window, as a % of today's window on today's plan (plan_scale, then window_epochs), / 100 x the plan's usd_per_month / weeks_per_month, times the usage mode's pace factor. A provider or plan without a price (cline; Codex 'pro') pays share x scarcity x Claude's plan dollars per 1% of its week (200 / 4.345 / 100 = $0.46). review_points and fix_points_per_minute stay in Claude-% (1 = 1% of Claude's week) and convert at that rate: a review costs about $0.0046 and a fix minute about $0.0014; pace does not apply to them. Without a Claude price every term stays in Claude-%.",
    "targets": {
      "mechanical": 0.8,
      "substantive": 0.7,
      "hard": 0.5,
      "design": 0.5,
      "review": 0.6,
      "research": 0.7
    },
    "pace": {
      "low_pct": 60,
      "high_pct": 90,
      "low_factor": 0.25,
      "high_factor": 3.0
    },
    "mode": "auto",
    "modes": {
      "saving_pct": 110,
      "utilization_pct": 90
    },
    "exclude_weekly_pct": 95,
    "exclude_5h_pct": 90,
    "claude_guard_pct": 85,
    "lock": {
      "leaning_p": 0.5,
      "leaning_runs": 4,
      "locked_p": 0.8,
      "locked_runs": 8
    },
    "measured_weight": 4,
    "measured_shrink": 4.0,
    "measured_min_n": 10,
    "time": {
      "basis": "151 untagged real units on one machine to 2026-10-29 (FINDINGS §16): class medians rounded, design between substantive and hard; a ridge fit put terra at 0.39x the other lanes (n=10) and could not separate effort from lane, so effort factors are mild; residual log-sd 1.2. The brief-size term (minutes x (brief bytes / 6000)^0.8) is the fitted slope of the log error on log brief size over 183 units with a known brief (correlation 0.40); in a time-ordered backtest it cut the median error factor from 1.89 to about 1.7. A run's own tag, class and arm history replace these as runs accumulate.",
      "class_minutes": {"mechanical": 4, "substantive": 15, "hard": 25, "design": 20, "review": 4, "research": 9},
      "effort_factor": {"low": 0.8, "medium": 0.9, "high": 1.0, "xhigh": 1.2, "max": 1.5},
      "lane_factor": {"terra": 0.5},
      "prior_runs": 2,
      "log_sd": 1.0,
      "brief_ref_bytes": 6000,
      "brief_exponent": 0.8
    },
    "memory": {
      "basis": "Rough priors from one Windows snapshot on 2026-10-29: interactive Claude Code sessions held 640-670 MB each, the Codex app-server about 50 MB, and the worker's own tool commands (tests, builds) come on top. A lane's need is the median peak_mem_mb of its last recent_runs runs once it has min_runs of them; these priors only cover the first runs. The reserve keeps the main session and the desktop usable.",
      "lane_mb": {"luna": 400, "terra": 400, "sol": 400, "astra": 400, "haiku": 700, "sonnet": 700, "opus": 700, "gemini": 500, "glm": 500},
      "default_mb": 700,
      "reserve_mb": 1536,
      "reserve_fraction": 0.1,
      "recent_runs": 20,
      "min_runs": 3,
      "young_run_seconds": 120
    }
  },
